@model Havenly.BLL.ModelVMs.Payment.HostPayoutsVM
@using Havenly.DAL.Entities
@using Havenly.DAL.Enums

@{
    ViewData["Title"] = "Host Payouts & Earnings — Havenly";
    Layout = "~/Views/Shared/_WorkspaceLayout.cshtml";
    ViewData["Workspace"] = "Host dashboard";
    ViewData["WorkspaceNav"] = "host";
}

<div class="space-y-8 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold tracking-tight">Earnings & Payouts</h1>
            <p class="text-muted-foreground mt-1">Track your revenue, platform fees, and payout disbursements.</p>
        </div>
    </div>

    <!-- Financial Stats Grid -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Net Earnings (90%) -->
        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Net Earnings (90%)</p>
            <div class="text-3xl font-bold text-foreground mt-2">$@Model.TotalNetEarnings.ToString("N2")</div>
            <p class="text-xs text-emerald-600 font-medium mt-1">After 10% Havenly fee</p>
        </div>

        <!-- Paid Out -->
        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Disbursed to Bank</p>
            <div class="text-3xl font-bold text-emerald-600 mt-2">$@Model.PaidOutEarnings.ToString("N2")</div>
            <p class="text-xs text-muted-foreground mt-1">Completed payouts</p>
        </div>

        <!-- Pending Payout -->
        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Pending Payout</p>
            <div class="text-3xl font-bold text-yellow-600 mt-2">$@Model.PendingPayouts.ToString("N2")</div>
            <p class="text-xs text-muted-foreground mt-1">Processing disbursement</p>
        </div>

        <!-- Gross Volume -->
        <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Gross Booking Volume</p>
            <div class="text-3xl font-bold text-foreground mt-2">$@Model.TotalGrossRevenue.ToString("N2")</div>
            <p class="text-xs text-muted-foreground mt-1">Platform fee: $@Model.TotalPlatformFee.ToString("N2")</p>
        </div>
    </div>

    <!-- Payout Breakdown Table -->
    <div class="rounded-2xl border border-border bg-card overflow-hidden shadow-sm">
        <div class="p-6 border-b border-border flex items-center justify-between">
            <h2 class="text-lg font-bold">Transaction History</h2>
            <span class="text-xs text-muted-foreground font-medium">@Model.PayoutRows.Count total transactions</span>
        </div>

        @if (Model.PayoutRows.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="border-b border-border bg-secondary/40 text-muted-foreground text-left">
                        <tr>
                            <th class="px-6 py-4 font-semibold">Guest & Property</th>
                            <th class="px-6 py-4 font-semibold">Booking ID</th>
                            <th class="px-6 py-4 font-semibold text-right">Gross Total</th>
                            <th class="px-6 py-4 font-semibold text-right">Havenly Fee (10%)</th>
                            <th class="px-6 py-4 font-semibold text-right">Your Share (90%)</th>
                            <th class="px-6 py-4 font-semibold text-center">Payout Status</th>
                            <th class="px-6 py-4 font-semibold text-right">Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        @foreach (var row in Model.PayoutRows)
                        {
                            <tr class="hover:bg-secondary/20 transition">
                                <td class="px-6 py-4">
                                    <div class="font-semibold text-foreground">@row.PropertyName</div>
                                    <div class="text-xs text-muted-foreground">Guest: @row.GuestName (@row.GuestEmail)</div>
                                </td>
                                <td class="px-6 py-4 font-mono text-xs text-muted-foreground">
                                    #@row.BookingId
                                </td>
                                <td class="px-6 py-4 text-right font-medium text-foreground">
                                    $@row.GrossAmount.ToString("N2")
                                </td>
                                <td class="px-6 py-4 text-right text-xs text-muted-foreground">
                                    -$@row.PlatformFee.ToString("N2")
                                </td>
                                <td class="px-6 py-4 text-right font-bold text-foreground">
                                    $@row.HostPayout.ToString("N2")
                                </td>
                                <td class="px-6 py-4 text-center">
                                    @if (row.IsPaidToHost)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-600">
                                            <span class="size-1.5 rounded-full bg-emerald-600 mr-1.5"></span>
                                            Paid Out
                                        </span>
                                    }
                                    else if (row.Status == PaymentStatus.Completed)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-yellow-500/10 px-2.5 py-1 text-xs font-semibold text-yellow-600">
                                            <span class="size-1.5 rounded-full bg-yellow-600 mr-1.5 animate-pulse"></span>
                                            Pending Transfer
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">
                                            Awaiting Payment
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right text-xs text-muted-foreground">
                                    @(row.PaidAt?.ToString("MMM dd, yyyy") ?? row.CreatedAt.ToString("MMM dd, yyyy"))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-16 text-center text-muted-foreground p-6">
                <svg class="size-12 text-muted-foreground/40 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h3 class="text-base font-bold text-foreground">No earnings recorded yet</h3>
                <p class="text-xs text-muted-foreground mt-1 max-w-sm">
                    When guests complete reservations and payments on your properties, your 90% net earnings will appear here.
                </p>
            </div>
        }
    </div>
</div>
