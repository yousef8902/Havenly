@model Havenly.BLL.ModelVMs.Host.HostCalendarPageVM

@{
    ViewData["Title"] = "Availability & Reservations Calendar — Havenly Host";
    ViewData["Description"] = "Manage bookings, schedule maintenance, and block dates for your properties.";
    Layout = "~/Views/Shared/_WorkspaceLayout.cshtml";
    ViewData["Workspace"] = "Host dashboard";
    ViewData["WorkspaceRole"] = $"{User.Identity?.Name ?? "Host"} · Host";
    ViewData["WorkspaceNav"] = "host";
}

<div class="space-y-6">
    <!-- Header with Property Selector & Actions -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold tracking-tight">Availability Calendar</h1>
            <p class="text-sm text-muted-foreground mt-1">Manage guest reservations, view availability, and block dates for maintenance or personal stays.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            @if (Model.HostProperties.Any())
            {
                <!-- Property Switcher Dropdown -->
                <div class="relative">
                    <select id="propertySwitcher" onchange="switchProperty(this.value)" class="h-10 rounded-xl border border-border bg-card px-3 py-2 text-sm font-medium shadow-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary pr-8">
                        @foreach (var prop in Model.HostProperties)
                        {
                            <option value="@prop.PropertyId" selected="@(prop.IsSelected ? "selected" : null)">
                                🏡 @prop.PropertyName
                            </option>
                        }
                    </select>
                </div>

                <!-- Block Dates Button -->
                <button type="button" onclick="openBlockModal()" class="inline-flex items-center gap-2 h-10 rounded-full bg-[#0d9488] px-5 py-2 text-sm font-semibold text-white shadow hover:bg-[#0f766e] transition" style="background-color: #0d9488 !important; color: #ffffff !important;">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Block Dates
                </button>
            }
        </div>
    </div>

    @if (!Model.HostProperties.Any())
    {
        <div class="rounded-2xl border border-border bg-card p-12 text-center">
            <div class="inline-flex size-14 items-center justify-center rounded-2xl bg-muted text-2xl mb-4">
                📅
            </div>
            <h3 class="text-lg font-bold">No Properties Found</h3>
            <p class="text-sm text-muted-foreground mt-1 max-w-sm mx-auto">You don't have any properties yet. Once you publish a listing, you'll be able to manage its availability calendar here.</p>
            <a asp-action="CreateProperty" class="mt-4 inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition">
                Create First Listing →
            </a>
        </div>
    }
    else
    {
        <!-- Month Navigation Bar & Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
            <!-- Navigation -->
            <div class="flex items-center gap-2">
                <a asp-action="Calendar" asp-route-propertyId="@Model.PropertyId" asp-route-year="@Model.PrevMonthDate.Year" asp-route-month="@Model.PrevMonthDate.Month"
                   class="inline-flex items-center justify-center size-9 rounded-xl border border-border bg-card text-muted-foreground hover:bg-secondary hover:text-foreground transition shadow-sm" title="Previous Month">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </a>
                
                <span class="text-lg font-bold tracking-tight min-w-44 text-center">@Model.MonthName</span>

                <a asp-action="Calendar" asp-route-propertyId="@Model.PropertyId" asp-route-year="@Model.NextMonthDate.Year" asp-route-month="@Model.NextMonthDate.Month"
                   class="inline-flex items-center justify-center size-9 rounded-xl border border-border bg-card text-muted-foreground hover:bg-secondary hover:text-foreground transition shadow-sm" title="Next Month">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                </a>

                <a asp-action="Calendar" asp-route-propertyId="@Model.PropertyId"
                   class="ml-2 rounded-xl border border-border bg-card px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:bg-secondary hover:text-foreground transition shadow-sm">
                    Today
                </a>
            </div>

            <!-- Stats -->
            <div class="flex items-center justify-start md:justify-center gap-6">
                <div class="flex items-center gap-2">
                    <span class="size-3 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-medium text-muted-foreground">Reservations: <strong class="text-foreground">@Model.TotalBookingsThisMonth</strong></span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="size-3 rounded-full bg-amber-500"></span>
                    <span class="text-xs font-medium text-muted-foreground">Blocked Days: <strong class="text-foreground">@Model.TotalBlockedDaysThisMonth</strong></span>
                </div>
            </div>

            <!-- Legend -->
            <div class="flex items-center justify-start md:justify-end gap-3 text-xs text-muted-foreground">
                <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-emerald-500"></span> Confirmed</span>
                <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-yellow-500"></span> Pending</span>
                <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-rose-500"></span> Blocked</span>
            </div>
        </div>

        <!-- Calendar Grid Container -->
        <div class="rounded-2xl border border-border bg-card overflow-hidden shadow-sm">
            <!-- Day Names Header -->
            <div class="grid grid-cols-7 border-b border-border bg-muted/40 text-center text-xs font-semibold text-muted-foreground">
                <div class="py-3">Sun</div>
                <div class="py-3">Mon</div>
                <div class="py-3">Tue</div>
                <div class="py-3">Wed</div>
                <div class="py-3">Thu</div>
                <div class="py-3">Fri</div>
                <div class="py-3">Sat</div>
            </div>

            <!-- Day Cells Grid -->
            <div class="grid grid-cols-7 divide-x divide-y divide-border">
                @foreach (var cell in Model.Days)
                {
                    var cellBg = !cell.IsCurrentMonth 
                        ? "bg-muted/15 text-muted-foreground/40" 
                        : cell.IsToday 
                            ? "bg-primary/5" 
                            : "bg-card";

                    <div class="min-h-28 p-2 @cellBg relative transition hover:bg-muted/30 group flex flex-col justify-between">
                        <!-- Cell Header: Date number & indicators -->
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold @(cell.IsToday ? "size-6 rounded-full bg-primary text-primary-foreground flex items-center justify-center shadow-xs" : cell.IsCurrentMonth ? "text-foreground" : "text-muted-foreground/50")">
                                @cell.DayNumber
                            </span>

                            @if (cell.IsToday)
                            {
                                <span class="text-[10px] font-semibold text-primary uppercase tracking-wider">Today</span>
                            }
                        </div>

                        <!-- Cell Body: Events List -->
                        <div class="space-y-1 mt-1.5 flex-1">
                            <!-- Bookings -->
                            @foreach (var b in cell.Bookings)
                            {
                                var badgeStyle = b.Status == "Approved" 
                                    ? "bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30" 
                                    : "bg-amber-500/15 text-amber-700 dark:text-amber-400 border border-amber-500/30";

                                <div class="rounded-md px-1.5 py-0.5 text-[11px] leading-tight font-medium @badgeStyle flex items-center justify-between" title="@b.GuestName — @b.Status (@b.CheckIn.ToString("MMM dd") - @b.CheckOut.ToString("MMM dd"))">
                                    <span class="truncate">👤 @b.GuestName</span>
                                    <span class="text-[9px] uppercase font-bold ml-1 flex-shrink-0">@b.Status.Substring(0, Math.Min(3, b.Status.Length))</span>
                                </div>
                            }

                            <!-- Blocked Dates -->
                            @foreach (var bl in cell.BlockedRanges)
                            {
                                <div class="rounded-md px-1.5 py-0.5 text-[11px] leading-tight font-medium bg-rose-500/15 text-rose-700 dark:text-rose-400 border border-rose-500/30 flex items-center justify-between group/blk" title="Blocked: @bl.Reason">
                                    <span class="truncate">🚫 @bl.Reason</span>
                                    <form asp-action="UnblockDates" method="post" class="inline ml-1" onsubmit="return confirm('Unblock this date range? Guests will be able to book these dates again.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="blockedDateId" value="@bl.BlockedDateId" />
                                        <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                                        <input type="hidden" name="year" value="@Model.Year" />
                                        <input type="hidden" name="month" value="@Model.Month" />
                                        <button type="submit" class="text-rose-600 hover:text-rose-800 font-bold hover:scale-110 transition flex-shrink-0" title="Unblock these dates">✕</button>
                                    </form>
                                </div>
                            }
                        </div>

                        <!-- Quick Block Button for empty days -->
                        @if (cell.IsCurrentMonth && !cell.IsPast && !cell.IsBooked && !cell.IsBlocked)
                        {
                            <div class="opacity-0 group-hover:opacity-100 transition-opacity pt-1 flex justify-end">
                                <button type="button" onclick="openBlockModalForDate('@cell.Date.ToString("yyyy-MM-dd")')" class="text-[10px] text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-md px-1.5 py-0.5 font-semibold transition">
                                    + Block
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Block Dates Modal Dialog (Pure White & Green Theme) -->
<div id="blockModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity" onclick="closeBlockModal()"></div>

    <!-- Modal Card (Pure White Luxury Card) -->
    <div class="relative w-full max-w-lg rounded-3xl border border-gray-200 bg-white text-gray-900 p-6 sm:p-8 shadow-2xl z-10 space-y-5 max-h-[90vh] overflow-y-auto" style="background-color: #ffffff !important; color: #111827 !important;">
        <!-- Close button -->
        <button type="button" onclick="closeBlockModal()" class="absolute top-5 right-5 rounded-full p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition" aria-label="Close">
            <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <!-- Header -->
        <div class="space-y-1">
            <div class="flex items-center gap-2">
                <h3 class="text-xl font-bold tracking-tight text-gray-900">Block Property Dates</h3>
                <span class="rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">Host Tool</span>
            </div>
            <p class="text-xs text-gray-500">Reserve your property for personal stays, maintenance, or off-season periods.</p>
        </div>

        <form asp-action="BlockDates" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PropertyId" value="@Model.PropertyId" />

            <!-- Property Display -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">Property</label>
                <div class="flex items-center gap-2.5 rounded-2xl border border-gray-200 bg-gray-50/80 px-4 py-3 text-sm font-medium text-gray-800">
                    <span class="text-base">🏡</span>
                    <span class="truncate font-semibold">@Model.PropertyName</span>
                </div>
            </div>

            <!-- Dates Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label for="blockStartDate" class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">Start Date</label>
                    <input type="date" id="blockStartDate" name="StartDate" required min="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full rounded-2xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-2xs focus:border-[#0d9488] focus:outline-none focus:ring-2 focus:ring-[#0d9488]/20" style="background-color: #ffffff !important; color: #111827 !important;" />
                </div>
                <div>
                    <label for="blockEndDate" class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">End Date</label>
                    <input type="date" id="blockEndDate" name="EndDate" required min="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full rounded-2xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-2xs focus:border-[#0d9488] focus:outline-none focus:ring-2 focus:ring-[#0d9488]/20" style="background-color: #ffffff !important; color: #111827 !important;" />
                </div>
            </div>

            <!-- Reason -->
            <div>
                <label for="blockReason" class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">Reason for Blocking</label>
                <select id="blockReason" name="Reason" class="w-full rounded-2xl border border-gray-200 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-2xs focus:border-[#0d9488] focus:outline-none focus:ring-2 focus:ring-[#0d9488]/20" style="background-color: #ffffff !important; color: #111827 !important;">
                    <option value="Personal Stay">Personal Stay / Family Use</option>
                    <option value="Property Maintenance">Property Maintenance / Deep Clean</option>
                    <option value="Renovation & Upgrades">Renovation & Upgrades</option>
                    <option value="Off-Season Closure">Off-Season Closure</option>
                    <option value="Private Booking">Private Booking Outside Havenly</option>
                </select>
            </div>

            <!-- Notice Banner -->
            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-xs font-medium text-amber-800 flex items-start gap-2.5 leading-relaxed">
                <span class="text-base flex-shrink-0">⚠️</span>
                <span>Dates that already have confirmed or pending guest reservations cannot be blocked.</span>
            </div>

            <!-- Footer Buttons -->
            <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                <button type="button" onclick="closeBlockModal()" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition px-3 py-2">
                    Cancel
                </button>
                <button type="submit" class="rounded-full bg-[#0d9488] px-6 py-2.5 text-sm font-semibold text-white shadow hover:bg-[#0f766e] transition flex items-center gap-1.5" style="background-color: #0d9488 !important; color: #ffffff !important;">
                    Confirm Block →
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function switchProperty(propId) {
            window.location.href = '@Url.Action("Calendar", "Host")?propertyId=' + propId + '&year=@Model.Year&month=@Model.Month';
        }

        function openBlockModal() {
            const today = new Date().toISOString().split('T')[0];
            const startInput = document.getElementById('blockStartDate');
            const endInput = document.getElementById('blockEndDate');
            if (!startInput.value) startInput.value = today;
            if (!endInput.value) endInput.value = today;
            const modal = document.getElementById('blockModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function openBlockModalForDate(dateStr) {
            document.getElementById('blockStartDate').value = dateStr;
            document.getElementById('blockEndDate').value = dateStr;
            const modal = document.getElementById('blockModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeBlockModal() {
            const modal = document.getElementById('blockModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        document.getElementById('blockStartDate')?.addEventListener('change', function() {
            const endInput = document.getElementById('blockEndDate');
            if (endInput && this.value) {
                endInput.min = this.value;
                if (endInput.value && endInput.value < this.value) {
                    endInput.value = this.value;
                }
            }
        });
    </script>
}
