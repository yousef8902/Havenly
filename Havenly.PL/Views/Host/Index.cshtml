@model Havenly.BLL.ModelVMs.PropertyCardVM

@{
    ViewData["Title"] = "Host dashboard — Havenly";
    ViewData["Description"] = "Manage your properties and bookings.";
    Layout = "~/Views/Shared/_WorkspaceLayout.cshtml";
    ViewData["Workspace"] = "Host dashboard";
    ViewData["WorkspaceRole"] = $"{User.Identity?.Name ?? "Host"} · Host";
    ViewData["WorkspaceNav"] = "host";
}

<!-- Page Heading -->
<div class="space-y-2 mb-8">
    <h1 class="text-3xl font-bold">Overview</h1>
    <p class="text-muted-foreground">Calendar, earnings and recent activity.</p>
</div>

<!-- Stat Cards Grid -->
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4 mb-8">
    <!-- Net Earnings Card -->
    <div class="rounded-2xl border border-border bg-card p-6">
        <div class="space-y-2">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-muted-foreground">Net Earnings</p>
                <a asp-action="Payouts" class="text-xs font-semibold text-primary hover:underline">Payouts →</a>
            </div>
            <p class="text-3xl font-bold text-foreground">@(((decimal)(ViewBag.TotalEarnings ?? 0m)).ToString("N2")) EGP</p>
            <p class="text-xs text-emerald-600 font-medium">Pending: @(((decimal)(ViewBag.PendingPayouts ?? 0m)).ToString("N2")) EGP</p>
        </div>
    </div>

    <!-- Active Listings Card -->
    <div class="rounded-2xl border border-border bg-card p-6">
        <div class="space-y-2">
            <p class="text-sm font-medium text-muted-foreground">Active listings</p>
            <p class="text-3xl font-bold">@(ViewBag.ActiveListings ?? 0)</p>
            <p class="text-xs text-muted-foreground">Approved for booking</p>
        </div>
    </div>

    <!-- Pending Listings Card -->
    <div class="rounded-2xl border border-border bg-card p-6">
        <div class="space-y-2">
            <p class="text-sm font-medium text-muted-foreground">Pending review</p>
            <p class="text-3xl font-bold">@(ViewBag.PendingListings ?? 0)</p>
            <p class="text-xs text-muted-foreground">Awaiting admin check</p>
        </div>
    </div>

    <!-- Quick Action Card -->
    <div class="rounded-2xl border border-border bg-card p-6 flex flex-col justify-between">
        <div>
            <p class="text-sm font-medium text-muted-foreground">Host actions</p>
            <p class="text-base font-semibold mt-1">Ready to expand?</p>
        </div>
        <a asp-action="CreateProperty" class="mt-3 inline-flex items-center justify-center rounded-xl bg-primary py-2 px-4 text-xs font-semibold text-primary-foreground hover:bg-primary/90">
            + New property
        </a>
    </div>
</div>

<!-- Recent Bookings Section -->
<div class="rounded-2xl border border-border bg-card overflow-hidden">
    <div class="border-b border-border p-6">
        <div class="flex items-center justify-between">
            <h2 class="text-xl font-semibold">Recent bookings</h2>
            <a asp-controller="Host" asp-action="Bookings" class="text-sm font-semibold text-primary hover:underline">
                View all
            </a>
        </div>
    </div>

    <!-- Bookings Table -->
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="border-b border-border bg-secondary/30">
                <tr>
                    <th class="text-left px-6 py-3 font-semibold text-sm text-muted-foreground">Guest</th>
                    <th class="text-left px-6 py-3 font-semibold text-sm text-muted-foreground">Property</th>
                    <th class="text-left px-6 py-3 font-semibold text-sm text-muted-foreground">Dates</th>
                    <th class="text-left px-6 py-3 font-semibold text-sm text-muted-foreground">Total</th>
                    <th class="text-left px-6 py-3 font-semibold text-sm text-muted-foreground">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-border">
                @{
                    var bookings = ViewBag.RecentBookings as IEnumerable<Havenly.DAL.Entities.Booking>;
                }
                @if (bookings != null && bookings.Any())
                {
                    @foreach (var b in bookings)
                    {
                        <tr class="hover:bg-secondary/30">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3 cursor-pointer group" onclick="openProfileModal('@b.GuestUserID')">
                                    <div class="size-8 rounded-full bg-primary/10 text-primary font-bold text-xs flex items-center justify-center border border-primary/20 flex-shrink-0 overflow-hidden group-hover:scale-105 transition">
                                        @if (!string.IsNullOrEmpty(b.Guest?.ProfilePictureUrl))
                                        {
                                            <img src="@b.Guest.ProfilePictureUrl" alt="@(b.Guest?.Name ?? "Guest")" class="size-full object-cover" />
                                        }
                                        else
                                        {
                                            <span>@(string.IsNullOrWhiteSpace(b.Guest?.Name) ? "G" : b.Guest.Name[0].ToString().ToUpper())</span>
                                        }
                                    </div>
                                    <div>
                                        <div class="font-medium text-foreground group-hover:text-primary transition">@(b.Guest?.Name ?? "Guest")</div>
                                        <div class="text-xs text-muted-foreground">@(b.Guest?.Email ?? "")</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm font-medium">
                                @(b.Listing?.Property?.PropertyName ?? $"Listing #{b.ListingID}")
                            </td>
                            <td class="px-6 py-4 text-sm">
                                @b.CheckIn.ToString("MMM dd") - @b.CheckOut.ToString("MMM dd, yyyy")
                            </td>
                            <td class="px-6 py-4 text-sm font-semibold">@b.TotalPrice EGP</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold @(b.Status == Havenly.DAL.Enums.BookingStatus.Approved ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800")">
                                    @b.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-sm text-muted-foreground">
                            No reservations yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
