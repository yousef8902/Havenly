@model Havenly.BLL.ModelVMs.HostPropertiesPageVM
@using Havenly.DAL.Enums

@{
    ViewData["Title"] = "My properties — Havenly";
    ViewData["Description"] = "Manage your property listings.";
    Layout = "~/Views/Shared/_WorkspaceLayout.cshtml";
    ViewData["Workspace"] = "Host dashboard";
    ViewData["WorkspaceNav"] = "host";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-3xl font-bold">My properties</h1>
            <p class="text-muted-foreground mt-1">Manage your active, pending, and draft listings.</p>
        </div>
        <a asp-action="CreateProperty" class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow transition hover:bg-primary/90">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Add new property
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-xl border border-success/30 bg-emerald-500/10 p-4 text-sm font-medium text-emerald-700">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-xl border border-destructive/30 bg-destructive/10 p-4 text-sm font-medium text-destructive">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Properties != null && Model.Properties.Any())
    {
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var property in Model.Properties)
            {
                <div class="group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition hover:shadow-md">
                    <!-- Image -->
                    <div class="relative aspect-video w-full overflow-hidden bg-secondary">
                        <img src="@property.ImageUrl" alt="@property.PropertyName" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
                        
                        <!-- Status Badge -->
                        <div class="absolute left-3 top-3">
                            @switch (property.ListingStatus)
                            {
                                case ListingStatus.Approved:
                                    <span class="inline-flex items-center rounded-full bg-green-500/90 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
                                        Approved
                                    </span>
                                    break;
                                case ListingStatus.Pending:
                                    <span class="inline-flex items-center rounded-full bg-amber-500/90 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
                                        Pending review
                                    </span>
                                    break;
                                case ListingStatus.Declined:
                                    <span class="inline-flex items-center rounded-full bg-red-500/90 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
                                        Declined
                                    </span>
                                    break;
                            }
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="flex flex-1 flex-col justify-between p-5 space-y-4">
                        <div>
                            <div class="flex items-start justify-between gap-2">
                                <h3 class="font-bold text-lg leading-tight line-clamp-1">@property.PropertyName</h3>
                                <div class="flex items-center gap-1 text-xs font-bold text-amber-500">
                                    <svg class="size-3.5 fill-current" viewBox="0 0 24 24">
                                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
                                    </svg>
                                    <span>@(property.Rating > 0 ? property.Rating.ToString("F1") : "New")</span>
                                </div>
                            </div>
                            <p class="text-sm text-muted-foreground mt-1">@property.City, @property.Country</p>
                            <p class="text-xs text-muted-foreground mt-1 flex items-center gap-1.5 flex-wrap">
                                <span class="inline-block rounded bg-secondary px-2 py-0.5 text-xs font-semibold text-foreground">@property.Category</span>
                                <span>·</span>
                                <span>Up to @property.Guests guests</span>
                                <span>·</span>
                                <span>@property.NumberOfReviews reviews</span>
                            </p>
                            <p class="text-base font-bold text-foreground mt-2">$@property.Price <span class="text-xs font-normal text-muted-foreground">/ night</span></p>
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center gap-2 border-t border-border pt-4">
                            <a asp-action="EditProperty" asp-route-id="@property.PropertyId" class="flex-1 rounded-lg border border-border bg-secondary/50 py-2 text-center text-xs font-semibold hover:bg-secondary">
                                Edit details
                            </a>
                            <form asp-action="DeleteProperty" asp-route-id="@property.PropertyId" method="post" onsubmit="return confirm('Are you sure you want to delete this property?');" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-xs font-semibold text-destructive hover:bg-destructive/20">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-border py-16 text-center">
            <div class="grid size-14 place-items-center rounded-full bg-secondary text-muted-foreground mb-4">
                <svg class="size-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
            </div>
            <h3 class="text-lg font-bold">No properties listed yet</h3>
            <p class="text-sm text-muted-foreground mt-1 max-w-sm">
                Start sharing your place with guests from around the world.
            </p>
            <a asp-action="CreateProperty" class="mt-5 rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow hover:bg-primary/90">
                Create your first listing
            </a>
        </div>
    }
</div>
