@model IEnumerable<Havenly.DAL.Entities.Booking>
@using Havenly.DAL.Enums

@{
    ViewData["Title"] = "Property bookings — Havenly";
    Layout = "~/Views/Shared/_WorkspaceLayout.cshtml";
    ViewData["Workspace"] = "Host dashboard";
    ViewData["WorkspaceNav"] = "host";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold">Booking requests</h1>
            <p class="text-muted-foreground mt-1">Manage guest reservations for your properties.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-sm font-medium text-emerald-700">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm font-medium text-red-700">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="rounded-2xl border border-border bg-card overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="border-b border-border bg-secondary/40 text-muted-foreground text-left">
                        <tr>
                            <th class="px-6 py-4 font-semibold">Guest</th>
                            <th class="px-6 py-4 font-semibold">Property</th>
                            <th class="px-6 py-4 font-semibold">Dates</th>
                            <th class="px-6 py-4 font-semibold">Total payout</th>
                            <th class="px-6 py-4 font-semibold">Status</th>
                            <th class="px-6 py-4 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        @foreach (var booking in Model)
                        {
                            <tr class="hover:bg-secondary/20 transition">
                                <td class="px-6 py-4">
                                    <div class="font-semibold">@(booking.Guest?.Name ?? "Guest")</div>
                                    <div class="text-xs text-muted-foreground">@(booking.Guest?.Email ?? "")</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="font-medium line-clamp-1">@(booking.Listing?.Property?.PropertyName ?? "Listing #" + booking.ListingID)</div>
                                    <div class="text-xs text-muted-foreground">@(booking.Listing?.Property?.Address?.City ?? "")</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div>@booking.CheckIn.ToString("MMM dd, yyyy") — @booking.CheckOut.ToString("MMM dd, yyyy")</div>
                                    <div class="text-xs text-muted-foreground">@((booking.CheckOut - booking.CheckIn).Days) nights</div>
                                </td>
                                <td class="px-6 py-4 font-bold text-foreground">
                                    $@booking.TotalPrice.ToString("N0")
                                </td>
                                <td class="px-6 py-4">
                                    @switch (booking.Status)
                                    {
                                        case BookingStatus.Pending:
                                            <span class="inline-flex items-center rounded-full bg-yellow-500/10 px-2.5 py-1 text-xs font-semibold text-yellow-600">
                                                Pending
                                            </span>
                                            break;
                                        case BookingStatus.Approved:
                                            <span class="inline-flex items-center rounded-full bg-green-500/10 px-2.5 py-1 text-xs font-semibold text-green-600">
                                                Approved
                                            </span>
                                            break;
                                        case BookingStatus.Rejected:
                                            <span class="inline-flex items-center rounded-full bg-red-500/10 px-2.5 py-1 text-xs font-semibold text-red-600">
                                                Rejected
                                            </span>
                                            break;
                                        case BookingStatus.Cancelled:
                                            <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">
                                                Cancelled
                                            </span>
                                            break;
                                        case BookingStatus.Completed:
                                            <span class="inline-flex items-center rounded-full bg-blue-500/10 px-2.5 py-1 text-xs font-semibold text-blue-600">
                                                Completed
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    @if (booking.Status == BookingStatus.Pending)
                                    {
                                        <div class="flex items-center justify-end gap-2">
                                            <form asp-controller="Host" asp-action="AcceptBooking" asp-route-id="@booking.BookingID" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition">
                                                    Accept
                                                </button>
                                            </form>
                                            <form asp-controller="Host" asp-action="RejectBooking" asp-route-id="@booking.BookingID" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="rounded-lg border border-red-300 bg-transparent px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-50 transition" onclick="return confirm('Are you sure you want to reject this booking?');">
                                                    Reject
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-muted-foreground">No actions</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-border py-16 text-center">
            <h3 class="text-lg font-bold">No bookings found</h3>
            <p class="text-sm text-muted-foreground mt-1">
                You will see reservation requests here once guests book your places.
            </p>
        </div>
    }
</div>
