@model List<Havenly.BLL.ModelVMs.ReviewItemVM>

@{
    ViewData["Title"] = "My reviews — Havenly";
    ViewData["Description"] = "Your reviews and responses on Havenly.";
}

<div class="container-page py-12 space-y-8">
    <div>
        <h1 class="text-3xl md:text-4xl font-bold">My reviews</h1>
        <p class="mt-1 text-muted-foreground">
            Reviews you've written and responses from hosts.
        </p>
    </div>

    @if (Model.Any())
    {
        <div class="space-y-6">
            @foreach (var review in Model)
            {
                <div class="rounded-2xl border border-border bg-card p-6 space-y-4">
                    <!-- Review Header -->
                    <div class="flex items-start justify-between">
                        <div>
                            <a asp-controller="Property" asp-action="Detail" asp-route-id="@review.PropertyId" class="font-semibold text-lg hover:text-primary">
                                @review.PropertyTitle
                            </a>
                            <p class="text-sm text-muted-foreground mt-1">@review.Date</p>
                        </div>

                        <!-- Rating -->
                        <div class="flex gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                <svg class="size-5 @(i < review.Rating ? "fill-yellow-400 text-yellow-400" : "text-muted")" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15l-3.255 1.716A1 1 0 015.882 15.23l.636-3.7a1 1 0 00-.288-1.112L2.696 9.5a1 1 0 00.553-1.697l3.738-.543 1.67-3.372a1 1 0 011.8 0l1.67 3.372 3.738.543a1 1 0 00.553 1.697l-2.704 2.364a1 1 0 00-.288 1.112l.636 3.7a1 1 0 01-1.537 1.055L12 15z"></path>
                                </svg>
                            }
                        </div>
                    </div>

                    <!-- Review Text -->
                    <p class="text-muted-foreground leading-relaxed">@review.Body</p>

                    <!-- Host Response -->
                    @if (!string.IsNullOrEmpty(review.HostResponse))
                    {
                        <div class="border-l-4 border-primary bg-primary/5 p-4 mt-4">
                            <p class="text-sm font-semibold text-primary mb-2">Response from host</p>
                            <p class="text-sm text-muted-foreground">@review.HostResponse</p>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-border py-16">
            <svg class="size-12 text-muted-foreground mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v12a2 2 0 01-2 2h-3l-4 4z"></path>
            </svg>
            <h3 class="text-lg font-semibold mb-2">No reviews yet</h3>
            <p class="text-sm text-muted-foreground text-center max-w-md mb-4">
                Once you've completed a stay, you can leave a review for the property.
            </p>
            <a asp-controller="Bookings" asp-action="Index" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90">
                View your bookings
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/reviews.js" asp-append-version="true"></script>
}
