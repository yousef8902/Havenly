@model Havenly.BLL.ModelVMs.ReviewCreateVM

@{
    ViewData["Title"] = $"Review Your Stay — {Model.PropertyName}";
}

<div class="container-page py-10 max-w-2xl mx-auto space-y-8">
    <!-- Header -->
    <div class="text-center space-y-2">
        <span class="rounded-full bg-primary/10 text-primary px-3 py-1 text-xs font-semibold uppercase tracking-wider">
            Guest Experience Review
        </span>
        <h1 class="text-3xl font-bold tracking-tight">How was your stay?</h1>
        <p class="text-sm text-muted-foreground">Your review helps other travelers and supports @Model.HostName in improving hospitality</p>
    </div>

    <!-- Property Summary Card -->
    <div class="rounded-2xl border border-border bg-card p-5 shadow-sm flex flex-col sm:flex-row items-center gap-4">
        <img src="@Model.PropertyImage" alt="@Model.PropertyName" class="h-24 w-32 rounded-xl object-cover flex-shrink-0" />
        <div class="space-y-1 flex-1 text-center sm:text-left">
            <h3 class="font-bold text-base text-foreground">@Model.PropertyName</h3>
            <p class="text-xs text-muted-foreground flex items-center justify-center sm:justify-start gap-1">
                <svg class="size-3.5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>@Model.City, @Model.Country</span>
            </p>
            <div class="flex items-center justify-center sm:justify-start gap-3 pt-1 text-xs text-muted-foreground">
                <span>🗓️ @Model.CheckIn.ToString("MMM dd, yyyy") – @Model.CheckOut.ToString("MMM dd, yyyy")</span>
                <span>•</span>
                <span>Hosted by <strong class="text-foreground">@Model.HostName</strong></span>
            </div>
        </div>
    </div>

    <!-- Review Form -->
    <div class="rounded-3xl border border-border bg-card p-6 sm:p-8 shadow-lift space-y-6">
        <form asp-controller="Reviews" asp-action="Create" method="post" class="space-y-6" id="reviewForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BookingId" />
            <input type="hidden" asp-for="PropertyId" />
            <input type="hidden" asp-for="PropertyName" />
            <input type="hidden" asp-for="PropertyImage" />
            <input type="hidden" asp-for="City" />
            <input type="hidden" asp-for="Country" />
            <input type="hidden" asp-for="HostName" />
            <input type="hidden" asp-for="CheckIn" />
            <input type="hidden" asp-for="CheckOut" />

            <!-- Validation Errors -->
            <div asp-validation-summary="ModelOnly" class="rounded-xl border border-destructive/30 bg-destructive/10 p-3 text-xs text-destructive"></div>

            <!-- Interactive Star Rating -->
            <div class="space-y-2 text-center">
                <label class="block text-sm font-semibold">Overall Rating <span class="text-destructive">*</span></label>
                <div class="flex justify-center items-center gap-2" id="starContainer">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <button type="button" class="star-btn p-1 text-3xl focus:outline-none transition-transform hover:scale-125" data-rating="@i" onclick="setRating(@i)">
                            <span class="star-icon @(i <= Model.Rating ? "text-amber-400" : "text-muted")">★</span>
                        </button>
                    }
                </div>
                <input type="hidden" asp-for="Rating" id="ratingInput" />
                <p id="ratingLabel" class="text-xs font-semibold text-primary">5 - Exceptional Experience</p>
                <span asp-validation-for="Rating" class="text-xs text-destructive block"></span>
            </div>

            <!-- Comment Textarea -->
            <div class="space-y-1.5">
                <div class="flex justify-between items-center">
                    <label asp-for="Comment" class="block text-sm font-semibold">
                        Your Feedback & Experience <span class="text-destructive">*</span>
                    </label>
                    <span id="charCount" class="text-[11px] text-muted-foreground">0 / 1000</span>
                </div>
                <textarea asp-for="Comment" id="reviewComment" rows="5" maxlength="1000"
                          placeholder="Tell future guests about your stay: What did you love most? Was check-in easy? How was communication with @Model.HostName?"
                          class="w-full rounded-2xl border border-border bg-background p-4 text-sm focus:border-primary focus:outline-none leading-relaxed transition"></textarea>
                <span asp-validation-for="Comment" class="text-xs text-destructive block"></span>
            </div>

            <!-- Egyptian Hospitality Review Tips -->
            <div class="rounded-2xl border border-primary/20 bg-primary/5 p-4 space-y-1.5 text-xs text-muted-foreground leading-relaxed">
                <p class="font-semibold text-primary flex items-center gap-1.5">
                    <span>💡 Tips for a Great Havenly Review</span>
                </p>
                <ul class="list-disc list-inside space-y-1 text-[11px]">
                    <li>Mention listing accuracy: did the photos and amenities match reality?</li>
                    <li>Comment on location accessibility, nearby transportation, or Egyptian landmarks.</li>
                    <li>Highlight host hospitality, responsiveness, and check-in smoothness.</li>
                </ul>
            </div>

            <!-- Submit Button -->
            <div class="flex flex-col sm:flex-row gap-3 pt-2">
                <button type="submit" class="flex-1 rounded-xl bg-primary py-3 text-sm font-semibold text-primary-foreground shadow hover:bg-primary/90 transition">
                    Publish Review
                </button>
                <a asp-controller="Booking" asp-action="MyBookings" class="rounded-xl border border-border bg-background py-3 px-6 text-sm font-medium text-center hover:bg-secondary transition">
                    Back to Bookings
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const ratingLabels = {
            1: "1 - Disappointing Stay",
            2: "2 - Needs Improvement",
            3: "3 - Average Experience",
            4: "4 - Very Good Stay",
            5: "5 - Exceptional Experience"
        };

        function setRating(rating) {
            document.getElementById('ratingInput').value = rating;
            document.getElementById('ratingLabel').textContent = ratingLabels[rating] || (rating + " Stars");

            const starBtns = document.querySelectorAll('.star-btn');
            starBtns.forEach((btn, index) => {
                const icon = btn.querySelector('.star-icon');
                if (index < rating) {
                    icon.classList.remove('text-muted');
                    icon.classList.add('text-amber-400');
                } else {
                    icon.classList.remove('text-amber-400');
                    icon.classList.add('text-muted');
                }
            });
        }

        // Live Character Counter
        const commentArea = document.getElementById('reviewComment');
        const charCount = document.getElementById('charCount');
        if (commentArea && charCount) {
            function updateCount() {
                charCount.textContent = `${commentArea.value.length} / 1000`;
            }
            commentArea.addEventListener('input', updateCount);
            updateCount();
        }
    </script>
}
