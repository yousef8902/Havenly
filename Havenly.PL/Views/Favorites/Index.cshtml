@model Havenly.BLL.ModelVMs.FavoritesPageVM

@{
    ViewData["Title"] = "Saved stays — Havenly";
    ViewData["Description"] = "Your collection of saved Havenly homes.";
}

<div class="container-page py-12 space-y-8">
    <div>
        <h1 class="text-3xl md:text-4xl font-bold">Saved stays</h1>
        <p class="mt-1 text-muted-foreground">
            Your collection of saved Havenly homes — ready to book whenever inspiration strikes.
        </p>
    </div>

    @if (Model.Saved.Any())
    {
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var property in Model.Saved)
            {
                <partial name="_PropertyCard" model="property" />
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-border py-16">
            <svg class="size-12 text-muted-foreground mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
            <h3 class="text-lg font-semibold mb-2">No favorites yet</h3>
            <p class="text-sm text-muted-foreground text-center max-w-md mb-4">
                Save properties as you explore to keep track of your favorite stays.
            </p>
            <a asp-controller="Property" asp-action="Index" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90">
                Explore stays
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
