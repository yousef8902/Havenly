@model Havenly.BLL.ModelVMs.PropertyDetailsVM

@{
    ViewData["Title"] = $"{Model.Title} — Havenly";
    ViewData["Description"] = Model.Description.Length > 155 ? Model.Description.Substring(0, 155) : Model.Description;
}

<div class="container-page py-8 space-y-12">
    <!-- Image Gallery -->
    @if (Model.Images.Any())
    {
        <div class="space-y-3">
            <div class="relative h-96 overflow-hidden rounded-2xl bg-muted">
                <img id="mainImage" src="@Model.Images.First()" alt="@Model.Title" class="h-full w-full object-cover" />
            </div>
            @if (Model.Images.Count() > 1)
            {
                <div class="grid grid-cols-3 gap-3 md:grid-cols-4">
                    @foreach (var image in Model.Images.Take(4))
                    {
                        <button type="button" class="overflow-hidden rounded-lg border-2 border-transparent hover:border-primary"
                                onclick="document.getElementById('mainImage').src = '@image'">
                            <img src="@image" alt="@Model.Title" class="h-24 w-full object-cover" />
                        </button>
                    }
                    @if (Model.Images.Count() > 4)
                    {
                        <button type="button" class="relative overflow-hidden rounded-lg bg-muted"
                                onclick="alert('Show all images')">
                            <img src="@Model.Images[4]" alt="@Model.Title" class="h-24 w-full object-cover opacity-50" />
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span class="text-sm font-semibold">+@(Model.Images.Count() - 4)</span>
                            </div>
                        </button>
                    }
                </div>
            }
        </div>
    }

    <!-- Main Content Grid -->
    <div class="grid gap-8 lg:grid-cols-[1fr_24rem]">
        <!-- Left Column -->
        <div class="space-y-8">
            <!-- Header -->
            <div class="space-y-3 border-b border-border pb-6">
                <h1 class="text-3xl font-bold">@Model.Title</h1>

                <!-- Location & Rating -->
                <div class="flex flex-wrap items-center gap-4">
                    <div class="flex items-center gap-2">
                        <svg class="size-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span class="text-muted-foreground">@Model.City, @Model.Country</span>
                    </div>

                    <div class="flex items-center gap-1">
                        <div class="flex gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                <svg class="size-4 @(i < (int)Model.Rating ? "fill-yellow-400 text-yellow-400" : "text-muted")" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15l-3.255 1.716A1 1 0 015.882 15.23l.636-3.7a1 1 0 00-.288-1.112L2.696 9.5a1 1 0 00.553-1.697l3.738-.543 1.67-3.372a1 1 0 011.8 0l1.67 3.372 3.738.543a1 1 0 00.553 1.697l-2.704 2.364a1 1 0 00-.288 1.112l.636 3.7a1 1 0 01-1.537 1.055L12 15z"></path>
                                </svg>
                            }
                        </div>
                        <span class="font-medium">@Model.Rating.ToString("F1")</span>
                        <span class="text-muted-foreground">(@Model.Reviews reviews)</span>
                    </div>
                </div>
            </div>

            <!-- Property Details -->
            <div class="grid gap-6 sm:grid-cols-3">
                <div class="space-y-2">
                    <p class="text-sm font-medium text-muted-foreground">Guests</p>
                    <p class="text-2xl font-semibold">@Model.Guests</p>
                </div>
                <div class="space-y-2">
                    <p class="text-sm font-medium text-muted-foreground">Bedrooms</p>
                    <p class="text-2xl font-semibold">@Model.Bedrooms</p>
                </div>
                <div class="space-y-2">
                    <p class="text-sm font-medium text-muted-foreground">Bathrooms</p>
                    <p class="text-2xl font-semibold">@Model.Baths</p>
                </div>
            </div>

            <!-- Description -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="space-y-3 border-b border-border pb-6">
                    <h2 class="text-xl font-semibold">About this place</h2>
                    <p class="text-muted-foreground leading-relaxed">@Model.Description</p>
                </div>
            }

            <!-- Amenities -->
            @if (Model.Amenities.Any())
            {
                <div class="space-y-3 border-b border-border pb-6">
                    <h2 class="text-xl font-semibold">Amenities</h2>
                    <div class="grid gap-3 sm:grid-cols-2">
                        @foreach (var amenity in Model.Amenities)
                        {
                            <div class="flex items-center gap-2">
                                <svg class="size-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"></path>
                                </svg>
                                <span>@amenity</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- House Rules -->
            @if (Model.Rules.Any())
            {
                <div class="space-y-3 border-b border-border pb-6">
                    <h2 class="text-xl font-semibold">House rules</h2>
                    <ul class="space-y-2">
                        @foreach (var rule in Model.Rules)
                        {
                            <li class="flex items-start gap-2 text-sm text-muted-foreground">
                                <svg class="size-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <span>@rule</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- Host Info -->
            <div class="space-y-3 border-b border-border pb-6">
                <h2 class="text-xl font-semibold">About the host</h2>
                <div class="flex items-start gap-4">
                    <div class="size-16 rounded-full bg-primary text-primary-foreground flex items-center justify-center text-2xl font-bold">
                        @Model.Host.Name.First()
                    </div>
                    <div>
                        <h3 class="font-semibold">@Model.Host.Name</h3>
                        <p class="text-sm text-muted-foreground">Host since @Model.Host.Since</p>
                        @if (Model.Host.Superhost)
                        {
                            <div class="mt-2 inline-flex items-center gap-1 rounded-full bg-primary/10 px-3 py-1">
                                <svg class="size-4 text-primary" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                                </svg>
                                <span class="text-xs font-semibold text-primary">Superhost</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Reviews -->
            @if (Model.PropertyReviews.Any())
            {
                <div class="space-y-6">
                    <div>
                        <h2 class="text-xl font-semibold mb-4">Reviews (@Model.PropertyReviews.Count())</h2>
                        <div class="space-y-4">
                            @foreach (var review in Model.PropertyReviews.Take(3))
                            {
                                <div class="border-b border-border pb-4">
                                    <div class="flex items-start justify-between mb-2">
                                        <div>
                                            <p class="font-semibold">@review.Author</p>
                                            <p class="text-sm text-muted-foreground">@review.Date</p>
                                        </div>
                                        <div class="flex gap-0.5">
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                <svg class="size-4 @(i < review.Rating ? "fill-yellow-400 text-yellow-400" : "text-muted")" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15l-3.255 1.716A1 1 0 015.882 15.23l.636-3.7a1 1 0 00-.288-1.112L2.696 9.5a1 1 0 00.553-1.697l3.738-.543 1.67-3.372a1 1 0 011.8 0l1.67 3.372 3.738.543a1 1 0 00.553 1.697l-2.704 2.364a1 1 0 00-.288 1.112l.636 3.7a1 1 0 01-1.537 1.055L12 15z"></path>
                                                </svg>
                                            }
                                        </div>
                                    </div>
                                    <p class="text-sm text-muted-foreground">@review.Body</p>
                                </div>
                            }
                        </div>
                        @if (Model.PropertyReviews.Count() > 3)
                        {
                            <a asp-controller="Reviews" asp-action="Index" asp-route-propertyId="@Model.Id" class="mt-4 inline-block text-sm font-semibold text-primary hover:underline">
                                View all @Model.PropertyReviews.Count() reviews
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Similar Properties -->
            @if (Model.Similar.Any())
            {
                <div class="space-y-6 border-t border-border pt-6">
                    <h2 class="text-xl font-semibold">Similar properties</h2>
                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        @foreach (var similar in Model.Similar.Take(3))
                        {
                            <partial name="_PropertyCard" model="similar" />
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Right Column - Booking Sidebar -->
        <div class="lg:sticky lg:top-24 lg:h-fit">
            <div class="rounded-2xl border border-border bg-card p-6 space-y-4">
                <!-- Price -->
                <div>
                    <p class="text-3xl font-bold">$@Model.Price</p>
                    <p class="text-sm text-muted-foreground">per night</p>
                </div>

                <!-- Booking Form -->
                <form asp-controller="Bookings" asp-action="Create" method="post" class="space-y-4" id="bookingForm">
                    <input type="hidden" name="propertySlug" value="@Model.Id" />
                    <input type="hidden" name="pricePerNight" value="@Model.Price" />
                    <div>
                        <label for="checkIn" class="block text-sm font-medium mb-2">Check in</label>
                        <input type="date" name="checkIn" id="checkIn" required 
                               class="w-full rounded-lg border border-border bg-background px-3 py-2" 
                               value="@Model.Booking.CheckIn.ToString("yyyy-MM-dd")" />
                    </div>

                    <div>
                        <label for="checkOut" class="block text-sm font-medium mb-2">Check out</label>
                        <input type="date" name="checkOut" id="checkOut" required 
                               class="w-full rounded-lg border border-border bg-background px-3 py-2"
                               value="@Model.Booking.CheckOut.ToString("yyyy-MM-dd")" />
                    </div>

                    <div>
                        <label for="guests" class="block text-sm font-medium mb-2">Guests</label>
                        <select name="guests" id="guests" required 
                                class="w-full rounded-lg border border-border bg-background px-3 py-2">
                            @for (int i = 1; i <= Model.Guests; i++)
                            {
                               <option value="@i" selected="@(i == Model.Booking.Guests ? "selected" : null)">@i guest@(i != 1 ? "s" : "")</option>
                            }
                        </select>
                    </div>

                    <!-- Price Breakdown -->
                    <div class="space-y-2 border-t border-b border-border py-4">
                        <div class="flex justify-between text-sm">
                            <span>Nights (0)</span>
                            <span>$0</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span>Service fee</span>
                            <span>$0</span>
                        </div>
                        <div class="flex justify-between font-semibold">
                            <span>Total</span>
                            <span>$0</span>
                        </div>
                    </div>

                    <!-- Booking Button -->
                    <button type="submit" class="w-full rounded-lg bg-primary px-4 py-3 font-semibold text-primary-foreground hover:bg-primary/90 disabled:opacity-50 disabled:cursor-not-allowed" id="bookButton">
                        Request booking
                    </button>
                </form>

                <!-- Favorite Button -->
                <button type="button" class="w-full flex items-center justify-center gap-2 rounded-lg border border-border px-4 py-2 hover:bg-secondary"
                        data-property-id="@Model.Id" data-toggle-favorite="true">
                    <svg class="size-5 @(Model.IsFavorite ? "fill-red-500 text-red-500" : "text-muted-foreground")" fill="@(Model.IsFavorite ? "currentColor" : "none")" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                    <span>@(Model.IsFavorite ? "Saved" : "Save")</span>
                </button>

                <!-- Share Button -->
                <button type="button" class="w-full flex items-center justify-center gap-2 rounded-lg border border-border px-4 py-2 hover:bg-secondary" onclick="navigator.share({title: '@Model.Title', url: window.location.href})">
                    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C9.839 10.319 13.159 7.5 17 7.5c-2.342 0-4.523.922-6.136 2.364M4.5 6H3m16.5 0h-1.5M9 20.25a6.375 6.375 0 1 0 0-12.75A6.375 6.375 0 0 0 9 20.25z"></path>
                    </svg>
                    <span>Share</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/property.js" asp-append-version="true"></script>
    <script>
        // Price calculation logic
        document.getElementById('checkIn').addEventListener('change', calculatePrice);
        document.getElementById('checkOut').addEventListener('change', calculatePrice);

        function calculatePrice() {
            const checkIn = new Date(document.getElementById('checkIn').value);
            const checkOut = new Date(document.getElementById('checkOut').value);
            const price = @Model.Price;

            if (checkIn && checkOut && checkOut > checkIn) {
                const nights = Math.ceil((checkOut - checkIn) / (1000 * 60 * 60 * 24));
                const subtotal = nights * price;
                const serviceFee = Math.round(subtotal * 0.09);
                const total = subtotal + serviceFee;

                document.querySelectorAll('[data-nights]')[0]?.textContent = 'Nights (' + nights + ')';
                document.querySelectorAll('[data-subtotal]')[0]?.textContent = '$' + subtotal;
                document.querySelectorAll('[data-fee]')[0]?.textContent = '$' + serviceFee;
                document.querySelectorAll('[data-total]')[0]?.textContent = '$' + total;
            }
        }
    </script>
}
