@model Havenly.BLL.ModelVMs.PropertyDetailsVM
@using System.Security.Claims

@{
    ViewData["Title"] = $"{Model.Title} — Havenly";
    ViewData["Description"] = Model.Description.Length > 155 ? Model.Description.Substring(0, 155) : Model.Description;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isHostOwner = !string.IsNullOrEmpty(currentUserId) &&
                      ((!string.IsNullOrEmpty(Model.OwnerId) && string.Equals(Model.OwnerId, currentUserId, StringComparison.OrdinalIgnoreCase)) ||
                       (!string.IsNullOrEmpty(Model.Host?.HostId) && string.Equals(Model.Host.HostId, currentUserId, StringComparison.OrdinalIgnoreCase)));
}

<div class="container-page py-8 space-y-12">
    <!-- Image Gallery -->
    @if (Model.Images.Any())
    {
        <div class="space-y-3">
            <div class="relative h-96 overflow-hidden rounded-2xl bg-muted">
                <img id="mainImage" src="@Model.Images.First()" alt="@Model.Title" class="h-full w-full object-cover" />
            </div>
            @if (Model.Images.Count() > 1)
            {
                <div class="grid grid-cols-3 gap-3 md:grid-cols-4">
                    @foreach (var image in Model.Images.Take(4))
                    {
                        <button type="button" class="overflow-hidden rounded-lg border-2 border-transparent hover:border-primary"
                                onclick="document.getElementById('mainImage').src = '@image'">
                            <img src="@image" alt="@Model.Title" class="h-24 w-full object-cover" />
                        </button>
                    }
                    @if (Model.Images.Count() > 4)
                    {
                        <button type="button" class="relative overflow-hidden rounded-lg bg-muted"
                                onclick="alert('Show all images')">
                            <img src="@Model.Images[4]" alt="@Model.Title" class="h-24 w-full object-cover opacity-50" />
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span class="text-sm font-semibold">+@(Model.Images.Count() - 4)</span>
                            </div>
                        </button>
                    }
                </div>
            }
        </div>
    }

    <!-- Main Content Grid -->
    <div class="grid gap-8 lg:grid-cols-[1fr_24rem]">
        <!-- Left Column -->
        <div class="space-y-8">
            <!-- Header -->
            <div class="space-y-3 border-b border-border pb-6">
                <h1 class="text-3xl font-bold">@Model.Title</h1>

                <!-- Location & Rating -->
                <div class="flex flex-wrap items-center gap-4">
                    <div class="flex items-center gap-2">
                        <svg class="size-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span class="text-muted-foreground">@Model.City, @Model.Country</span>
                    </div>

                    <div class="flex items-center gap-1">
                        <div class="flex gap-0.5">
                            @for (int i = 0; i < 5; i++)
                            {
                                <svg class="size-4 @(i < (int)Model.Rating ? "fill-yellow-400 text-yellow-400" : "text-muted")" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15l-3.255 1.716A1 1 0 015.882 15.23l.636-3.7a1 1 0 00-.288-1.112L2.696 9.5a1 1 0 00.553-1.697l3.738-.543 1.67-3.372a1 1 0 011.8 0l1.67 3.372 3.738.543a1 1 0 00.553 1.697l-2.704 2.364a1 1 0 00-.288 1.112l.636 3.7a1 1 0 01-1.537 1.055L12 15z"></path>
                                </svg>
                            }
                        </div>
                        <span class="font-medium">@Model.Rating.ToString("F1")</span>
                        <span class="text-muted-foreground">(@Model.Reviews reviews)</span>
                    </div>
                </div>
            </div>

            <!-- Property Details -->
            <div class="grid gap-6 sm:grid-cols-3">
                <div class="space-y-2">
                    <p class="text-sm font-medium text-muted-foreground">Guests</p>
                    <p class="text-2xl font-semibold">@Model.Guests</p>
                </div>
                <div class="space-y-2">
                    <p class="text-sm font-medium text-muted-foreground">Bedrooms</p>
                    <p class="text-2xl font-semibold">@Model.Bedrooms</p>
                </div>
                <div class="space-y-2">
                    <p class="text-sm font-medium text-muted-foreground">Bathrooms</p>
                    <p class="text-2xl font-semibold">@Model.Baths</p>
                </div>
            </div>

            <!-- Description -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="space-y-3 border-b border-border pb-6">
                    <h2 class="text-xl font-semibold">About this place</h2>
                    <p class="text-muted-foreground leading-relaxed">@Model.Description</p>
                </div>
            }

            <!-- Amenities -->
            @if (Model.Amenities.Any())
            {
                <div class="space-y-3 border-b border-border pb-6">
                    <h2 class="text-xl font-semibold">Amenities</h2>
                    <div class="grid gap-3 sm:grid-cols-2">
                        @foreach (var amenity in Model.Amenities)
                        {
                            <div class="flex items-center gap-2">
                                <svg class="size-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"></path>
                                </svg>
                                <span>@amenity</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- House Rules -->
            @if (Model.Rules.Any())
            {
                <div class="space-y-3 border-b border-border pb-6">
                    <h2 class="text-xl font-semibold">House rules</h2>
                    <ul class="space-y-2">
                        @foreach (var rule in Model.Rules)
                        {
                            <li class="flex items-start gap-2 text-sm text-muted-foreground">
                                <svg class="size-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <span>@rule</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- Availability Calendar Section -->
            <div class="space-y-4 border-b border-border pb-8">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <h2 class="text-xl font-bold tracking-tight">Availability Calendar</h2>
                        <p class="text-xs text-muted-foreground mt-0.5">Unavailable dates (already booked or reserved by the host) are crossed out. Click available dates to plan your stay.</p>
                    </div>
                    <div class="flex items-center gap-3 text-xs">
                        <button type="button" id="clearDatesBtn" onclick="clearSelectedDates()" class="text-xs font-semibold text-primary hover:underline">
                            Clear dates
                        </button>
                    </div>
                </div>

                <!-- Calendar Card -->
                <div class="rounded-2xl border border-border bg-card p-4 sm:p-6 shadow-xs">
                    <!-- Navigation & Month Title -->
                    <div class="flex items-center justify-between mb-4">
                        <button type="button" onclick="changeGuestCalendarMonth(-1)" class="inline-flex items-center justify-center size-8 rounded-full border border-border bg-background hover:bg-secondary transition shadow-2xs">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                            </svg>
                        </button>

                        <div class="flex items-center gap-2">
                            <span id="guestCalMonthTitle" class="font-bold text-base text-foreground"></span>
                        </div>

                        <button type="button" onclick="changeGuestCalendarMonth(1)" class="inline-flex items-center justify-center size-8 rounded-full border border-border bg-background hover:bg-secondary transition shadow-2xs">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                        </button>
                    </div>

                    <!-- Days Header -->
                    <div class="grid grid-cols-7 text-center text-xs font-semibold text-muted-foreground mb-2">
                        <div>Su</div>
                        <div>Mo</div>
                        <div>Tu</div>
                        <div>We</div>
                        <div>Th</div>
                        <div>Fr</div>
                        <div>Sa</div>
                    </div>

                    <!-- Days Grid -->
                    <div id="guestCalendarGrid" class="grid grid-cols-7 gap-1 text-center">
                        <!-- Populated by JavaScript -->
                    </div>

                    <!-- Legend -->
                    <div class="flex flex-wrap items-center justify-center gap-5 text-xs text-gray-600 mt-4 pt-4 border-t border-border">
                        <span class="inline-flex items-center gap-1.5"><span class="size-3.5 rounded-full bg-[#0d9488] border border-[#0d9488]"></span> <strong class="text-gray-900">Selected</strong></span>
                        <span class="inline-flex items-center gap-1.5"><span class="size-3.5 rounded-full bg-emerald-100 border border-emerald-300"></span> In Range</span>
                        <span class="inline-flex items-center gap-1.5"><span class="size-3.5 rounded-full bg-white border border-gray-300"></span> Available</span>
                        <span class="inline-flex items-center gap-1.5"><span class="size-3.5 rounded-md bg-rose-50 border border-rose-200 text-[9px] font-bold text-rose-500 flex items-center justify-center">✕</span> <strong class="text-rose-600 font-semibold">Unavailable / Booked</strong></span>
                    </div>
                </div>
            </div>

            <!-- Host Info -->
            <div class="space-y-4 border-b border-border pb-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-xl font-semibold">About the host</h2>
                    @if (!string.IsNullOrEmpty(Model.Host.HostId))
                    {
                        <button type="button" onclick="openProfileModal('@Model.Host.HostId')" class="text-xs font-semibold text-primary hover:underline">
                            View profile & listings →
                        </button>
                    }
                </div>
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 rounded-2xl border border-border bg-secondary/20">
                    <div class="flex items-center gap-4 cursor-pointer" onclick="openProfileModal('@Model.Host.HostId')">
                        <div class="size-16 rounded-full bg-primary/10 text-primary font-bold text-2xl flex items-center justify-center border-2 border-primary/20 flex-shrink-0 overflow-hidden shadow-sm">
                            @if (!string.IsNullOrEmpty(Model.Host.AvatarUrl))
                            {
                                <img src="@Model.Host.AvatarUrl" alt="@Model.Host.Name" class="size-full object-cover" />
                            }
                            else
                            {
                                <span>@(string.IsNullOrWhiteSpace(Model.Host.Name) ? "H" : Model.Host.Name[0].ToString().ToUpper())</span>
                            }
                        </div>
                        <div>
                            <h3 class="font-bold text-base text-foreground hover:text-primary transition flex items-center gap-2">
                                @Model.Host.Name
                                <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary">Host</span>
                            </h3>
                            <p class="text-xs text-muted-foreground mt-0.5">Host since @Model.Host.Since</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Host.HostId))
                    {
                        <button type="button" onclick="openProfileModal('@Model.Host.HostId')" class="rounded-xl border border-border bg-card px-4 py-2 text-xs font-semibold hover:bg-secondary transition">
                            Contact / Profile
                        </button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Host.Bio))
                {
                    <p class="text-sm text-muted-foreground leading-relaxed">
                        @Model.Host.Bio
                    </p>
                }
            </div>

            <!-- Reviews -->
            @if (Model.PropertyReviews.Any())
            {
                <div class="space-y-6">
                    <div>
                        <h2 class="text-xl font-semibold mb-4">Reviews (@Model.PropertyReviews.Count())</h2>
                        <div class="space-y-4">
                            @foreach (var review in Model.PropertyReviews.Take(3))
                            {
                                <div class="border-b border-border pb-4">
                                    <div class="flex items-start justify-between mb-2">
                                        <div>
                                            <p class="font-semibold">@review.Author</p>
                                            <p class="text-sm text-muted-foreground">@review.Date</p>
                                        </div>
                                        <div class="flex gap-0.5">
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                <svg class="size-4 @(i < review.Rating ? "fill-yellow-400 text-yellow-400" : "text-muted")" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15l-3.255 1.716A1 1 0 015.882 15.23l.636-3.7a1 1 0 00-.288-1.112L2.696 9.5a1 1 0 00.553-1.697l3.738-.543 1.67-3.372a1 1 0 011.8 0l1.67 3.372 3.738.543a1 1 0 00.553 1.697l-2.704 2.364a1 1 0 00-.288 1.112l.636 3.7a1 1 0 01-1.537 1.055L12 15z"></path>
                                                </svg>
                                            }
                                        </div>
                                    </div>
                                    <p class="text-sm text-foreground/90 leading-relaxed">@review.Body</p>

                                    @if (!string.IsNullOrEmpty(review.HostResponse))
                                    {
                                        <div class="mt-3 rounded-2xl bg-muted/40 border border-border/80 p-4 space-y-1.5">
                                            <div class="flex items-center gap-2 text-xs font-semibold text-foreground">
                                                <div class="size-5 rounded-full bg-primary/10 text-primary flex items-center justify-center text-[10px]">
                                                    👑
                                                </div>
                                                <span>Response from @(Model.Host?.Name ?? "Host")</span>
                                            </div>
                                            <p class="text-xs text-muted-foreground italic leading-relaxed pl-7">
                                                "@review.HostResponse"
                                            </p>
                                        </div>
                                    }
                                    else if (isHostOwner)
                                    {
                                        <div class="mt-2 flex justify-end">
                                            <a asp-controller="Reviews" asp-action="Respond" asp-route-reviewId="@review.Id"
                                               class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1 text-xs font-medium text-primary hover:bg-secondary transition">
                                                <span>💬 Reply to this review</span>
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (Model.PropertyReviews.Count() > 3)
                        {
                            <a asp-controller="Reviews" asp-action="Index" asp-route-propertyId="@Model.Id" class="mt-4 inline-block text-sm font-semibold text-primary hover:underline">
                                View all @Model.PropertyReviews.Count() reviews
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Similar Properties -->
            @if (Model.Similar.Any())
            {
                <div class="space-y-6 border-t border-border pt-6">
                    <h2 class="text-xl font-semibold">Similar properties</h2>
                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        @foreach (var similar in Model.Similar.Take(3))
                        {
                            <partial name="_PropertyCard" model="similar" />
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Right Column - Booking Sidebar -->
        <div class="lg:sticky lg:top-24 lg:h-fit">
            <div class="rounded-2xl border border-border bg-card p-6 space-y-4">
                <!-- Price -->
                <div>
                    <p class="text-3xl font-bold">@Model.Price EGP</p>
                    <p class="text-sm text-muted-foreground">per night</p>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="rounded-2xl border border-purple-500/30 bg-purple-500/5 p-5 space-y-4">
                        <div class="flex items-center gap-2 text-purple-700 font-semibold text-xs uppercase tracking-wider">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                            <span>Administrative Inspection Mode</span>
                        </div>
                        <div class="space-y-2 text-xs text-muted-foreground">
                            <div class="flex justify-between">
                                <span>Listing ID:</span>
                                <span class="font-mono font-bold text-foreground">#@Model.ListingID</span>
                            </div>
                            <div class="flex justify-between">
                                <span>Property ID:</span>
                                <span class="font-mono font-bold text-foreground">#@Model.Id</span>
                            </div>
                            <div class="flex justify-between">
                                <span>Nightly Rate:</span>
                                <span class="font-bold text-foreground">@Model.Price EGP</span>
                            </div>
                            <div class="flex justify-between">
                                <span>Host:</span>
                                <span class="font-semibold text-foreground">@(Model.Host?.Name ?? "Host")</span>
                            </div>
                        </div>

                        <div class="rounded-xl bg-muted/60 p-3 text-xs text-muted-foreground leading-relaxed">
                            🛡️ <strong>Admin Notice:</strong> Administrators review property listings in audit mode. Admin accounts cannot create reservations.
                        </div>

                        <div class="pt-2 space-y-2">
                            <a asp-controller="Admin" asp-action="Listings" class="w-full inline-flex items-center justify-center rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition">
                                Manage in Admin Listings
                            </a>
                            <a asp-controller="Admin" asp-action="Bookings" class="w-full inline-flex items-center justify-center rounded-xl border border-border bg-background px-4 py-2.5 text-xs font-semibold hover:bg-secondary transition">
                                View System Bookings
                            </a>
                        </div>
                    </div>
                }
                else if (isHostOwner)
                {
                    <div class="space-y-4 rounded-2xl border border-primary/20 bg-primary/5 p-5">
                        <div class="flex items-center gap-2 text-sm font-bold text-primary">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                            </svg>
                            <span>Your Property (Host Owner Mode)</span>
                        </div>
                        <div class="space-y-2 text-xs text-muted-foreground">
                            <div class="flex justify-between items-center">
                                <span>Listing Status:</span>
                                @if (Model.IsValid)
                                {
                                    <span class="inline-flex items-center gap-1 font-bold text-emerald-700 bg-emerald-500/10 px-2 py-0.5 rounded-full">
                                        <span class="size-1.5 rounded-full bg-emerald-500"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 font-bold text-amber-700 bg-amber-500/10 px-2 py-0.5 rounded-full">
                                        ⏸️ Suspended
                                    </span>
                                }
                            </div>
                            <div class="flex justify-between">
                                <span>Nightly Rate:</span>
                                <span class="font-bold text-foreground">@Model.Price.ToString("N0") EGP</span>
                            </div>
                            <div class="flex justify-between">
                                <span>Guest Reviews:</span>
                                <span class="font-semibold text-foreground">@Model.Reviews</span>
                            </div>
                        </div>

                        <div class="pt-2 space-y-2">
                            <a asp-controller="Host" asp-action="EditProperty" asp-route-id="@Model.Id" class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition">
                                <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                </svg>
                                Edit Listing Details
                            </a>
                            <a asp-controller="Host" asp-action="ListProperties" class="w-full inline-flex items-center justify-center rounded-xl border border-border bg-background px-4 py-2.5 text-xs font-semibold hover:bg-secondary transition">
                                Manage Price & Status
                            </a>
                            <a asp-controller="Host" asp-action="Bookings" class="w-full inline-flex items-center justify-center rounded-xl border border-border bg-background px-4 py-2 text-xs font-medium text-muted-foreground hover:bg-secondary hover:text-foreground transition">
                                View Reservations
                            </a>
                        </div>
                    </div>
                }
                else if (!Model.IsValid)
                {
                    <div class="rounded-2xl border border-amber-500/30 bg-amber-500/10 p-6 text-center space-y-3">
                        <div class="inline-flex size-12 items-center justify-center rounded-full bg-amber-500/20 text-amber-600 text-xl">⏸️</div>
                        <h4 class="font-bold text-foreground text-base">Listing Temporarily Paused</h4>
                        <p class="text-xs text-muted-foreground leading-relaxed">
                            This listing is currently suspended by the host and is not accepting new booking requests at this time.
                        </p>
                        <a asp-controller="Property" asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:underline pt-2">
                            Explore other available stays →
                        </a>
                    </div>
                }
                else
                {
                    <!-- Booking Form -->
                    <form asp-controller="Booking" asp-action="Create" method="post" class="space-y-4" id="bookingForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ListingID" value="@Model.ListingID" />
                        <input type="hidden" name="PricePerNight" value="@Model.Price" />

                        <div>
                            <label for="checkIn" class="block text-sm font-medium mb-2">Check in</label>
                            <input type="date"
                                   name="CheckIn"
                                   id="checkIn"
                                   required
                                   class="w-full rounded-lg border border-border bg-background px-3 py-2"
                                   value="@(Model.Booking.CheckIn.ToString("yyyy-MM-dd") == "0001-01-01" ? DateTime.Today.ToString("yyyy-MM-dd") : Model.Booking.CheckIn.ToString("yyyy-MM-dd"))"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <div>
                            <label for="checkOut" class="block text-sm font-medium mb-2">Check out</label>
                            <input type="date"
                                   name="CheckOut"
                                   id="checkOut"
                                   required
                                   class="w-full rounded-lg border border-border bg-background px-3 py-2"
                                   value="@Model.Booking.CheckOut.ToString("yyyy-MM-dd")"
                                   min="@Model.Booking.CheckIn.ToString("yyyy-MM-dd")" />
                        </div>

                        <div>
                            <label for="guests" class="block text-sm font-medium mb-2">Guests</label>
                            <select name="Guests" id="guests" required class="w-full rounded-lg border border-border bg-background px-3 py-2">
                                @for (int i = 1; i <= Model.Guests; i++)
                                {
                                    <option value="@i" selected="@(i == Model.Booking.Guests ? "selected" : null)">
                                        @i guest@(i != 1 ? "s" : "")
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Status / Notice Banner -->
                        <div id="noticeBanner" class="rounded-lg border border-border bg-secondary p-3 text-sm font-medium text-muted-foreground">
                            Select dates to check availability.
                        </div>

                        <!-- Price Breakdown -->
                        <div id="priceBreakdown" class="space-y-2 border-t border-b border-border py-4">
                            <div class="flex justify-between text-sm">
                                <span id="nightsLabel">Nights (0)</span>
                                <span id="subtotalVal">0 EGP</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span>Service fee (9%)</span>
                                <span id="serviceFeeVal">0 EGP</span>
                            </div>
                            <div class="flex justify-between font-semibold text-foreground text-base pt-1">
                                <span>Total</span>
                                <span id="totalVal">0 EGP</span>
                            </div>
                        </div>

                        <!-- Booking Button -->
                        <button type="submit"
                                id="bookButton"
                                class="w-full rounded-lg bg-primary px-4 py-3 font-semibold text-primary-foreground hover:bg-primary/90 disabled:opacity-50 disabled:cursor-not-allowed">
                            Request booking
                        </button>
                    </form>
                }

                <!-- Favorite Button Form -->
                <form asp-controller="Favorites" asp-action="Toggle" method="post" class="w-full">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="listingId" value="@Model.ListingID" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="w-full flex items-center justify-center gap-2 rounded-lg border border-border px-4 py-2.5 hover:bg-secondary transition font-medium text-sm">
                        <svg class="size-5 @(Model.IsFavorite ? "fill-red-500 text-red-500" : "text-muted-foreground")" fill="@(Model.IsFavorite ? "currentColor" : "none")" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                        <span>@(Model.IsFavorite ? "Saved to Favorites" : "Save to Favorites")</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            const checkInInput = document.getElementById('checkIn');
            const checkOutInput = document.getElementById('checkOut');
            const noticeBanner = document.getElementById('noticeBanner');
            const bookButton = document.getElementById('bookButton');

            const nightsLabel = document.getElementById('nightsLabel');
            const subtotalVal = document.getElementById('subtotalVal');
            const serviceFeeVal = document.getElementById('serviceFeeVal');
            const totalVal = document.getElementById('totalVal');

            const guestCalMonthTitle = document.getElementById('guestCalMonthTitle');
            const guestCalendarGrid = document.getElementById('guestCalendarGrid');

            // Force invariant dot-decimal parsing in JS
            const pricePerNight = parseFloat("@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)") || 0;
            const bookedDates = @Html.Raw(Json.Serialize(Model.BookedDates ?? new List<string>()));

            const today = new Date();
            today.setHours(0, 0, 0, 0);

            let currentViewYear = today.getFullYear();
            let currentViewMonth = today.getMonth(); // 0-indexed

            function parseLocalDate(dateStr) {
                if (!dateStr) return null;
                const parts = dateStr.split('-');
                if (parts.length !== 3) return null;
                return new Date(parts[0], parts[1] - 1, parts[2]);
            }

            function formatDate(year, month, day) {
                const y = year;
                const m = String(month + 1).padStart(2, '0');
                const d = String(day).padStart(2, '0');
                return `${y}-${m}-${d}`;
            }

            function updateCalculator() {
                if (!checkInInput || !checkOutInput || !bookButton) return;

                const checkInVal = checkInInput.value;
                const checkOutVal = checkOutInput.value;

                if (!checkInVal || !checkOutVal) {
                    noticeBanner.className = "rounded-lg border border-border bg-secondary p-3 text-sm font-medium text-muted-foreground";
                    noticeBanner.textContent = "Select dates on the calendar to check availability.";
                    resetBreakdown();
                    bookButton.disabled = true;
                    return;
                }

                const checkIn = parseLocalDate(checkInVal);
                const checkOut = parseLocalDate(checkOutVal);

                if (!checkIn || !checkOut) {
                    resetBreakdown();
                    bookButton.disabled = true;
                    return;
                }

                const diffTime = checkOut.getTime() - checkIn.getTime();
                const nights = Math.round(diffTime / (1000 * 3600 * 24));

                if (nights <= 0) {
                    noticeBanner.className = "rounded-lg border border-destructive/35 bg-destructive/10 p-3 text-sm font-medium text-destructive";
                    noticeBanner.textContent = "Check-out must be at least one night after check-in.";
                    resetBreakdown();
                    bookButton.disabled = true;
                    return;
                }

                // Check for overlap with disabled/booked dates
                let hasConflict = false;
                for (let i = 0; i < nights; i++) {
                    const d = new Date(checkIn.getFullYear(), checkIn.getMonth(), checkIn.getDate() + i);
                    const curDate = formatDate(d.getFullYear(), d.getMonth(), d.getDate());

                    if (bookedDates.includes(curDate)) {
                        hasConflict = true;
                        break;
                    }
                }

                if (hasConflict) {
                    noticeBanner.className = "rounded-lg border border-destructive/35 bg-destructive/10 p-3 text-sm font-medium text-destructive";
                    noticeBanner.textContent = "Selected range overlaps with unavailable dates.";
                    resetBreakdown();
                    bookButton.disabled = true;
                } else {
                    noticeBanner.className = "rounded-lg border border-success/35 bg-success/10 p-3 text-sm font-medium text-success";
                    noticeBanner.textContent = `${nights} ${nights === 1 ? 'night' : 'nights'} available for your stay.`;

                    const subtotal = nights * pricePerNight;
                    const serviceFee = Math.round(subtotal * 0.09);
                    const total = subtotal + serviceFee;

                    nightsLabel.textContent = `Nights (${nights}) — ${pricePerNight.toLocaleString()} EGP/night`;
                    subtotalVal.textContent = `${subtotal.toLocaleString()} EGP`;
                    serviceFeeVal.textContent = `${serviceFee.toLocaleString()} EGP`;
                    totalVal.textContent = `${total.toLocaleString()} EGP`;

                    bookButton.disabled = false;
                }
            }

            function resetBreakdown() {
                if (nightsLabel) nightsLabel.textContent = "Nights (0)";
                if (subtotalVal) subtotalVal.textContent = "0 EGP";
                if (serviceFeeVal) serviceFeeVal.textContent = "0 EGP";
                if (totalVal) totalVal.textContent = "0 EGP";
            }

            // Guest Availability Calendar Functions
            function renderGuestCalendar() {
                if (!guestCalendarGrid || !guestCalMonthTitle) return;

                const firstDay = new Date(currentViewYear, currentViewMonth, 1);
                const daysInMonth = new Date(currentViewYear, currentViewMonth + 1, 0).getDate();
                const startOffset = firstDay.getDay(); // 0 = Sunday

                const monthName = firstDay.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
                guestCalMonthTitle.textContent = monthName;

                let html = '';

                // Previous month padding cells
                for (let i = 0; i < startOffset; i++) {
                    html += `<div class="h-10 sm:h-11"></div>`;
                }

                const cinVal = checkInInput ? checkInInput.value : '';
                const coutVal = checkOutInput ? checkOutInput.value : '';

                for (let day = 1; day <= daysInMonth; day++) {
                    const dateStr = formatDate(currentViewYear, currentViewMonth, day);
                    const curDate = new Date(currentViewYear, currentViewMonth, day);
                    curDate.setHours(0, 0, 0, 0);

                    const isPast = curDate < today;
                    const isBooked = bookedDates.includes(dateStr);
                    const isCheckIn = (dateStr === cinVal);
                    const isCheckOut = (dateStr === coutVal);
                    const isInRange = (cinVal && coutVal && dateStr > cinVal && dateStr < coutVal);

                    if (isPast) {
                        html += `
                            <div class="h-10 sm:h-11 flex items-center justify-center text-xs text-gray-300 font-medium cursor-not-allowed rounded-xl" title="Past date">
                                ${day}
                            </div>`;
                    } else if (isBooked) {
                        html += `
                            <div class="h-10 sm:h-11 flex flex-col items-center justify-center text-xs font-bold text-rose-500 bg-rose-50 border border-rose-200/90 rounded-xl cursor-not-allowed select-none shadow-2xs" title="Unavailable (Reserved or Host Blocked)">
                                <span class="line-through decoration-rose-400 decoration-2">${day}</span>
                                <span class="text-[8px] uppercase tracking-tighter text-rose-500 font-bold -mt-0.5">Booked</span>
                            </div>`;
                    } else if (isCheckIn) {
                        html += `
                            <button type="button" onclick="selectGuestDate('${dateStr}')" class="h-10 sm:h-11 w-full flex items-center justify-center text-xs font-bold bg-[#0d9488] text-white rounded-l-xl shadow-xs transition hover:opacity-90" title="Check-in: ${dateStr}">
                                ${day}
                            </button>`;
                    } else if (isCheckOut) {
                        html += `
                            <button type="button" onclick="selectGuestDate('${dateStr}')" class="h-10 sm:h-11 w-full flex items-center justify-center text-xs font-bold bg-[#0d9488] text-white rounded-r-xl shadow-xs transition hover:opacity-90" title="Check-out: ${dateStr}">
                                ${day}
                            </button>`;
                    } else if (isInRange) {
                        html += `
                            <button type="button" onclick="selectGuestDate('${dateStr}')" class="h-10 sm:h-11 w-full flex items-center justify-center text-xs font-bold bg-emerald-100/80 text-emerald-800 transition hover:bg-emerald-200/70" title="Selected stay">
                                ${day}
                            </button>`;
                    } else {
                        html += `
                            <button type="button" onclick="selectGuestDate('${dateStr}')" class="h-10 sm:h-11 w-full flex items-center justify-center text-xs font-bold text-gray-800 bg-white hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-300 rounded-xl border border-gray-200/80 transition shadow-2xs">
                                ${day}
                            </button>`;
                    }
                }

                guestCalendarGrid.innerHTML = html;
            }

            window.changeGuestCalendarMonth = function(delta) {
                currentViewMonth += delta;
                if (currentViewMonth < 0) {
                    currentViewMonth = 11;
                    currentViewYear--;
                } else if (currentViewMonth > 11) {
                    currentViewMonth = 0;
                    currentViewYear++;
                }

                // Disallow viewing months before current month
                const minView = new Date(today.getFullYear(), today.getMonth(), 1);
                const curView = new Date(currentViewYear, currentViewMonth, 1);
                if (curView < minView) {
                    currentViewYear = today.getFullYear();
                    currentViewMonth = today.getMonth();
                }

                renderGuestCalendar();
            };

            window.selectGuestDate = function(dateStr) {
                if (!checkInInput || !checkOutInput) return;

                const cin = checkInInput.value;
                const cout = checkOutInput.value;

                // Step 1: Nothing selected yet OR both already selected -> set as new check-in
                if (!cin || (cin && cout)) {
                    checkInInput.value = dateStr;
                    checkOutInput.value = '';
                    checkOutInput.min = dateStr;
                } else {
                    // Step 2: Check-in is set, setting check-out
                    if (dateStr <= cin) {
                        // Clicked date is earlier than or equal to check-in -> reset check-in
                        checkInInput.value = dateStr;
                        checkOutInput.value = '';
                        checkOutInput.min = dateStr;
                    } else {
                        // Check if any date between cin and dateStr is booked
                        const cinDate = parseLocalDate(cin);
                        const coutDate = parseLocalDate(dateStr);
                        const diffDays = Math.round((coutDate - cinDate) / (1000 * 3600 * 24));

                        let conflict = false;
                        for (let i = 0; i < diffDays; i++) {
                            const d = new Date(cinDate.getFullYear(), cinDate.getMonth(), cinDate.getDate() + i);
                            const str = formatDate(d.getFullYear(), d.getMonth(), d.getDate());
                            if (bookedDates.includes(str)) {
                                conflict = true;
                                break;
                            }
                        }

                        if (conflict) {
                            alert("There is an unavailable (booked or host-blocked) date within this range. Please pick an uninterrupted range.");
                            checkInInput.value = dateStr;
                            checkOutInput.value = '';
                            checkOutInput.min = dateStr;
                        } else {
                            checkOutInput.value = dateStr;
                        }
                    }
                }

                updateCalculator();
                renderGuestCalendar();
            };

            window.clearSelectedDates = function() {
                if (checkInInput) checkInInput.value = '';
                if (checkOutInput) checkOutInput.value = '';
                updateCalculator();
                renderGuestCalendar();
            };

            if (checkInInput) {
                checkInInput.addEventListener('change', function() {
                    if (checkOutInput) checkOutInput.min = checkInInput.value;
                    updateCalculator();
                    renderGuestCalendar();
                });
            }

            if (checkOutInput) {
                checkOutInput.addEventListener('change', function() {
                    updateCalculator();
                    renderGuestCalendar();
                });
            }

            // Initial render
            updateCalculator();
            renderGuestCalendar();
        })();
    </script>
}
