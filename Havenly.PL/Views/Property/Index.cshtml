@model IEnumerable<Havenly.BLL.ModelVMs.PropertyCardVM>

@{
    ViewData["Title"] = "Explore Stays — Havenly";
    ViewData["Description"] = "Filter Havenly stays by city, price, guests, rooms, rating and amenities to find the right home for your dates.";

    var city = Context.Request.Query["city"].ToString();
    var checkIn = Context.Request.Query["checkIn"].ToString();
    var checkOut = Context.Request.Query["checkOut"].ToString();
    var guests = Context.Request.Query["guests"].ToString();
    var category = Context.Request.Query["category"].ToString();

    var maxPriceStr = Context.Request.Query["maxPrice"].ToString();
    int maxPrice = int.TryParse(maxPriceStr, out int parsedPrice) ? parsedPrice : 1000;

    var minRooms = Context.Request.Query["minRooms"].ToString();
    minRooms = string.IsNullOrEmpty(minRooms) ? "any" : minRooms;

    var minRatingStr = Context.Request.Query["minRating"].ToString();
    double minRating = double.TryParse(minRatingStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double parsedRating) ? parsedRating : 3.0;

    var sort = Context.Request.Query["sort"].ToString();
    sort = string.IsNullOrEmpty(sort) ? "recommended" : sort;

    var selectedAmenities = Context.Request.Query["amenities"].ToList();

    var amenityList = new[] {
        "Wi-Fi", "Parking", "Kitchen", "Air conditioning",
        "Pool", "Hot tub", "Patio or balcony", "Dedicated workspace"
    };

    var categoriesList = new[] {
        "City lofts", "Countryside", "Beachfront", "Cabins", "Islands", "Design homes"
    };

    int resultCount = Model?.Count() ?? 0;
}

<div class="container-page pt-6">
    <!-- Compact Top Search Bar Component -->
    <form asp-controller="Property" asp-action="Index" method="get" class="rounded-2xl border border-border bg-card p-2.5 shadow-sm">
        <input type="hidden" name="category" value="@category" />
        <input type="hidden" name="maxPrice" value="@maxPrice" />
        <input type="hidden" name="minRooms" value="@minRooms" />
        <input type="hidden" name="minRating" value="@minRating.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" />
        <input type="hidden" name="sort" value="@sort" />
        @foreach (var am in selectedAmenities)
        {
            <input type="hidden" name="amenities" value="@am" />
        }

        <div class="grid gap-2.5 md:grid-cols-[1.4fr_1fr_1fr_auto_auto] md:items-end">
            <div class="rounded-xl px-3 py-2 transition-colors hover:bg-secondary">
                <label for="dest" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground block">Destination</label>
                <input id="dest" name="city" type="text" value="@city" placeholder="Where to? e.g. Paros, Copenhagen"
                       class="h-11 border-0 bg-transparent px-0 text-sm w-full outline-none focus:ring-0" />
            </div>

            <div class="rounded-xl px-3 py-2 transition-colors hover:bg-secondary">
                <label for="in" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground block">Check-in</label>
                <input id="in" name="checkIn" type="date" value="@checkIn"
                       class="h-11 border-0 bg-transparent px-0 text-sm w-full outline-none focus:ring-0" />
            </div>

            <div class="rounded-xl px-3 py-2 transition-colors hover:bg-secondary">
                <label for="out" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground block">Check-out</label>
                <input id="out" name="checkOut" type="date" value="@checkOut"
                       class="h-11 border-0 bg-transparent px-0 text-sm w-full outline-none focus:ring-0" />
            </div>

            <div class="rounded-xl px-3 py-2 transition-colors hover:bg-secondary md:min-w-32">
                <label for="gs" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground block">Guests</label>
                <select id="gs" name="guests" class="h-11 border-0 bg-transparent px-0 text-sm w-full outline-none focus:ring-0">
                    @foreach (var n in new[] { 1, 2, 4, 6, 8 })
                    {
                        <option value="@n" selected="@(guests == n.ToString())">
                            @n+ guests
                        </option>
                    }
                </select>
            </div>

            <button type="submit" class="h-14 gap-2 rounded-xl px-6 bg-primary text-primary-foreground font-semibold flex items-center justify-center hover:bg-primary/90 transition shadow-sm">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <span>Search</span>
            </button>
        </div>
    </form>
</div>

<div class="container-page mt-8 grid gap-8 lg:grid-cols-[18rem_1fr]">
    <!-- Left Sidebar Desktop Filter Panel -->
    <aside class="hidden lg:block">
        <div id="filterSidebarCard" class="sticky top-24 max-h-[calc(100vh-17rem)] overflow-y-auto rounded-2xl border border-border bg-card p-5 shadow-sm [scrollbar-width:thin] overscroll-contain">
            <form id="filterForm" asp-controller="Property" asp-action="Index" method="get" class="space-y-5 pb-3">
                <!-- Keep existing top search context -->
                <input type="hidden" name="city" value="@city" />
                <input type="hidden" name="checkIn" value="@checkIn" />
                <input type="hidden" name="checkOut" value="@checkOut" />
                <input type="hidden" name="sort" value="@sort" />

                <!-- Filter Panel Header -->
                <div class="flex items-center justify-between pb-3 border-b border-border">
                    <h2 class="font-sans text-sm font-bold uppercase tracking-wider text-foreground">Filters</h2>
                    <a asp-controller="Property" asp-action="Index" class="h-8 rounded-lg px-3 text-xs font-semibold text-primary hover:bg-secondary transition inline-flex items-center justify-center">
                        Reset all
                    </a>
                </div>

                <!-- Category -->
                <div class="space-y-2">
                    <label for="f-category" class="text-xs font-semibold uppercase tracking-wider text-muted-foreground block">Category</label>
                    <select id="f-category" name="category" onchange="this.form.submit()" class="h-11 w-full rounded-xl border border-border bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="">All categories</option>
                        @foreach (var cat in categoriesList)
                        {
                            <option value="@cat" selected="@(category == cat)">@cat</option>
                        }
                    </select>
                </div>

                <!-- Max Price Slider -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <label for="f-price" class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Max price per night</label>
                        <span id="priceDisplay" class="text-sm font-bold text-foreground">@maxPrice EGP</span>
                    </div>
                    <input type="range" id="f-price" name="maxPrice" min="20" max="15000" step="50" value="@maxPrice"
                           oninput="document.getElementById('priceDisplay').textContent = this.value + ' EGP'"
                           onchange="this.form.submit()"
                           class="w-full accent-primary cursor-pointer" />
                    <div class="flex justify-between text-xs text-muted-foreground">
                        <span>20 EGP</span>
                        <span>15,000+ EGP</span>
                    </div>
                </div>

                <!-- Guests Filter -->
                <div class="space-y-2">
                    <label for="f-guests" class="text-xs font-semibold uppercase tracking-wider text-muted-foreground block">Guests</label>
                    <select id="f-guests" name="guests" onchange="this.form.submit()" class="h-11 w-full rounded-xl border border-border bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="">Any number</option>
                        @foreach (var n in new[] { 1, 2, 4, 6, 8 })
                        {
                            <option value="@n" selected="@(guests == n.ToString())">@n+ guests</option>
                        }
                    </select>
                </div>

                <!-- Bedrooms -->
                <div class="space-y-2">
                    <label for="f-rooms" class="text-xs font-semibold uppercase tracking-wider text-muted-foreground block">Bedrooms</label>
                    <select id="f-rooms" name="minRooms" onchange="this.form.submit()" class="h-11 w-full rounded-xl border border-border bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="any" selected="@(minRooms == "any")">Any bedrooms</option>
                        @foreach (var n in new[] { 1, 2, 3, 4 })
                        {
                            <option value="@n" selected="@(minRooms == n.ToString())">@n+ bedrooms</option>
                        }
                    </select>
                </div>

                <!-- Guest Rating Slider (3.0 to 5.0 in 0.1 increments) -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <label for="f-rating" class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Min Guest Rating</label>
                        <span id="ratingDisplay" class="text-sm font-bold text-foreground">
                            @(minRating <= 3.0 ? "Any rating" : $"★ {minRating.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}+")
                        </span>
                    </div>
                    <input type="range" id="f-rating" name="minRating" min="3.0" max="5.0" step="0.1"
                           value="@minRating.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                           oninput="document.getElementById('ratingDisplay').textContent = (parseFloat(this.value) <= 3.0 ? 'Any rating' : '★ ' + parseFloat(this.value).toFixed(1) + '+')"
                           onchange="this.form.submit()"
                           class="w-full accent-primary cursor-pointer" />
                    <div class="flex justify-between text-xs text-muted-foreground">
                        <span>3.0</span>
                        <span>4.0</span>
                        <span>5.0</span>
                    </div>
                </div>

                <!-- Amenities Checklist -->
                <fieldset class="space-y-3">
                    <div class="flex items-center justify-between">
                        <legend class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Amenities</legend>
                        @if (selectedAmenities.Any())
                        {
                            <span class="text-xs font-bold text-primary">@selectedAmenities.Count selected</span>
                        }
                    </div>
                    <div class="grid grid-cols-1 gap-2.5">
                        @foreach (var a in amenityList)
                        {
                            var elementId = $"am-{a.Replace(" ", "-").ToLower()}";
                            var isChecked = selectedAmenities.Contains(a, StringComparer.OrdinalIgnoreCase);
                            <div class="flex items-center gap-3">
                                <input type="checkbox" id="@elementId" name="amenities" value="@a"
                                       checked="@isChecked"
                                       onchange="this.form.submit()"
                                       class="size-4 rounded border-border text-primary focus:ring-primary cursor-pointer" />
                                <label for="@elementId" class="text-sm font-medium text-foreground cursor-pointer select-none">
                                    @a
                                </label>
                            </div>
                        }
                    </div>
                </fieldset>
            </form>
        </div>
    </aside>

    <!-- Main Results Column -->
    <div>
        <!-- Results Header Bar -->
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">
                    @(string.IsNullOrEmpty(city) ? "All Stays" : $"Stays in {city}")
                </h1>
                <p class="text-sm text-muted-foreground mt-1">
                    @resultCount @(resultCount == 1 ? "stay" : "stays") available
                </p>
            </div>

            <div class="flex items-center gap-2">
                <!-- Sorting Select -->
                <form asp-controller="Property" asp-action="Index" method="get" class="flex items-center gap-2">
                    <input type="hidden" name="city" value="@city" />
                    <input type="hidden" name="checkIn" value="@checkIn" />
                    <input type="hidden" name="checkOut" value="@checkOut" />
                    <input type="hidden" name="guests" value="@guests" />
                    <input type="hidden" name="category" value="@category" />
                    <input type="hidden" name="maxPrice" value="@maxPrice" />
                    <input type="hidden" name="minRooms" value="@minRooms" />
                    <input type="hidden" name="minRating" value="@minRating.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" />
                    @foreach (var am in selectedAmenities)
                    {
                        <input type="hidden" name="amenities" value="@am" />
                    }

                    <label class="text-xs font-semibold text-muted-foreground">Sort:</label>
                    <select name="sort" onchange="this.form.submit()" aria-label="Sort results" class="h-10 rounded-xl border border-border bg-card px-3 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="recommended" selected="@(sort == "recommended")">Recommended</option>
                        <option value="price-asc" selected="@(sort == "price-asc")">Price: low to high</option>
                        <option value="price-desc" selected="@(sort == "price-desc")">Price: high to low</option>
                        <option value="rating" selected="@(sort == "rating")">Highest rated</option>
                    </select>
                </form>
            </div>
        </div>

        <!-- Property Grid / Empty State -->
        @if (Model != null && Model.Any())
        {
            <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
                @foreach (var property in Model)
                {
                    <partial name="_PropertyCard" model="property" />
                }
            </div>
        }
        else
        {
            <!-- Empty State Component -->
            <div class="flex flex-col items-center rounded-3xl border border-dashed border-border bg-card px-6 py-20 text-center">
                <div class="size-16 rounded-full bg-secondary flex items-center justify-center text-muted-foreground mb-4">
                    <svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-foreground">No stays match your criteria</h3>
                <p class="mt-2 max-w-sm text-sm text-muted-foreground">
                    Try adjusting your price slider, lowering the minimum rating slider, or clearing some amenities.
                </p>
                <div class="mt-6">
                    <a asp-controller="Property" asp-action="Index" class="inline-flex h-11 items-center justify-center rounded-xl bg-primary px-6 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition shadow-sm">
                        Clear all filters
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function adjustFilterSidebarHeight() {
                var card = document.getElementById('filterSidebarCard');
                if (!card) return;
                var rect = card.getBoundingClientRect();
                // Dynamically fit the card from its current top position down to 24px above viewport bottom
                var availableHeight = Math.max(300, window.innerHeight - rect.top - 24);
                card.style.maxHeight = availableHeight + 'px';
            }

            window.addEventListener('scroll', adjustFilterSidebarHeight, { passive: true });
            window.addEventListener('resize', adjustFilterSidebarHeight, { passive: true });
            document.addEventListener('DOMContentLoaded', adjustFilterSidebarHeight);
            adjustFilterSidebarHeight();
        })();
    </script>
}
