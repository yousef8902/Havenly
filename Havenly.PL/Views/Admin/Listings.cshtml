@{
}
@model Havenly.BLL.ModelVMs.AdminListingsVM
@using Havenly.DAL.Enums

@{
    ViewData["Title"] = "Listings — Havenly Admin";
    ViewData["Description"] = "Manage all property listings on the platform.";
    Layout = "~/Views/Shared/_WorkspaceLayout.cshtml";
    ViewData["WorkspaceNav"] = "admin";
    ViewData["Workspace"] = "Admin console";
    ViewData["WorkspaceRole"] = "Omar Khalil · Administrator";
}

<!-- Page Heading -->
<div class="space-y-1 mb-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight">Listings</h1>
            <p class="text-muted-foreground">Manage all property listings on the platform.</p>
        </div>
        <div class="flex gap-2">
            <a asp-controller="Admin" asp-action="Dashboard" class="inline-flex items-center gap-2 rounded-lg border border-border bg-background px-4 py-2 text-sm font-medium hover:bg-secondary transition">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Back to Dashboard
            </a>
        </div>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-medium text-emerald-700">
        @TempData["Message"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700">
        @TempData["Error"]
    </div>
}

<!-- Stats Cards -->
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6">
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
        <p class="text-sm text-muted-foreground">Total Listings</p>
        <p class="text-2xl font-bold">@Model.Stats.Total.ToString("N0")</p>
    </div>
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
        <p class="text-sm text-muted-foreground">Approved</p>
        <p class="text-2xl font-bold text-emerald-600">@Model.Stats.Approved.ToString("N0")</p>
    </div>
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
        <p class="text-sm text-muted-foreground">Pending</p>
        <p class="text-2xl font-bold text-yellow-600">@Model.Stats.Pending.ToString("N0")</p>
    </div>
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
        <p class="text-sm text-muted-foreground">Declined</p>
        <p class="text-2xl font-bold text-red-600">@Model.Stats.Declined.ToString("N0")</p>
    </div>
</div>

<!-- Filters -->
<div class="mb-6 flex flex-wrap items-center gap-4">
    <div class="flex flex-wrap gap-2">
        <!-- Status Filter -->
        <a href="@Url.Action("Listings", new { status = "all", search = Model.Filters.SearchTerm, sort = Model.Filters.SortBy, page = 1 })"
           class="px-3 py-1.5 text-sm rounded-lg border @(Model.Filters.Status == "all" ? "bg-primary text-white border-primary" : "border-border hover:bg-secondary")">
            All
        </a>
        <a href="@Url.Action("Listings", new { status = "pending", search = Model.Filters.SearchTerm, sort = Model.Filters.SortBy, page = 1 })"
           class="px-3 py-1.5 text-sm rounded-lg border @(Model.Filters.Status == "pending" ? "bg-primary text-white border-primary" : "border-border hover:bg-secondary")">
            Pending
        </a>
        <a href="@Url.Action("Listings", new { status = "approved", search = Model.Filters.SearchTerm, sort = Model.Filters.SortBy, page = 1 })"
           class="px-3 py-1.5 text-sm rounded-lg border @(Model.Filters.Status == "approved" ? "bg-primary text-white border-primary" : "border-border hover:bg-secondary")">
            Approved
        </a>
        <a href="@Url.Action("Listings", new { status = "declined", search = Model.Filters.SearchTerm, sort = Model.Filters.SortBy, page = 1 })"
           class="px-3 py-1.5 text-sm rounded-lg border @(Model.Filters.Status == "declined" ? "bg-primary text-white border-primary" : "border-border hover:bg-secondary")">
            Declined
        </a>
    </div>

    <div class="flex-1 max-w-sm ml-auto flex gap-2">
        <input type="text"
               id="searchListings"
               placeholder="Search by title, host, or location..."
               class="w-full h-10 rounded-lg border border-border bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
               value="@Model.Filters.SearchTerm" />
        <button id="searchButton" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-white hover:bg-primary/90 transition text-sm font-medium">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            Search
        </button>
    </div>
</div>

<!-- Sort Options -->
<div class="mb-4 flex items-center gap-2">
    <span class="text-sm text-muted-foreground">Sort by:</span>
    <a href="@Url.Action("Listings", new { status = Model.Filters.Status, search = Model.Filters.SearchTerm, sort = "newest", page = 1 })"
       class="text-sm @(Model.Filters.SortBy == "newest" ? "text-primary font-medium" : "text-muted-foreground hover:text-foreground")">
        Newest
    </a>
    <span class="text-muted-foreground">|</span>
    <a href="@Url.Action("Listings", new { status = Model.Filters.Status, search = Model.Filters.SearchTerm, sort = "price_high", page = 1 })"
       class="text-sm @(Model.Filters.SortBy == "price_high" ? "text-primary font-medium" : "text-muted-foreground hover:text-foreground")">
        Price: High to Low
    </a>
    <span class="text-muted-foreground">|</span>
    <a href="@Url.Action("Listings", new { status = Model.Filters.Status, search = Model.Filters.SearchTerm, sort = "price_low", page = 1 })"
       class="text-sm @(Model.Filters.SortBy == "price_low" ? "text-primary font-medium" : "text-muted-foreground hover:text-foreground")">
        Price: Low to High
    </a>
</div>

<!-- Listings Table -->
<div class="overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">
    <table class="w-full text-sm text-left" id="listingsTable">
        <thead class="border-b border-border bg-muted/40 text-muted-foreground">
            <tr>
                <th class="p-4 font-medium">Property</th>
                <th class="p-4 font-medium">Host</th>
                <th class="p-4 font-medium">Location</th>
                <th class="p-4 font-medium text-right">Price</th>
                <th class="p-4 font-medium">Submitted</th>
                <th class="p-4 font-medium">Status</th>
                <th class="p-4 font-medium text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-border">
            @if (Model.Listings != null && Model.Listings.Any())
            {
                @foreach (var listing in Model.Listings)
                {
                    // Calculate status color
                    var statusColor = listing.Status switch
                    {
                        ListingStatus.Approved => "bg-emerald-100 text-emerald-800",
                        ListingStatus.Pending => "bg-yellow-100 text-yellow-800",
                        ListingStatus.Declined => "bg-red-100 text-red-800",
                        _ => "bg-gray-100 text-gray-800"
                    };

                    <tr class="hover:bg-muted/50 transition listing-row">
                        <td class="p-4 font-medium">
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrEmpty(listing.ImageUrl))
                                {
                                    <img src="@listing.ImageUrl" alt="@listing.Title" class="size-10 rounded-lg object-cover" />
                                }
                                else
                                {
                                    <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary font-semibold text-sm">
                                        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                        </svg>
                                    </div>
                                }
                                <a href="@Url.Action("Details", "Property", new { id = listing.Id })"
                                   class="hover:underline text-foreground font-medium">
                                    @listing.Title
                                </a>
                            </div>
                        </td>
                        <td class="p-4 text-muted-foreground">@listing.HostName</td>
                        <td class="p-4 text-muted-foreground">@listing.Location</td>
                        <td class="p-4 text-right font-medium">@listing.Price.ToString("N0") EGP</td>
                        <td class="p-4 text-muted-foreground">@(listing.SubmittedDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                        <td class="p-4">
                            <span class="inline-flex items-center rounded-full @statusColor px-2.5 py-0.5 text-xs font-semibold">
                                @listing.StatusDisplay
                            </span>
                        </td>
                        <td class="p-4 text-right">
                            <div class="flex justify-end gap-2">
                                @if (listing.Status == ListingStatus.Pending)
                                {
                                    <form asp-controller="Admin" asp-action="Approve" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@listing.Id" />
                                        <button type="submit"
                                                class="inline-flex items-center gap-1 h-8 rounded-lg border border-border bg-background px-3 text-xs font-medium hover:bg-emerald-50 hover:text-emerald-600 transition">
                                            <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                            </svg>
                                            Approve
                                        </button>
                                    </form>
                                    <form asp-controller="Admin" asp-action="Decline" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@listing.Id" />
                                        <button type="submit"
                                                class="inline-flex items-center gap-1 h-8 rounded-lg border border-transparent px-3 text-xs font-medium text-muted-foreground hover:bg-red-50 hover:text-red-600 transition">
                                            <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                            </svg>
                                            Reject
                                        </button>
                                    </form>
                                }
                                else
                                {
                                   
                                    <a asp-controller = "Property" asp-action = "Detail" asp-route-id = "@listing.Id"
                                       class= "inline-flex items-center gap-1 h-8 rounded-lg border border-border bg-background px-3 text-xs font-medium hover:bg-secondary transition" >
                                        View
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="p-8 text-center text-muted-foreground">
                        <div class="flex flex-col items-center gap-2">
                            <svg class="size-12 text-muted-foreground/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                            <p>No listings found matching your criteria.</p>
                            <a href="@Url.Action("Listings")" class="text-primary hover:underline text-sm">Clear filters</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
{
    <div class="mt-6 flex items-center justify-between">
        <p class="text-sm text-muted-foreground">
            Showing @(((Model.Pagination.CurrentPage - 1) * Model.Pagination.PageSize) + 1) to
            @Math.Min(Model.Pagination.CurrentPage * Model.Pagination.PageSize, Model.Pagination.TotalItems)
            of @Model.Pagination.TotalItems results
        </p>
        <div class="flex gap-2">
            @if (Model.Pagination.HasPrevious)
            {
                <a href="@Url.Action("Listings", new
                   {
                       status = Model.Filters.Status,
                       search = Model.Filters.SearchTerm,
                       sort = Model.Filters.SortBy,
                       page = Model.Pagination.CurrentPage - 1
                   })"
                   class="inline-flex items-center gap-1 px-3 py-2 rounded-lg border border-border hover:bg-secondary transition text-sm">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Previous
                </a>
            }
            @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
            {
                if (i == Model.Pagination.CurrentPage)
                {
                    <span class="inline-flex items-center px-3 py-2 rounded-lg bg-primary text-white text-sm font-medium">@i</span>
                }
                else if (i == 1 || i == Model.Pagination.TotalPages || Math.Abs(i - Model.Pagination.CurrentPage) <= 1)
                {
                    <a href="@Url.Action("Listings", new
                       {
                           status = Model.Filters.Status,
                           search = Model.Filters.SearchTerm,
                           sort = Model.Filters.SortBy,
                           page = i
                       })"
                       class="inline-flex items-center px-3 py-2 rounded-lg border border-border hover:bg-secondary transition text-sm">
                        @i
                    </a>
                }
                else if (i == Model.Pagination.CurrentPage - 2 || i == Model.Pagination.CurrentPage + 2)
                {
                    <span class="inline-flex items-center px-3 py-2 text-sm text-muted-foreground">...</span>
                }
            }
            @if (Model.Pagination.HasNext)
            {
                <a href="@Url.Action("Listings", new
                   {
                       status = Model.Filters.Status,
                       search = Model.Filters.SearchTerm,
                       sort = Model.Filters.SortBy,
                       page = Model.Pagination.CurrentPage + 1
                   })"
                   class="inline-flex items-center gap-1 px-3 py-2 rounded-lg border border-border hover:bg-secondary transition text-sm">
                    Next
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Search with Enter key
            const searchInput = document.getElementById('searchListings');
            const searchButton = document.getElementById('searchButton');

            if (searchInput && searchButton) {
                // Search on button click
                searchButton.addEventListener('click', function() {
                    const query = searchInput.value.trim();
                    const currentUrl = new URL(window.location.href);
                    if (query) {
                        currentUrl.searchParams.set('search', query);
                    } else {
                        currentUrl.searchParams.delete('search');
                    }
                    currentUrl.searchParams.set('page', '1');
                    window.location.href = currentUrl.toString();
                });

                // Search on Enter key
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        searchButton.click();
                    }
                });

                // Clear search with Escape key
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        searchInput.value = '';
                        searchButton.click();
                    }
                });
            }

            // Confirm approve/reject actions
            document.querySelectorAll('form[action*="Approve"]').forEach(form => {
                form.addEventListener('submit', function(e) {
                    const title = this.closest('tr').querySelector('.font-medium a')?.textContent?.trim() || 'this listing';
                    if (!confirm(`Are you sure you want to approve "${title}"?`)) {
                        e.preventDefault();
                    }
                });
            });

            document.querySelectorAll('form[action*="Decline"]').forEach(form => {
                form.addEventListener('submit', function(e) {
                    const title = this.closest('tr').querySelector('.font-medium a')?.textContent?.trim() || 'this listing';
                    if (!confirm(`Are you sure you want to reject "${title}"?`)) {
                        e.preventDefault();
                    }
                });
            });

            // Debounce search for better performance
            let debounceTimer;
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        if (this.value.trim() === '') {
                            searchButton.click();
                        }
                    }, 500);
                });
            }
        });
    </script>
}