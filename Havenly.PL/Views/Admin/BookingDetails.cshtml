@model Havenly.DAL.Entities.Booking
@using Havenly.DAL.Enums

@{
    ViewData["Title"] = $"Booking #{Model.BookingID} — Admin Inspection";
    var property = Model.Listing?.Property;
    var host = property?.Owner;
    var guest = Model.Guest;
    var primaryImage = property?.Images?.FirstOrDefault(i => i.IsPrimary == true)?.ImagePath
                     ?? property?.Images?.FirstOrDefault()?.ImagePath
                     ?? "/images/p1.jpg";
    var nights = (Model.CheckOut - Model.CheckIn).Days;
    if (nights <= 0) nights = 1;
    var pricePerNight = Model.Listing?.Price ?? (Model.TotalPrice / nights);
    var platformFee = Math.Round(Model.TotalPrice * 0.10m, 2);
    var hostShare = Model.TotalPrice - platformFee;
}

<div class="container-page py-10 max-w-5xl mx-auto space-y-6">
    <!-- Breadcrumbs -->
    <div class="flex items-center justify-between">
        <a asp-controller="Admin" asp-action="Bookings" class="inline-flex items-center gap-2 text-sm font-semibold text-muted-foreground hover:text-primary transition">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Bookings
        </a>
        <span class="text-xs font-mono text-muted-foreground">ID: #@Model.BookingID</span>
    </div>

    <!-- Top Card / Header -->
    <div class="rounded-3xl border border-border bg-card p-6 sm:p-8 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">Reservation #@Model.BookingID</h1>
                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-bold
                    @(Model.Status == BookingStatus.Approved ? "bg-emerald-500/10 text-emerald-600 border border-emerald-500/20" :
                      Model.Status == BookingStatus.Pending ? "bg-amber-500/10 text-amber-600 border border-amber-500/20" :
                      Model.Status == BookingStatus.Completed ? "bg-blue-500/10 text-blue-600 border border-blue-500/20" :
                      "bg-rose-500/10 text-rose-600 border border-rose-500/20")">
                    @Model.Status
                </span>
            </div>
            <p class="text-xs text-muted-foreground mt-1">
                Stay dates: @Model.CheckIn.ToString("MMM d, yyyy") – @Model.CheckOut.ToString("MMM d, yyyy") (@nights night@(nights != 1 ? "s" : ""))
            </p>
        </div>

        <div class="text-right">
            <p class="text-xs text-muted-foreground uppercase font-semibold">Total Revenue</p>
            <p class="text-2xl sm:text-3xl font-extrabold text-primary">@Model.TotalPrice.ToString("N2") EGP</p>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-12">
        <!-- Left: Guest & Property & Host -->
        <div class="lg:col-span-7 space-y-6">
            <!-- Property Details -->
            <div class="rounded-3xl border border-border bg-card p-6 shadow-sm space-y-4">
                <h2 class="text-base font-bold text-foreground flex items-center gap-2">
                    <svg class="size-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    Booked Property
                </h2>

                <div class="flex gap-4 items-start">
                    <img src="@primaryImage" alt="@(property?.PropertyName ?? "Property")" class="size-24 rounded-2xl object-cover border border-border flex-shrink-0" />
                    <div class="space-y-1">
                        <h3 class="font-bold text-base leading-snug">@(property?.PropertyName ?? $"Listing #{Model.ListingID}")</h3>
                        <p class="text-xs text-muted-foreground">
                            @(property?.Address?.City ?? "Egypt"), @(property?.Address?.Country ?? "Egypt") · @(property?.Category ?? "Stay")
                        </p>
                        <div class="pt-2 flex flex-wrap gap-2">
                            @if (property != null)
                            {
                                <a asp-controller="Property" asp-action="Detail" asp-route-id="@property.PropertyID" target="_blank"
                                   class="inline-flex items-center gap-1 rounded-lg border border-border bg-secondary/80 px-3 py-1 text-xs font-semibold hover:bg-secondary transition">
                                    <span>View Listing</span>
                                    <span class="text-[10px]">↗</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Guest Profile -->
            <div class="rounded-3xl border border-border bg-card p-6 shadow-sm space-y-4">
                <h2 class="text-base font-bold text-foreground flex items-center gap-2">
                    <svg class="size-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    Guest Information
                </h2>

                <div class="flex items-center justify-between">
                    <div class="space-y-1">
                        <p class="font-bold text-sm">@(guest?.Name ?? "Guest Traveler")</p>
                        <p class="text-xs text-muted-foreground">Email: @(guest?.Email ?? "N/A")</p>
                        @if (!string.IsNullOrEmpty(guest?.PhoneNumber))
                        {
                            <p class="text-xs text-muted-foreground">Phone: @guest.PhoneNumber</p>
                        }
                    </div>

                    @if (guest != null)
                    {
                        <a asp-controller="Account" asp-action="ViewProfile" asp-route-id="@guest.Id" target="_blank"
                           class="inline-flex items-center gap-1 rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-medium hover:bg-secondary transition">
                            <span>Inspect Profile</span>
                            <span class="text-[10px]">↗</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Host Profile -->
            <div class="rounded-3xl border border-border bg-card p-6 shadow-sm space-y-4">
                <h2 class="text-base font-bold text-foreground flex items-center gap-2">
                    <svg class="size-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                    Host Information
                </h2>

                <div class="flex items-center justify-between">
                    <div class="space-y-1">
                        <p class="font-bold text-sm">@(host?.Name ?? "Host")</p>
                        <p class="text-xs text-muted-foreground">Email: @(host?.Email ?? "N/A")</p>
                        @if (!string.IsNullOrEmpty(host?.PhoneNumber))
                        {
                            <p class="text-xs text-muted-foreground">Phone: @host.PhoneNumber</p>
                        }
                    </div>

                    @if (host != null)
                    {
                        <a asp-controller="Account" asp-action="ViewProfile" asp-route-id="@host.Id" target="_blank"
                           class="inline-flex items-center gap-1 rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-medium hover:bg-secondary transition">
                            <span>Host Profile</span>
                            <span class="text-[10px]">↗</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Financial Breakdown & Schedule -->
        <div class="lg:col-span-5 space-y-6">
            <!-- Schedule Card -->
            <div class="rounded-3xl border border-border bg-card p-6 shadow-sm space-y-4">
                <h3 class="font-bold text-base">Stay Details</h3>
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">Check-in</span>
                        <span class="font-semibold">@Model.CheckIn.ToString("ddd, MMM d, yyyy")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">Check-out</span>
                        <span class="font-semibold">@Model.CheckOut.ToString("ddd, MMM d, yyyy")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">Duration</span>
                        <span class="font-semibold">@nights night@(nights != 1 ? "s" : "")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">Guest capacity</span>
                        <span class="font-semibold">@(Model.Listing?.Property?.NumberOfGuests ?? 1) guests</span>
                    </div>
                </div>
            </div>

            <!-- Financials Card -->
            <div class="rounded-3xl border border-border bg-card p-6 shadow-sm space-y-4">
                <h3 class="font-bold text-base">Financial Breakdown</h3>
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">Rate per night</span>
                        <span>@pricePerNight.ToString("N2") EGP</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">Gross Stays Subtotal</span>
                        <span class="font-semibold">@Model.TotalPrice.ToString("N2") EGP</span>
                    </div>
                    <div class="flex justify-between text-xs text-primary">
                        <span>Havenly Commission (10%)</span>
                        <span>@platformFee.ToString("N2") EGP</span>
                    </div>
                    <div class="flex justify-between text-xs text-emerald-700">
                        <span>Host Share (90%)</span>
                        <span>@hostShare.ToString("N2") EGP</span>
                    </div>
                    <div class="border-t border-border pt-3 flex justify-between font-bold text-base">
                        <span>Total Paid (EGP)</span>
                        <span class="text-primary text-xl font-extrabold">@Model.TotalPrice.ToString("N2") EGP</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
