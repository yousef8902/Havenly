@{
}
@model Havenly.BLL.ModelVMs.AdminMembersVM


@{
    ViewData["Title"] = "Members — Havenly Admin";
    ViewData["Description"] = "Manage all platform members, guests, hosts, and administrators.";
    Layout = "~/Views/Shared/_WorkspaceLayout.cshtml";
    ViewData["WorkspaceNav"] = "admin";
    ViewData["Workspace"] = "Admin console";
    ViewData["WorkspaceRole"] = "Omar Khalil · Administrator";
}

<!-- Page Heading -->
<div class="space-y-1 mb-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold tracking-tight">Members</h1>
            <p class="text-muted-foreground">Manage all platform members, guests, hosts, and administrators.</p>
        </div>
        <div class="flex gap-2">
             <a asp-controller="Admin" asp-action="Dashboard" class="inline-flex items-center gap-2 rounded-lg border border-border bg-background px-4 py-2 text-sm font-medium hover:bg-secondary transition">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Dashboard
        </a>
        </div>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-medium text-emerald-700">
        @TempData["Message"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700">
        @TempData["Error"]
    </div>
}

<!-- Stats Cards -->
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6 mb-6">
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
        <p class="text-sm text-muted-foreground">Total Members</p>
        <p class="text-2xl font-bold">@Model.Stats.Total.ToString("N0")</p>
    </div>
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
        <p class="text-sm text-muted-foreground">Active</p>
        <p class="text-2xl font-bold text-emerald-600">@Model.Stats.Active.ToString("N0")</p>
    </div>
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
        <p class="text-sm text-muted-foreground">Pending Hosts</p>
        <p class="text-2xl font-bold text-amber-600">@Model.Stats.PendingHosts.ToString("N0")</p>
    </div>
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
        <p class="text-sm text-muted-foreground">Suspended</p>
        <p class="text-2xl font-bold text-red-600">@Model.Stats.Suspended.ToString("N0")</p>
    </div>
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
        <p class="text-sm text-muted-foreground">Guests</p>
        <p class="text-2xl font-bold text-blue-600">@Model.Stats.Guests.ToString("N0")</p>
    </div>
    <div class="rounded-2xl border border-border bg-card p-4 shadow-sm">
        <p class="text-sm text-muted-foreground">Hosts</p>
        <p class="text-2xl font-bold text-purple-600">@Model.Stats.Hosts.ToString("N0")</p>
    </div>
</div>

<!-- Filters -->
<div class="mb-6 flex flex-wrap items-center gap-4">
    <div class="flex flex-wrap gap-2">
        <!-- Status Filter -->
        <a href="@Url.Action("Members", new { status = "all", search = Model.Filters.SearchTerm, page = 1 })"
           class="px-3 py-1.5 text-sm rounded-lg border @(Model.Filters.Status == "all" ? "bg-primary text-white border-primary" : "border-border hover:bg-secondary")">
            All Status
        </a>
        <a href="@Url.Action("Members", new { status = "active", search = Model.Filters.SearchTerm, page = 1 })"
           class="px-3 py-1.5 text-sm rounded-lg border @(Model.Filters.Status == "active" ? "bg-primary text-white border-primary" : "border-border hover:bg-secondary")">
            Active
        </a>
        <a href="@Url.Action("Members", new { status = "PendingApproval", search = Model.Filters.SearchTerm, page = 1 })"
           class="px-3 py-1.5 text-sm rounded-lg border @(Model.Filters.Status?.ToLower() == "pendingapproval" ? "bg-amber-500 text-white border-amber-500 font-semibold" : "border-amber-300 text-amber-700 bg-amber-50/50 hover:bg-amber-100")">
            Pending Hosts (@Model.Stats.PendingHosts)
        </a>
        <a href="@Url.Action("Members", new { status = "suspended", search = Model.Filters.SearchTerm, page = 1 })"
           class="px-3 py-1.5 text-sm rounded-lg border @(Model.Filters.Status == "suspended" ? "bg-primary text-white border-primary" : "border-border hover:bg-secondary")">
            Suspended
        </a>
    </div>

    <div class="flex-1 max-w-sm ml-auto flex gap-2">
        <input type="text"
               id="searchMembers"
               placeholder="Search by name, email, or role..."
               class="w-full h-10 rounded-lg border border-border bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
               value="@Model.Filters.SearchTerm" />
        <button id="searchButton" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-white hover:bg-primary/90 transition text-sm font-medium">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            Search
        </button>
    </div>
</div>

<!-- Members Table -->
<div class="overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">
    <table class="w-full text-sm text-left" id="membersTable">
        <thead class="border-b border-border bg-muted/40 text-muted-foreground">
            <tr>
                <th class="p-4 font-medium">Member</th>
                <th class="p-4 font-medium">Email</th>
                <th class="p-4 font-medium">Role</th>
                <th class="p-4 font-medium">Joined</th>
                <th class="p-4 font-medium text-center">Bookings</th>
                <th class="p-4 font-medium">Status</th>
                <th class="p-4 font-medium text-right">Action</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-border">
            @if (Model.Members != null && Model.Members.Any())
            {
                @foreach (var user in Model.Members)
                {
                    // Calculate initials
                    var initials = "U";
                    if (!string.IsNullOrEmpty(user.FullName))
                    {
                        var nameParts = user.FullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        if (nameParts.Length == 1)
                        {
                            initials = nameParts[0][0].ToString().ToUpper();
                        }
                        else if (nameParts.Length > 1)
                        {
                            initials = $"{nameParts[0][0]}{nameParts[^1][0]}".ToUpper();
                        }
                    }

                    var statusColor = user.Status switch
                    {
                        UserStatus.Active => "bg-emerald-100 text-emerald-800",
                        UserStatus.Suspended => "bg-red-100 text-red-800",
                        UserStatus.PendingApproval => "bg-amber-100 text-amber-800 border border-amber-300",
                        _ => "bg-gray-100 text-gray-800"
                    };

                    <tr class="hover:bg-muted/50 transition member-row">
                        <td class="p-4 font-medium">
                            <div class="flex items-center gap-3 cursor-pointer group" onclick="openProfileModal('@user.Id')">
                                @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                {
                                    <img src="@user.AvatarUrl" alt="@user.FullName" class="size-8 rounded-full object-cover group-hover:scale-105 transition" />
                                }
                                else
                                {
                                    <div class="size-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-semibold text-sm group-hover:scale-105 transition">
                                        @initials
                                    </div>
                                }
                                <div>
                                    <span class="font-medium text-foreground group-hover:text-primary transition">@user.FullName</span>
                                    @if (user.IsVerified)
                                    {
                                        <svg class="size-4 inline-block text-primary" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                        </svg>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="p-4 text-muted-foreground">@user.Email</td>
                        <td class="p-4">
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium
                                @(user.Role == "Admin" ? "bg-purple-100 text-purple-800" :
                                user.Role == "Host" ? "bg-blue-100 text-blue-800" :
                                "bg-gray-100 text-gray-800")">
                                @user.Role
                            </span>
                        </td>
                        <td class="p-4 text-muted-foreground">@((user.JoinedDate.HasValue && user.JoinedDate.Value > new DateTime(2000, 1, 1)) ? user.JoinedDate.Value.ToString("MMM dd, yyyy") : "Recently")</td>
                        <td class="p-4 text-center">
                            <span class="inline-flex items-center justify-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary">
                                @user.BookingsCount
                            </span>
                        </td>
                        <td class="p-4">
                            <span class="inline-flex items-center rounded-full @statusColor px-2.5 py-0.5 text-xs font-semibold">
                                @user.StatusDisplay
                            </span>
                        </td>
                        <td class="p-4 text-right">
                            <div class="flex justify-end items-center gap-1.5 flex-wrap">
                                @if (user.Status == UserStatus.PendingApproval)
                                {
                                    @if (!string.IsNullOrEmpty(user.VerificationDocumentUrl))
                                    {
                                        <a href="@user.VerificationDocumentUrl" target="_blank"
                                           class="inline-flex items-center gap-1 h-8 rounded-lg border border-primary/40 bg-primary/10 px-2 text-xs font-semibold text-primary hover:bg-primary/20 transition" title="Inspect uploaded ID / Permit">
                                            <span>📄 ID</span>
                                        </a>
                                    }
                                    <form asp-controller="Admin" asp-action="ApproveHost" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="h-8 rounded-lg bg-emerald-600 px-2.5 text-xs font-semibold text-white hover:bg-emerald-700 transition">
                                            Approve
                                        </button>
                                    </form>
                                    <form asp-controller="Admin" asp-action="RejectHost" method="post" class="inline" onsubmit="return confirm('Decline this host application?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="h-8 rounded-lg px-2 text-xs font-medium text-destructive hover:bg-destructive/10 transition">
                                            Reject
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="ViewProfile" asp-route-id="@user.Id" target="_blank"
                                       class="inline-flex items-center gap-1 h-8 rounded-lg border border-border bg-background px-2.5 text-xs font-medium hover:bg-secondary transition">
                                        Profile
                                    </a>
                                    <form asp-controller="Admin" asp-action="ToggleUserStatus" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="hidden" name="isActive" value="@(!user.IsActive)" />
                                        <button type="submit"
                                                class="h-8 rounded-lg px-2.5 text-xs font-medium transition
                                            @(user.IsActive ? "text-muted-foreground hover:bg-destructive/10 hover:text-destructive" : "text-primary hover:bg-primary/10")">
                                            @(user.IsActive ? "Suspend" : "Reinstate")
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="p-8 text-center text-muted-foreground">
                        <div class="flex flex-col items-center gap-2">
                            <svg class="size-12 text-muted-foreground/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-3.488M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 0a2 2 0 11-4 0 2 2 0 014 0zM7 20H2v-2a3 3 0 015.856-3.488M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <p>No members found matching your criteria.</p>
                            <a href="@Url.Action("Members")" class="text-primary hover:underline text-sm">Clear filters</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
{
    <div class="mt-6 flex items-center justify-between">
        <p class="text-sm text-muted-foreground">
            Showing @(((Model.Pagination.CurrentPage - 1) * Model.Pagination.PageSize) + 1) to
            @Math.Min(Model.Pagination.CurrentPage * Model.Pagination.PageSize, Model.Pagination.TotalItems)
            of @Model.Pagination.TotalItems results
        </p>
        <div class="flex gap-2">
            @if (Model.Pagination.HasPrevious)
            {
                <a href="@Url.Action("Members", new
                   {
                       status = Model.Filters.Status,
                       search = Model.Filters.SearchTerm,
                       page = Model.Pagination.CurrentPage - 1
                   })"
                   class="inline-flex items-center gap-1 px-3 py-2 rounded-lg border border-border hover:bg-secondary transition text-sm">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Previous
                </a>
            }
            @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
            {
                if (i == Model.Pagination.CurrentPage)
                {
                    <span class="inline-flex items-center px-3 py-2 rounded-lg bg-primary text-white text-sm font-medium">@i</span>
                }
                else if (i == 1 || i == Model.Pagination.TotalPages || Math.Abs(i - Model.Pagination.CurrentPage) <= 1)
                {
                    <a href="@Url.Action("Members", new
                       {
                           status = Model.Filters.Status,
                           search = Model.Filters.SearchTerm,
                           page = i
                       })"
                       class="inline-flex items-center px-3 py-2 rounded-lg border border-border hover:bg-secondary transition text-sm">
                        @i
                    </a>
                }
                else if (i == Model.Pagination.CurrentPage - 2 || i == Model.Pagination.CurrentPage + 2)
                {
                    <span class="inline-flex items-center px-3 py-2 text-sm text-muted-foreground">...</span>
                }
            }
            @if (Model.Pagination.HasNext)
            {
                <a href="@Url.Action("Members", new
                   {
                       status = Model.Filters.Status,
                       search = Model.Filters.SearchTerm,
                       page = Model.Pagination.CurrentPage + 1
                   })"
                   class="inline-flex items-center gap-1 px-3 py-2 rounded-lg border border-border hover:bg-secondary transition text-sm">
                    Next
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Search with Enter key
            const searchInput = document.getElementById('searchMembers');
            const searchButton = document.getElementById('searchButton');

            if (searchInput && searchButton) {
                // Search on button click
                searchButton.addEventListener('click', function() {
                    const query = searchInput.value.trim();
                    const currentUrl = new URL(window.location.href);
                    if (query) {
                        currentUrl.searchParams.set('search', query);
                    } else {
                        currentUrl.searchParams.delete('search');
                    }
                    currentUrl.searchParams.set('page', '1');
                    window.location.href = currentUrl.toString();
                });

                // Search on Enter key
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        searchButton.click();
                    }
                });

                // Clear search with Escape key
                searchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        searchInput.value = '';
                        searchButton.click();
                    }
                });
            }

            // Confirm suspend/activate actions
            document.querySelectorAll('form[action*="ToggleUserStatus"]').forEach(form => {
                form.addEventListener('submit', function(e) {
                    const button = this.querySelector('button[type="submit"]');
                    const action = button.textContent.trim();
                    const name = this.closest('tr').querySelector('.font-medium').textContent.trim();

                    if (action === 'Suspend') {
                        if (!confirm(`Are you sure you want to suspend ${name}?`)) {
                            e.preventDefault();
                        }
                    } else if (action === 'Reinstate') {
                        if (!confirm(`Are you sure you want to reinstate ${name}?`)) {
                            e.preventDefault();
                        }
                    }
                });
            });

            // Debounce search for better performance
            let debounceTimer;
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        if (this.value.trim() === '') {
                            // If search is empty, submit immediately
                            searchButton.click();
                        }
                    }, 500);
                });
            }
        });
    </script>
}
