@model Havenly.BLL.ModelVMs.AdminDashboardVM

@{
    ViewData["Title"] = "Admin console — Havenly";
    ViewData["Description"] = "Moderate listings, manage member accounts and monitor platform growth across Havenly.";
    Layout = "~/Views/Shared/_WorkspaceLayout.cshtml";
    ViewData["WorkspaceNav"] = "admin";
    ViewData["Workspace"] = "Admin console";
    ViewData["WorkspaceRole"] = "Omar Khalil · Administrator";
}

<!-- Page Heading -->
<div class="space-y-1 mb-8">
    <h1 class="text-3xl font-bold tracking-tight">Overview</h1>
    <p class="text-muted-foreground">Platform health, moderation queue and member management.</p>
</div>

@if (TempData["Message"] != null)
{
    <div class="mb-6 rounded-xl border border-primary/20 bg-primary/10 p-4 text-sm font-medium text-primary">
        @TempData["Message"]
    </div>
}

<!-- Stat Cards Grid -->
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between pb-2">
            <p class="text-sm font-medium text-muted-foreground">Members</p>
            <svg class="size-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-3.488M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 0a2 2 0 11-4 0 2 2 0 014 0zM7 20H2v-2a3 3 0 015.856-3.488M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <div class="text-3xl font-bold">@(Model?.Stats?.MemberCount.ToString("N0") ?? "0")</div>
        <p class="text-xs text-muted-foreground mt-1">Guests, hosts and staff</p>
    </div>

    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between pb-2">
            <p class="text-sm font-medium text-muted-foreground">Listings</p>
            <svg class="size-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        </div>
        <div class="text-3xl font-bold">@(Model?.Stats?.ListingCount.ToString("N0") ?? "0")</div>
        <p class="text-xs text-muted-foreground mt-1">Live and in review</p>
    </div>

    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between pb-2">
            <p class="text-sm font-medium text-muted-foreground">Gross bookings</p>
            <svg class="size-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div class="text-3xl font-bold">$@(Model?.Stats?.GrossBookings.ToString("N2") ?? "0.00")</div>
        <p class="text-xs text-muted-foreground mt-1">Excludes cancellations</p>
    </div>

    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between pb-2">
            <p class="text-sm font-medium text-muted-foreground">Pending review</p>
            <svg class="size-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <div class="text-3xl font-bold">@(Model?.Stats?.PendingReviewCount.ToString("N0") ?? "0")</div>
        <p class="text-xs text-muted-foreground mt-1">Awaiting moderation</p>
    </div>
</div>

<!-- Bookings vs Signups Chart Section -->
<section class="mt-8 rounded-2xl border border-border bg-card p-6 shadow-sm">
    <h2 class="text-xl font-bold">Bookings vs. signups</h2>
    <div class="mt-6 flex h-44 items-end gap-4">
        @{
            var months = new[] { ("Jan", 60, 40), ("Feb", 80, 55), ("Mar", 45, 30), ("Apr", 90, 70), ("May", 75, 60), ("Jun", 100, 85) };
        }
        @foreach (var m in months)
        {
            <div class="flex flex-1 flex-col items-center gap-2 h-full justify-end">
                <div class="flex h-full w-full items-end justify-center gap-1">
                    <div class="w-1/3 rounded-t bg-primary" style="height: @(m.Item2)%"></div>
                    <div class="w-1/3 rounded-t bg-accent" style="height: @(m.Item3)%"></div>
                </div>
                <span class="text-xs text-muted-foreground">@m.Item1</span>
            </div>
        }
    </div>
    <div class="mt-4 flex gap-4 text-xs text-muted-foreground">
        <span class="flex items-center gap-2"><span class="size-3 rounded bg-primary"></span> Bookings</span>
        <span class="flex items-center gap-2"><span class="size-3 rounded bg-accent"></span> Signups</span>
    </div>
</section>

<!-- Tabs & Moderation Queue Table -->
@{
    var queryTab = Context.Request.Query["tab"].ToString();
    var tab = string.IsNullOrWhiteSpace(queryTab) ? "listings" : queryTab;
}

<div class="mt-8">
    <div class="flex gap-2 border-b border-border pb-2">
        <a href="?tab=listings" class="px-4 py-2 font-medium border-b-2 text-sm transition @(tab == "listings" ? "border-primary text-foreground font-semibold" : "border-transparent text-muted-foreground hover:text-foreground")">
            Listings
        </a>
        <a href="?tab=users" class="px-4 py-2 font-medium border-b-2 text-sm transition @(tab == "users" ? "border-primary text-foreground font-semibold" : "border-transparent text-muted-foreground hover:text-foreground")">
            Members
        </a>
    </div>

    @if (tab == "listings")
    {
        <div class="mt-6 overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">
            <table class="w-full text-sm text-left">
                <thead class="border-b border-border bg-muted/40 text-muted-foreground">
                    <tr>
                        <th class="p-4 font-medium">Property</th>
                        <th class="p-4 font-medium">Host</th>
                        <th class="p-4 font-medium">Submitted</th>
                        <th class="p-4 font-medium">Status</th>
                        <th class="p-4 font-medium text-right">Moderation</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    @if (Model?.PendingListings != null && Model.PendingListings.Any())
                    {
                        @foreach (var p in Model.PendingListings)
                        {
                            <tr class="hover:bg-muted/50 transition">
                                <td class="p-4 font-medium">
                                    <a asp-controller="Property" asp-action="Details" asp-route-id="@p.ListingID" class="hover:underline text-foreground">
                                        @(p.Property?.PropertyName ?? "Listing #" + p.ListingID)
                                    </a>
                                </td>
                                <td class="p-4 text-muted-foreground">
                                    @( "Host")
                                </td>
                                <td class="p-4 text-muted-foreground">
                                    @("MMM dd, yyyy")
                                </td>
                                <td class="p-4">
                                    <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-semibold text-yellow-800">
                                        Pending
                                    </span>
                                </td>
                                <td class="p-4 text-right">
                                    <div class="flex justify-end gap-2">
                                        <form asp-controller="Admin" asp-action="Approve" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.ListingID" />
                                            <button type="submit" class="inline-flex items-center gap-1 h-8 rounded-lg border border-border bg-background px-3 text-xs font-medium hover:bg-secondary transition">
                                                Approve
                                            </button>
                                        </form>

                                        <form asp-controller="Admin" asp-action="Decline" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.ListingID" />
                                            <button type="submit" class="inline-flex items-center gap-1 h-8 rounded-lg border border-transparent px-3 text-xs font-medium text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition">
                                                Reject
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="p-8 text-center text-muted-foreground">
                                No listings awaiting moderation.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="mt-6 space-y-4">
            <input type="text" placeholder="Search members by name, email or role" class="h-11 w-full max-w-sm rounded-xl border border-border bg-background px-4 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />

            <div class="overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">
                <table class="w-full text-sm text-left">
                    <thead class="border-b border-border bg-muted/40 text-muted-foreground">
                        <tr>
                            <th class="p-4 font-medium">Name</th>
                            <th class="p-4 font-medium">Email</th>
                            <th class="p-4 font-medium">Role</th>
                            <th class="p-4 font-medium">Joined</th>
                            <th class="p-4 font-medium">Status</th>
                            <th class="p-4 font-medium text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        <tr class="hover:bg-muted/50 transition">
                            <td class="p-4 font-medium">Nadia Rahman</td>
                            <td class="p-4 text-muted-foreground">nadia@example.com</td>
                            <td class="p-4">Guest</td>
                            <td class="p-4 text-muted-foreground">Jan 12, 2026</td>
                            <td class="p-4">
                                <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">
                                    Active
                                </span>
                            </td>
                            <td class="p-4 text-right">
                                <button type="button" class="h-8 rounded-lg px-3 text-xs font-medium text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition">
                                    Suspend
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>