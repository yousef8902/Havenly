@model Havenly.BLL.ModelVMs.AdminDashboardVM

@{
    ViewData["Title"] = "Admin console — Havenly";
    ViewData["Description"] = "Moderate listings, manage member accounts and monitor platform growth across Havenly.";
    Layout = "~/Views/Shared/_WorkspaceLayout.cshtml";
    ViewData["WorkspaceNav"] = "admin";
    ViewData["Workspace"] = "Omar Khalil · Administrator";
    ViewData["WorkspaceRole"] = "Omar Khalil · Administrator";
}

<!-- Page Heading -->
<div class="space-y-1 mb-8">
    <h1 class="text-3xl font-bold tracking-tight">Overview</h1>
    <p class="text-muted-foreground">Platform health, moderation queue and member management.</p>
</div>

@if (TempData["Message"] != null)
{
    <div class="mb-6 rounded-xl border border-primary/20 bg-primary/10 p-4 text-sm font-medium text-primary">
        @TempData["Message"]
    </div>
}

<!-- Stat Cards Grid -->
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <!-- Members -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between pb-2">
            <p class="text-sm font-medium text-muted-foreground">Members</p>

            <svg class="size-4 text-muted-foreground"
                 fill="none"
                 stroke="currentColor"
                 viewBox="0 0 24 24"
                 width="16"
                 height="16">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 20h5v-2a3 3 0 00-5.856-3.488M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 0a2 2 0 11-4 0 2 2 0 014 0zM7 20H2v-2a3 3 0 015.856-3.488M15 7a3 3 0 016 0z" />
            </svg>
        </div>

        <div class="text-3xl font-bold">
            @(Model?.Stats?.MemberCount.ToString("N0") ?? "0")
        </div>

        <p class="text-xs text-muted-foreground mt-1">
            Guests, hosts and staff
        </p>
    </div>


    <!-- Listings -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between pb-2">
            <p class="text-sm font-medium text-muted-foreground">Listings</p>

            <svg class="size-4 text-muted-foreground"
                 fill="none"
                 stroke="currentColor"
                 viewBox="0 0 24 24"
                 width="16"
                 height="16">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
        </div>

        <div class="text-3xl font-bold">
            @(Model?.Stats?.ListingCount.ToString("N0") ?? "0")
        </div>

        <p class="text-xs text-muted-foreground mt-1">
            Live and in review
        </p>
    </div>


    <!-- Gross Bookings -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between pb-2">
            <p class="text-sm font-medium text-muted-foreground">Gross bookings</p>

            <svg class="size-4 text-muted-foreground"
                 fill="none"
                 stroke="currentColor"
                 viewBox="0 0 24 24"
                 width="16"
                 height="16">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>

        <div class="text-3xl font-bold">
            @(Model?.Stats?.GrossBookings.ToString("N2") ?? "0.00") EGP
        </div>

        <p class="text-xs text-muted-foreground mt-1">
            Excludes cancellations
        </p>
    </div>


    <!-- Pending Review -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between pb-2">
            <p class="text-sm font-medium text-muted-foreground">Pending review</p>

            <svg class="size-4 text-muted-foreground"
                 fill="none"
                 stroke="currentColor"
                 viewBox="0 0 24 24"
                 width="16"
                 height="16">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <div class="text-3xl font-bold">
            @(Model?.Stats?.PendingReviewCount.ToString("N0") ?? "0")
        </div>

        <p class="text-xs text-muted-foreground mt-1">
            Awaiting moderation
        </p>
    </div>

</div>


<!-- Bookings vs Signups Chart -->
<section class="mt-8 rounded-2xl border border-border bg-card p-6 shadow-sm">

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

        <div>
            <h2 class="text-xl font-bold text-foreground">
                Bookings vs. signups
            </h2>

            <p class="mt-1 text-sm text-muted-foreground flex items-center gap-2 flex-wrap">
                <span>Platform activity over the last 12 months</span>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-[#0d9488] bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 px-2.5 py-0.5 rounded-full shadow-xs">
                    <svg class="size-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" /></svg>
                    Click any bar to view details below
                </span>
            </p>
        </div>

        <!-- Legend -->
        <div class="flex items-center gap-4 text-xs text-muted-foreground">

            <span class="flex items-center gap-2">
                <span class="size-3 rounded-sm bg-neutral-900 dark:bg-neutral-100 block"
                      style="width:12px;height:12px; background-color: var(--primary, #0f172a);">
                </span>
                Bookings
            </span>

            <span class="flex items-center gap-2">
                <span class="size-3 rounded-sm bg-neutral-400 dark:bg-neutral-500 block"
                      style="width:12px;height:12px; background-color: #94a3b8;">
                </span>
                Signups
            </span>

        </div>

    </div>


    @{
        var monthlyStats = Model?.MonthlyStats;

        var months = monthlyStats?.Months ?? new List<string> { "Oct", "Nov", "Dec", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep" };
        var years = monthlyStats?.Years ?? new List<int>();
        var monthNumbers = monthlyStats?.MonthNumbers ?? new List<int>();
        var fullMonthNames = monthlyStats?.FullMonthNames ?? new List<string>();
        var bookings = monthlyStats?.Bookings ?? new List<int>();
        var signups = monthlyStats?.Signups ?? new List<int>();

        var maxValue = 0;
        if (bookings.Any()) { maxValue = Math.Max(maxValue, bookings.Max()); }
        if (signups.Any()) { maxValue = Math.Max(maxValue, signups.Max()); }

        if (maxValue == 0) { maxValue = 10; }
    }


    <div class="mt-8 flex h-64 items-end gap-2 sm:gap-4 border-b border-border pb-2">

        @for (int i = 0; i < months.Count; i++)
        {
            var bookingValue = i < bookings.Count ? bookings[i] : 0;
            var signupValue = i < signups.Count ? signups[i] : 0;
            var year = (i < years.Count) ? years[i] : DateTime.UtcNow.Year;
            var monthNum = (i < monthNumbers.Count) ? monthNumbers[i] : (i + 1);
            var fullMonth = (i < fullMonthNames.Count) ? fullMonthNames[i] : months[i];

            var bookingHeightPct = ((double)bookingValue / maxValue * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            var signupHeightPct = ((double)signupValue / maxValue * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

            <!-- Month -->
            <div class="flex h-full flex-1 flex-col items-center justify-end gap-2">

                <!-- Bars Container -->
                <div class="flex h-full w-full items-end justify-center gap-1">

                    <!-- Bookings Bar -->
                    <div class="group relative flex h-full w-1/2 items-end justify-center">

                        <button type="button"
                                class="chart-bar-btn chart-bar-booking w-full rounded-t transition-all duration-200 hover:opacity-85 hover:brightness-125 focus:outline-none cursor-pointer"
                                style="height: @(bookingHeightPct)%; min-height: @(bookingValue > 0 ? "6px" : "3px"); background-color: var(--primary, #0f172a);"
                                data-year="@year"
                                data-month="@monthNum"
                                data-month-name="@fullMonth"
                                data-type="bookings"
                                data-count="@bookingValue"
                                title="Click to view @bookingValue bookings in @fullMonth">

                            @if (bookingValue > 0)
                            {
                                <span class="absolute bottom-full left-1/2 mb-1 hidden -translate-x-1/2 whitespace-nowrap rounded-md bg-neutral-900 px-2 py-1 text-xs text-white group-hover:block z-20 shadow-md pointer-events-none">
                                    @bookingValue bookings · click to view
                                </span>
                            }

                        </button>

                    </div>


                    <!-- Signups Bar -->
                    <div class="group relative flex h-full w-1/2 items-end justify-center">

                        <button type="button"
                                class="chart-bar-btn chart-bar-signup w-full rounded-t transition-all duration-200 hover:opacity-85 hover:brightness-125 focus:outline-none cursor-pointer"
                                style="height: @(signupHeightPct)%; min-height: @(signupValue > 0 ? "6px" : "3px"); background-color: #94a3b8;"
                                data-year="@year"
                                data-month="@monthNum"
                                data-month-name="@fullMonth"
                                data-type="signups"
                                data-count="@signupValue"
                                title="Click to view @signupValue signups in @fullMonth">

                            @if (signupValue > 0)
                            {
                                <span class="absolute bottom-full left-1/2 mb-1 hidden -translate-x-1/2 whitespace-nowrap rounded-md bg-neutral-900 px-2 py-1 text-xs text-white group-hover:block z-20 shadow-md pointer-events-none">
                                    @signupValue signups · click to view
                                </span>
                            }

                        </button>

                    </div>

                </div>


                <!-- Month Label -->
                <span class="text-xs text-muted-foreground font-medium">
                    @months[i]
                </span>

            </div>
        }

    </div>

</section>

<!-- Dynamic Monthly Activity Details Section (shown when a bar is clicked) -->
<section id="chartDetailsSection" class="hidden mt-8 rounded-2xl border border-[#0d9488]/30 bg-card p-6 shadow-lg transition-all duration-300">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-border">
        <div class="flex items-center gap-3">
            <div id="chartDetailsIcon" class="size-11 rounded-2xl bg-emerald-50 text-[#0d9488] border border-emerald-200 flex items-center justify-center font-bold shadow-xs">
                <!-- Icon via JS -->
            </div>
            <div>
                <div class="flex items-center gap-2 flex-wrap">
                    <h3 id="chartDetailsTitle" class="text-xl font-bold text-foreground">Monthly Activity</h3>
                    <span id="chartDetailsBadge" class="inline-flex items-center rounded-full bg-emerald-100 text-emerald-800 px-2.5 py-0.5 text-xs font-semibold">
                        0 records
                    </span>
                    <span id="chartDetailsRevenueBadge" class="hidden inline-flex items-center rounded-full bg-emerald-50 text-[#0d9488] border border-emerald-200 px-2.5 py-0.5 text-xs font-semibold">
                    </span>
                </div>
                <p id="chartDetailsSubtitle" class="text-xs text-muted-foreground mt-0.5">Click any bar in the chart above to switch month or metric.</p>
            </div>
        </div>

        <div class="flex items-center gap-3 self-end sm:self-center">
            <a id="chartDetailsFullLink" href="#" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0d9488] hover:text-[#0f766e] bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 px-3.5 py-1.5 rounded-full transition">
                <span>View in full table</span>
                <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </a>
            <button id="chartDetailsCloseBtn" type="button" class="size-8 rounded-full border border-gray-200 bg-white hover:bg-gray-100 text-gray-500 hover:text-gray-900 flex items-center justify-center text-sm font-bold transition shadow-xs" title="Dismiss details">
                ✕
            </button>
        </div>
    </div>

    <!-- Loading Spinner -->
    <div id="chartDetailsLoading" class="py-12 flex flex-col items-center justify-center text-muted-foreground text-sm gap-3">
        <svg class="animate-spin size-7 text-[#0d9488]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <span>Loading details for selected month...</span>
    </div>

    <!-- Empty State -->
    <div id="chartDetailsEmpty" class="hidden py-12 text-center text-muted-foreground text-sm">
        <div class="size-12 rounded-2xl bg-muted mx-auto flex items-center justify-center text-muted-foreground mb-3">
            <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        </div>
        <p id="chartDetailsEmptyMessage" class="font-medium">No records found for this period.</p>
    </div>

    <!-- Details Table Container -->
    <div id="chartDetailsTableContainer" class="hidden mt-4 overflow-x-auto rounded-xl border border-border">
    </div>
</section>


<!-- Tabs & Moderation Queue Table -->
@{
    var queryTab = Context.Request.Query["tab"].ToString();

    var tab = string.IsNullOrWhiteSpace(queryTab)
        ? "listings"
        : queryTab;
}


<div class="mt-8">

    <!-- Tabs -->
    <div class="flex gap-2 border-b border-border pb-2">

        <a href="?tab=listings"
           class="px-4 py-2 font-medium border-b-2 text-sm transition @(tab == "listings"
                                     ? "border-primary text-foreground font-semibold"
                                     : "border-transparent text-muted-foreground hover:text-foreground")">
            Listings
        </a>

        <a href="?tab=members"
           class="px-4 py-2 font-medium border-b-2 text-sm transition @(tab == "members"
                                     ? "border-primary text-foreground font-semibold"
                                     : "border-transparent text-muted-foreground hover:text-foreground")">
            Members
        </a>

    </div>


    @if (tab == "listings")
    {
        <!-- Listings Table -->
        <div class="mt-6 overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">

            <table class="w-full text-sm text-left">

                <thead class="border-b border-border bg-muted/40 text-muted-foreground">

                    <tr>
                        <th class="p-4 font-medium">Property</th>
                        <th class="p-4 font-medium">Host</th>
                        <th class="p-4 font-medium">Submitted</th>
                        <th class="p-4 font-medium">Status</th>
                        <th class="p-4 font-medium text-right">Moderation</th>
                    </tr>

                </thead>


                <tbody class="divide-y divide-border">

                    @if (Model?.PendingListings != null &&
                         Model.PendingListings.Any())
                    {
                        @foreach (var p in Model.PendingListings)
                        {
                            <tr class="hover:bg-muted/50 transition">

                                <td class="p-4 font-medium">

                                    <a asp-controller="Property"
                                       asp-action="Detail"
                                       asp-route-id="@p.ListingId"
                                       class="hover:underline text-foreground">
                                        @p.PropertyName
                                    </a>

                                </td>

                                <td class="p-4 text-muted-foreground">
                                    @p.HostName
                                </td>

                                <td class="p-4 text-muted-foreground">
                                    @(p.SubmittedDate?.ToString("MMM dd, yyyy") ?? "N/A")
                                </td>

                                <td class="p-4">

                                    <span class="inline-flex items-center rounded-full
                                        bg-yellow-100 px-2.5 py-0.5
                                        text-xs font-semibold text-yellow-800">
                                        Pending
                                    </span>

                                </td>

                                <td class="p-4 text-right">

                                    <div class="flex justify-end gap-2">

                                        <!-- Approve -->
                                        <form asp-controller="Admin"
                                              asp-action="Approve"
                                              method="post"
                                              class="inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@p.ListingId" />

                                            <button type="submit"
                                                    class="inline-flex items-center gap-1
                                                h-8 rounded-lg border border-border
                                                bg-background px-3 text-xs
                                                font-medium hover:bg-secondary
                                                transition">
                                                Approve
                                            </button>

                                        </form>


                                        <!-- Reject -->
                                        <form asp-controller="Admin"
                                              asp-action="Decline"
                                              method="post"
                                              class="inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@p.ListingId" />

                                            <button type="submit"
                                                    class="inline-flex items-center gap-1
                                                h-8 rounded-lg border
                                                border-transparent px-3
                                                text-xs font-medium
                                                text-muted-foreground
                                                hover:bg-destructive/10
                                                hover:text-destructive
                                                transition">
                                                Reject
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="p-8 text-center text-muted-foreground">
                                No listings awaiting moderation.
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <!-- Members -->
        <div class="mt-6 space-y-4">

            <input type="text"
                   id="searchMembers"
                   placeholder="Search members by name, email or role"
                   class="h-11 w-full max-w-sm rounded-xl border border-border
            bg-background px-4 text-sm
            focus:outline-none focus:ring-2 focus:ring-primary" />


            <div class="overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">

                <table class="w-full text-sm text-left"
                       id="membersTable">

                    <thead class="border-b border-border bg-muted/40 text-muted-foreground">

                        <tr>
                            <th class="p-4 font-medium">Name</th>
                            <th class="p-4 font-medium">Email</th>
                            <th class="p-4 font-medium">Role</th>
                            <th class="p-4 font-medium">Joined</th>
                            <th class="p-4 font-medium">Bookings</th>
                            <th class="p-4 font-medium">Status</th>
                            <th class="p-4 font-medium text-right">Action</th>
                        </tr>

                    </thead>


                    <tbody class="divide-y divide-border">

                        @{
                            var members =
                                Model?.MembersResult?.Members
                                ?? new List<MemberItem>();
                        }


                        @if (members.Any())
                        {
                            @foreach (var user in members)
                            {
                                var statusColor = user.Status switch
                                {
                                    UserStatus.Active =>
                                        "bg-emerald-100 text-emerald-800",

                                    UserStatus.Suspended =>
                                        "bg-red-100 text-red-800",

                                    _ =>
                                        "bg-gray-100 text-gray-800"
                                };


                                <tr class="hover:bg-muted/50 transition member-row">

                                    <!-- Name -->
                                    <td class="p-4 font-medium">

                                        <div class="flex items-center gap-2">

                                            <div class="size-8 rounded-full
                                                bg-primary/10
                                                flex items-center justify-center
                                                text-primary font-semibold text-sm">

                                                @{
                                                    var initials = "U";

                                                    if (!string.IsNullOrEmpty(user.FullName))
                                                    {
                                                        var parts = user.FullName
                                                            .Trim()
                                                            .Split(' ',
                                                                StringSplitOptions.RemoveEmptyEntries);

                                                        if (parts.Length == 1)
                                                        {
                                                            initials =
                                                                parts[0][0]
                                                                    .ToString()
                                                                    .ToUpper();
                                                        }
                                                        else if (parts.Length > 1)
                                                        {
                                                            initials =
                                                                $"{parts[0][0]}{parts[^1][0]}"
                                                                    .ToUpper();
                                                        }
                                                    }
                                                }

                                                @initials

                                            </div>

                                            @user.FullName

                                        </div>

                                    </td>


                                    <!-- Email -->
                                    <td class="p-4 text-muted-foreground">
                                        @user.Email
                                    </td>


                                    <!-- Role -->
                                    <td class="p-4 text-muted-foreground">
                                        @user.Role
                                    </td>


                                    <!-- Joined -->
                                    <td class="p-4 text-muted-foreground">
                                        @(user.JoinedDate?.ToString("MMM dd, yyyy") ?? "N/A")
                                    </td>


                                    <!-- Bookings -->
                                    <td class="p-4 text-center">
                                        @user.BookingsCount
                                    </td>


                                    <!-- Status -->
                                    <td class="p-4">

                                        <span class="inline-flex items-center rounded-full
                                            @statusColor
                                            px-2.5 py-0.5
                                            text-xs font-semibold">
                                            @user.StatusDisplay
                                        </span>

                                    </td>


                                    <!-- Action -->
                                    <td class="p-4 text-right">

                                        <form asp-controller="Admin"
                                              asp-action="ToggleUserStatus"
                                              method="post"
                                              class="inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="userId"
                                                   value="@user.Id" />

                                            <input type="hidden"
                                                   name="isActive"
                                                   value="@(!user.IsActive)" />

                                            <button type="submit"
                                                    class="h-8 rounded-lg px-3
                                                text-xs font-medium
                                                @(user.IsActive
                                                    ? "text-muted-foreground hover:bg-destructive/10 hover:text-destructive"
                                                    : "text-primary hover:bg-primary/10")
                                                transition">

                                                @(user.IsActive
                                                    ? "Suspend"
                                                    : "Reinstate")

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="p-8 text-center text-muted-foreground">
                                    No members found.
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>


@section Scripts {

    <script>

        // Member search functionality
        document.addEventListener('DOMContentLoaded', function() {

            const searchInput =
                document.getElementById('searchMembers');

            if (searchInput) {

                searchInput.addEventListener('input', function() {

                    const query =
                        this.value.toLowerCase();

                    const rows =
                        document.querySelectorAll('.member-row');

                    rows.forEach(row => {

                        const text =
                            row.textContent.toLowerCase();

                        row.style.display =
                            text.includes(query) ? '' : 'none';

                    });

                });

            }

            // Chart Bar Drill-Down
            const chartBarBtns = document.querySelectorAll('.chart-bar-btn');
            const detailsSection = document.getElementById('chartDetailsSection');
            const detailsIcon = document.getElementById('chartDetailsIcon');
            const detailsTitle = document.getElementById('chartDetailsTitle');
            const detailsSubtitle = document.getElementById('chartDetailsSubtitle');
            const detailsBadge = document.getElementById('chartDetailsBadge');
            const detailsRevenueBadge = document.getElementById('chartDetailsRevenueBadge');
            const detailsFullLink = document.getElementById('chartDetailsFullLink');
            const detailsCloseBtn = document.getElementById('chartDetailsCloseBtn');
            const detailsLoading = document.getElementById('chartDetailsLoading');
            const detailsEmpty = document.getElementById('chartDetailsEmpty');
            const detailsEmptyMessage = document.getElementById('chartDetailsEmptyMessage');
            const detailsTableContainer = document.getElementById('chartDetailsTableContainer');

            let activeBarBtn = null;

            function clearActiveBar() {
                if (activeBarBtn) {
                    activeBarBtn.classList.remove('ring-2', 'ring-[#0d9488]', 'ring-offset-2', 'scale-y-105', 'z-10');
                    activeBarBtn = null;
                }
            }

            if (detailsCloseBtn) {
                detailsCloseBtn.addEventListener('click', function() {
                    detailsSection.classList.add('hidden');
                    clearActiveBar();
                });
            }

            chartBarBtns.forEach(btn => {
                btn.addEventListener('click', async function() {
                    const year = this.dataset.year;
                    const month = this.dataset.month;
                    const monthName = this.dataset.monthName;
                    const type = this.dataset.type;

                    // Highlight active bar
                    clearActiveBar();
                    activeBarBtn = this;
                    this.classList.add('ring-2', 'ring-[#0d9488]', 'ring-offset-2', 'scale-y-105', 'z-10');

                    // Reveal section & set loading state
                    detailsSection.classList.remove('hidden');
                    detailsLoading.classList.remove('hidden');
                    detailsEmpty.classList.add('hidden');
                    detailsTableContainer.classList.add('hidden');
                    detailsRevenueBadge.classList.add('hidden');

                    // Icon & Title setup
                    if (type === 'bookings') {
                        detailsIcon.innerHTML = `
                            <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>`;
                        detailsTitle.textContent = `${monthName} · Bookings`;
                        detailsSubtitle.textContent = `All bookings placed during ${monthName}`;
                        detailsFullLink.href = `/Admin/Bookings`;
                        const linkSpan = detailsFullLink.querySelector('span');
                        if (linkSpan) linkSpan.textContent = 'View in Bookings';
                    } else {
                        detailsIcon.innerHTML = `
                            <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-3.488M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 0a2 2 0 11-4 0 2 2 0 014 0zM7 20H2v-2a3 3 0 015.856-3.488M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>`;
                        detailsTitle.textContent = `${monthName} · Signups`;
                        detailsSubtitle.textContent = `All members who registered during ${monthName}`;
                        detailsFullLink.href = `/Admin/Members`;
                        const linkSpan = detailsFullLink.querySelector('span');
                        if (linkSpan) linkSpan.textContent = 'View in Members';
                    }

                    detailsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

                    try {
                        const response = await fetch(`/Admin/GetMonthlyActivityDetails?year=${year}&month=${month}&type=${type}`);
                        if (!response.ok) throw new Error('Network response was not ok');
                        const data = await response.json();

                        detailsLoading.classList.add('hidden');

                        if (!data.success || !data.items || data.items.length === 0) {
                            detailsBadge.textContent = '0 records';
                            detailsEmptyMessage.textContent = `No ${type} recorded for ${monthName}.`;
                            detailsEmpty.classList.remove('hidden');
                            return;
                        }

                        detailsBadge.textContent = `${data.count} ${type}`;

                        if (type === 'bookings') {
                            if (data.totalRevenue) {
                                detailsRevenueBadge.textContent = `Total: ${data.totalRevenue} EGP`;
                                detailsRevenueBadge.classList.remove('hidden');
                            }

                            let rowsHtml = '';
                            data.items.forEach(b => {
                                rowsHtml += `
                                    <tr class="hover:bg-muted/50 transition">
                                        <td class="p-4 font-medium">
                                            <div class="flex items-center gap-3">
                                                <img src="${b.imageUrl}" alt="${b.propertyName}" class="size-10 rounded-lg object-cover border border-border flex-shrink-0" onerror="this.onerror=null; this.src='/images/hero.jpg';" />
                                                <div>
                                                    <a href="/Property/Detail/${b.propertyId}" class="hover:underline text-foreground font-medium line-clamp-1">
                                                        ${b.propertyName}
                                                    </a>
                                                    <span class="text-xs text-muted-foreground">Booking #${b.bookingId}</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="p-4 text-muted-foreground">
                                            <div class="font-medium text-foreground">${b.guestName}</div>
                                        </td>
                                        <td class="p-4 text-muted-foreground">${b.hostName}</td>
                                        <td class="p-4 text-muted-foreground text-xs whitespace-nowrap">
                                            <div><span class="font-medium text-foreground">In:</span> ${b.checkIn}</div>
                                            <div><span class="font-medium text-foreground">Out:</span> ${b.checkOut}</div>
                                        </td>
                                        <td class="p-4 text-right font-semibold text-foreground whitespace-nowrap">
                                            ${b.total} EGP
                                        </td>
                                        <td class="p-4 whitespace-nowrap">
                                            <span class="inline-flex items-center rounded-full ${b.statusColor} px-2.5 py-0.5 text-xs font-semibold">
                                                ${b.status}
                                            </span>
                                        </td>
                                        <td class="p-4 text-right whitespace-nowrap">
                                            <a href="/Admin/BookingDetails/${b.bookingId}" class="inline-flex items-center gap-1 h-8 rounded-lg border border-border bg-background px-3 text-xs font-medium hover:bg-secondary transition">
                                                View
                                            </a>
                                        </td>
                                    </tr>`;
                            });

                            detailsTableContainer.innerHTML = `
                                <table class="w-full text-sm text-left">
                                    <thead class="border-b border-border bg-muted/40 text-muted-foreground">
                                        <tr>
                                            <th class="p-4 font-medium">Property</th>
                                            <th class="p-4 font-medium">Guest</th>
                                            <th class="p-4 font-medium">Host</th>
                                            <th class="p-4 font-medium">Dates</th>
                                            <th class="p-4 font-medium text-right">Total</th>
                                            <th class="p-4 font-medium">Status</th>
                                            <th class="p-4 font-medium text-right">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-border bg-card">
                                        ${rowsHtml}
                                    </tbody>
                                </table>`;
                            detailsTableContainer.classList.remove('hidden');

                        } else {
                            let rowsHtml = '';
                            data.items.forEach(u => {
                                const initials = (u.name || 'U').split(' ').map(n => n[0]).filter(Boolean).slice(0, 2).join('').toUpperCase() || 'U';
                                rowsHtml += `
                                    <tr class="hover:bg-muted/50 transition">
                                        <td class="p-4 font-medium">
                                            <div class="flex items-center gap-2">
                                                <div class="size-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-semibold text-xs flex-shrink-0">
                                                    ${initials}
                                                </div>
                                                <span class="text-foreground font-medium">${u.name}</span>
                                            </div>
                                        </td>
                                        <td class="p-4 text-muted-foreground">${u.email}</td>
                                        <td class="p-4">
                                            <span class="inline-flex items-center rounded-full bg-secondary text-secondary-foreground px-2.5 py-0.5 text-xs font-medium">
                                                ${u.role}
                                            </span>
                                        </td>
                                        <td class="p-4 text-muted-foreground">${u.joinedDate}</td>
                                        <td class="p-4">
                                            <span class="inline-flex items-center rounded-full ${u.statusColor} px-2.5 py-0.5 text-xs font-semibold">
                                                ${u.statusDisplay}
                                            </span>
                                        </td>
                                    </tr>`;
                            });

                            detailsTableContainer.innerHTML = `
                                <table class="w-full text-sm text-left">
                                    <thead class="border-b border-border bg-muted/40 text-muted-foreground">
                                        <tr>
                                            <th class="p-4 font-medium">Member</th>
                                            <th class="p-4 font-medium">Email</th>
                                            <th class="p-4 font-medium">Role</th>
                                            <th class="p-4 font-medium">Joined</th>
                                            <th class="p-4 font-medium">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-border bg-card">
                                        ${rowsHtml}
                                    </tbody>
                                </table>`;
                            detailsTableContainer.classList.remove('hidden');
                        }

                    } catch (err) {
                        console.error('Error fetching activity details:', err);
                        detailsLoading.classList.add('hidden');
                        detailsEmptyMessage.textContent = 'Could not load details. Please try again.';
                        detailsEmpty.classList.remove('hidden');
                    }
                });
            });

        });

    </script>
}