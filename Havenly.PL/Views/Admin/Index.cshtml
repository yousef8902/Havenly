<!-- Tabs & Moderation Queue Table -->
@{
    var queryTab = Context.Request.Query["tab"].ToString();
    var tab = string.IsNullOrWhiteSpace(queryTab) ? "listings" : queryTab;
}

<div class="mt-8">
    <div class="flex gap-2 border-b border-border pb-2">
        <a href="?tab=listings" class="px-4 py-2 font-medium border-b-2 text-sm transition @(tab == "listings" ? "border-primary text-foreground font-semibold" : "border-transparent text-muted-foreground hover:text-foreground")">
            Listings
        </a>
        <a href="?tab=members" class="px-4 py-2 font-medium border-b-2 text-sm transition @(tab == "members" ? "border-primary text-foreground font-semibold" : "border-transparent text-muted-foreground hover:text-foreground")">
            Members
        </a>
    </div>

    @if (tab == "listings")
    {
        <div class="mt-6 overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">
            <table class="w-full text-sm text-left">
                <thead class="border-b border-border bg-muted/40 text-muted-foreground">
                    <tr>
                        <th class="p-4 font-medium">Property</th>
                        <th class="p-4 font-medium">Host</th>
                        <th class="p-4 font-medium">Submitted</th>
                        <th class="p-4 font-medium">Status</th>
                        <th class="p-4 font-medium text-right">Moderation</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border">
                    @if (Model?.PendingListings != null && Model.PendingListings.Any())
                    {
                        @foreach (var p in Model.PendingListings)
                        {
                            <tr class="hover:bg-muted/50 transition">
                                <td class="p-4 font-medium">
                                    <a asp-controller="Property" asp-action="Details" asp-route-id="@p.ListingId" class="hover:underline text-foreground">
                                        @p.PropertyName
                                    </a>
                                </td>
                                <td class="p-4 text-muted-foreground">
                                    @p.HostName
                                </td>
                                <td class="p-4 text-muted-foreground">
                                    @(p.SubmittedDate?.ToString("MMM dd, yyyy") ?? "N/A")
                                </td>
                                <td class="p-4">
                                    <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-semibold text-yellow-800">
                                        Pending
                                    </span>
                                </td>
                                <td class="p-4 text-right">
                                    <div class="flex justify-end gap-2">
                                        <form asp-controller="Admin" asp-action="Approve" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.ListingId" />
                                            <button type="submit" class="inline-flex items-center gap-1 h-8 rounded-lg border border-border bg-background px-3 text-xs font-medium hover:bg-secondary transition">
                                                Approve
                                            </button>
                                        </form>

                                        <form asp-controller="Admin" asp-action="Decline" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.ListingId" />
                                            <button type="submit" class="inline-flex items-center gap-1 h-8 rounded-lg border border-transparent px-3 text-xs font-medium text-muted-foreground hover:bg-destructive/10 hover:text-destructive transition">
                                                Reject
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="p-8 text-center text-muted-foreground">
                                No listings awaiting moderation.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="mt-6 space-y-4">
            <input type="text" id="searchMembers" placeholder="Search members by name, email or role" class="h-11 w-full max-w-sm rounded-xl border border-border bg-background px-4 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />

            <div class="overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">
                <table class="w-full text-sm text-left" id="membersTable">
                    <thead class="border-b border-border bg-muted/40 text-muted-foreground">
                        <tr>
                            <th class="p-4 font-medium">Name</th>
                            <th class="p-4 font-medium">Email</th>
                            <th class="p-4 font-medium">Role</th>
                            <th class="p-4 font-medium">Joined</th>
                            <th class="p-4 font-medium">Bookings</th>
                            <th class="p-4 font-medium">Status</th>
                            <th class="p-4 font-medium text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        @{
                            var members = Model?.MembersResult?.Members ?? new List<MemberItem>();
                        }
                        @if (members.Any()){
                            @foreach (var user in Model?.MembersResult?.Members)
                            {
                                var statusColor = user.Status switch
                                {
                                    UserStatus.Active => "bg-emerald-100 text-emerald-800",
                                    UserStatus.Suspended => "bg-red-100 text-red-800",
                                    _ => "bg-gray-100 text-gray-800"
                                };
                                <tr class="hover:bg-muted/50 transition member-row">
                                    <td class="p-4 font-medium">
                                        <div class="flex items-center gap-2">
                                            <div class="size-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-semibold text-sm">
                                                @{
                                                    var initials = "U";
                                                    if (!string.IsNullOrEmpty(user.FullName))
                                                    {
                                                        var parts = user.FullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                                        if (parts.Length == 1)
                                                        {
                                                            initials = parts[0][0].ToString().ToUpper();
                                                        }
                                                        else if (parts.Length > 1)
                                                        {
                                                            initials = $"{parts[0][0]}{parts[^1][0]}".ToUpper();
                                                        }
                                                    }
                                                }
                                                @initials
                                            </div>
                                            @user.FullName
                                        </div>
                                    </td>
                                    <td class="p-4 text-muted-foreground">@user.Phone</td>
                                    @* <td class="p-4">@user.Role</td> *@
                                    <td class="p-4 text-muted-foreground">@(user.JoinedDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                    <td class="p-4 text-center">@user.BookingsCount</td>
                                    <td class="p-4">
                                        <span class="inline-flex items-center rounded-full @statusColor px-2.5 py-0.5 text-xs font-semibold">
                                            @user.StatusDisplay
                                        </span>
                                    </td>
                                    <td class="p-4 text-right">
                                        <form asp-controller="Admin" asp-action="ToggleUserStatus" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <input type="hidden" name="isActive" value="@(!user.IsActive)" />
                                            <button type="submit" class="h-8 rounded-lg px-3 text-xs font-medium @(user.IsActive ? "text-muted-foreground hover:bg-destructive/10 hover:text-destructive" : "text-primary hover:bg-primary/10") transition">
                                                @(user.IsActive ? "Suspend" : "Reinstate")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="p-8 text-center text-muted-foreground">
                                    No members found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Member search functionality
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchMembers');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const query = this.value.toLowerCase();
                    const rows = document.querySelectorAll('.member-row');

                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(query) ? '' : 'none';
                    });
                });
            }
        });
    </script>
}