            // var monthlyData = Model?.MonthlyStats ?? new List<MonthlyStat>();
            // var maxValue = monthlyData.Any()
            //     ? monthlyData.Max(m => Math.Max(m.Bookings, m.Signups))
            //     : 100;

            // if (monthlyData.Any())
            // {
            //     foreach (var m in monthlyData)
            //     {
            //         var bookingsHeight = maxValue > 0 ? (m.Bookings / (double)maxValue) * 100 : 0;
            //         var signupsHeight = maxValue > 0 ? (m.Signups / (double)maxValue) * 100 : 0;
            //         <div class="flex flex-1 flex-col items-center gap-2 h-full justify-end">
            //             <div class="flex h-full w-full items-end justify-center gap-1">
            //                 <div class="w-1/3 rounded-t bg-primary" style="height: @(bookingsHeight)%; min-height: 2px;"></div>
            //                 <div class="w-1/3 rounded-t bg-accent" style="height: @(signupsHeight)%; min-height: 2px;"></div>
            //             </div>
            //             <span class="text-xs text-muted-foreground">@m.Month</span>
