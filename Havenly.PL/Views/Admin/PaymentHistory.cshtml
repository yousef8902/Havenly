@model Havenly.BLL.ModelVMs.Payment.AdminPaymentHistoryVM

@{
    ViewData["Title"] = "Payouts & Payments — Admin Console";
    Layout = "~/Views/Shared/_WorkspaceLayout.cshtml";
    ViewData["WorkspaceNav"] = "admin";
    ViewData["Workspace"] = "Admin console";
    ViewData["WorkspaceRole"] = "Omar Khalil · Administrator";
}

<!-- Page Header -->
<div class="space-y-1 mb-8">
    <h1 class="text-3xl font-bold tracking-tight">Payouts & Platform Financials</h1>
    <p class="text-muted-foreground">Monitor guest transactions, calculate platform revenue, and process host payouts.</p>
</div>

@if (TempData["Message"] != null)
{
    <div class="mb-6 rounded-xl border border-primary/20 bg-primary/10 p-4 text-sm font-medium text-primary">
        @TempData["Message"]
    </div>
}

<!-- Metrics Grid -->
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4 mb-8">
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between pb-2">
            <p class="text-sm font-medium text-muted-foreground">Gross Booking Volume</p>
            <span class="rounded-lg bg-emerald-500/10 p-1.5 text-emerald-600">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </span>
        </div>
        <div class="text-3xl font-bold text-foreground">$@Model.TotalGrossRevenue.ToString("N2")</div>
        <p class="text-xs text-muted-foreground mt-1">@Model.TotalTransactions total transactions</p>
    </div>

    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between pb-2">
            <p class="text-sm font-medium text-muted-foreground">Havenly Commission (10%)</p>
            <span class="rounded-lg bg-primary/10 p-1.5 text-primary">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
            </span>
        </div>
        <div class="text-3xl font-bold text-primary">$@Model.TotalPlatformCommission.ToString("N2")</div>
        <p class="text-xs text-muted-foreground mt-1">Net platform revenue</p>
    </div>

    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between pb-2">
            <p class="text-sm font-medium text-muted-foreground">Pending Host Payouts</p>
            <span class="rounded-lg bg-amber-500/10 p-1.5 text-amber-600">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </span>
        </div>
        <div class="text-3xl font-bold text-amber-600">$@Model.PendingHostPayouts.ToString("N2")</div>
        <p class="text-xs text-muted-foreground mt-1">Owed to hosts (90%)</p>
    </div>

    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="flex items-center justify-between pb-2">
            <p class="text-sm font-medium text-muted-foreground">Completed Payouts</p>
            <span class="rounded-lg bg-blue-500/10 p-1.5 text-blue-600">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </span>
        </div>
        <div class="text-3xl font-bold text-foreground">$@Model.CompletedHostPayouts.ToString("N2")</div>
        <p class="text-xs text-muted-foreground mt-1">Disbursed to host accounts</p>
    </div>
</div>

<!-- Transactions & Payouts Table -->
<div class="overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">
    <div class="p-4 border-b border-border flex items-center justify-between">
        <h3 class="font-bold text-base">All Transactions & Payout Orders</h3>
        <span class="text-xs text-muted-foreground">@Model.Payments.Count records</span>
    </div>

    <table class="w-full text-sm text-left">
        <thead class="border-b border-border bg-muted/40 text-muted-foreground">
            <tr>
                <th class="p-4 font-medium">Transaction / Booking</th>
                <th class="p-4 font-medium">Guest</th>
                <th class="p-4 font-medium">Host & Property</th>
                <th class="p-4 font-medium">Gross Total</th>
                <th class="p-4 font-medium">Commission (10%)</th>
                <th class="p-4 font-medium">Host Payout (90%)</th>
                <th class="p-4 font-medium">Payment Status</th>
                <th class="p-4 font-medium text-right">Payout Action</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-border">
            @if (Model.Payments.Any())
            {
                @foreach (var item in Model.Payments)
                {
                    <tr class="hover:bg-muted/30 transition">
                        <td class="p-4">
                            <div class="font-mono font-bold text-xs text-foreground">@item.TransactionId</div>
                            <div class="text-xs text-muted-foreground mt-0.5">Booking #@item.BookingId · @item.Gateway</div>
                        </td>
                        <td class="p-4">
                            <div class="font-medium text-foreground">@item.GuestName</div>
                            <div class="text-xs text-muted-foreground">@item.GuestEmail</div>
                        </td>
                        <td class="p-4">
                            <div class="font-medium text-foreground">@item.PropertyName</div>
                            <div class="text-xs text-muted-foreground">Host: @item.HostName</div>
                        </td>
                        <td class="p-4 font-bold text-foreground">
                            $@item.GrossAmount.ToString("N2")
                        </td>
                        <td class="p-4 font-medium text-primary">
                            $@item.PlatformFee.ToString("N2")
                        </td>
                        <td class="p-4 font-bold text-amber-600">
                            $@item.HostPayout.ToString("N2")
                        </td>
                        <td class="p-4">
                            @if (item.Status == Havenly.DAL.Entities.PaymentStatus.Completed)
                            {
                                <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs font-semibold text-emerald-600">
                                    Paid
                                </span>
                            }
                            else if (item.Status == Havenly.DAL.Entities.PaymentStatus.Pending)
                            {
                                <span class="inline-flex items-center rounded-full bg-amber-500/10 px-2.5 py-0.5 text-xs font-semibold text-amber-600">
                                    Pending
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center rounded-full bg-destructive/10 px-2.5 py-0.5 text-xs font-semibold text-destructive">
                                    @item.Status
                                </span>
                            }
                        </td>
                        <td class="p-4 text-right">
                            @if (item.Status == Havenly.DAL.Entities.PaymentStatus.Completed)
                            {
                                @if (item.IsPaidToHost)
                                {
                                    <span class="inline-flex items-center gap-1 text-xs font-bold text-emerald-600">
                                        <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                        Disbursed
                                    </span>
                                }
                                else
                                {
                                    <form asp-action="ProcessHostPayout" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="paymentId" value="@item.PaymentId" />
                                        <button type="submit" class="rounded-lg bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition">
                                            Pay Host
                                        </button>
                                    </form>
                                }
                            }
                            else
                            {
                                <span class="text-xs text-muted-foreground">—</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="p-8 text-center text-muted-foreground">
                        No transactions recorded yet. Completed bookings will appear here.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
