@* Site Header Navigation *@
@{
    var transparentHeader = ViewData["TransparentHeader"] as bool? ?? false;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<header class="@(transparentHeader ? "absolute inset-x-0 top-0 z-40 text-primary-foreground" : "sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur")">
    <div class="container-page flex h-16 items-center justify-between gap-4">
        <partial name="_Logo" />

        <!-- Desktop Navigation -->
        <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
            <a asp-controller="Search" asp-action="Index" class="@(transparentHeader ? "rounded-full px-4 py-2 text-sm font-medium opacity-80 transition-opacity hover:opacity-100" : "rounded-full px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground") @(currentAction == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Search" ? (transparentHeader ? "opacity-100" : "bg-secondary text-foreground") : "")">
                Explore
            </a>
            <a asp-controller="Bookings" asp-action="Index" class="@(transparentHeader ? "rounded-full px-4 py-2 text-sm font-medium opacity-80 transition-opacity hover:opacity-100" : "rounded-full px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground") @(currentAction == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Bookings" ? (transparentHeader ? "opacity-100" : "bg-secondary text-foreground") : "")">
                My bookings
            </a>
            <a asp-controller="Favorites" asp-action="Index" class="@(transparentHeader ? "rounded-full px-4 py-2 text-sm font-medium opacity-80 transition-opacity hover:opacity-100" : "rounded-full px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground") @(currentAction == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Favorites" ? (transparentHeader ? "opacity-100" : "bg-secondary text-foreground") : "")">
                Favorites
            </a>
        </nav>

        <div class="flex items-center gap-2">
            <!-- Become a Host Button -->
            <a asp-controller="Host" asp-action="Index" class="@(transparentHeader ? "hidden rounded-full text-primary-foreground hover:bg-primary-foreground/15 hover:text-primary-foreground lg:inline-flex px-4 py-2 text-sm font-medium" : "hidden rounded-full inline-flex lg:inline-flex px-4 py-2 text-sm font-medium hover:bg-secondary")">
                Become a Host
            </a>

            <!-- User Menu Dropdown -->
            <div class="@(transparentHeader ? "hidden h-11 gap-2 rounded-full border border-primary-foreground/40 bg-transparent pl-3 pr-2 text-primary-foreground hover:bg-primary-foreground/15 md:inline-flex items-center" : "hidden h-11 gap-2 rounded-full border border-border bg-background pl-3 pr-2 md:inline-flex items-center")">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                <div class="size-7 rounded-full bg-primary text-xs text-primary-foreground flex items-center justify-center font-semibold">NR</div>
            </div>

            <!-- Mobile Menu Button -->
            <button class="md:hidden size-11 rounded-full border border-border bg-background flex items-center justify-center hover:bg-secondary">
                <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>
    </div>
</header>
