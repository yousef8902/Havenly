<!-- Interactive User/Host Profile Quick-View Modal -->
<div id="userProfileModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity" onclick="closeProfileModal()"></div>

    <!-- Modal Card (Pure White Luxury Card) -->
    <div class="relative w-full max-w-lg rounded-3xl border border-gray-200 bg-white text-gray-900 p-6 sm:p-8 shadow-2xl z-10 space-y-5 max-h-[90vh] overflow-y-auto" style="background-color: #ffffff !important; color: #111827 !important;">
        <!-- Close button -->
        <button type="button" onclick="closeProfileModal()" class="absolute top-5 right-5 rounded-full p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition" aria-label="Close">
            <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <!-- Loading Spinner -->
        <div id="profileModalLoading" class="py-12 flex flex-col items-center justify-center gap-3 text-gray-400">
            <svg class="size-8 animate-spin text-[#0d9488]" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            <p class="text-xs font-semibold text-gray-500">Loading profile details...</p>
        </div>

        <!-- Content (Hidden while loading) -->
        <div id="profileModalContent" class="hidden space-y-5">
            <!-- Header with Avatar and Basic Info -->
            <div class="flex items-center gap-4 sm:gap-5">
                <div class="relative size-20 rounded-full bg-gray-100 border-2 border-gray-200 overflow-hidden flex-shrink-0 flex items-center justify-center text-2xl font-bold text-[#0d9488] shadow-sm">
                    <img id="pmAvatar" src="" alt="Profile photo" class="size-full object-cover hidden" />
                    <span id="pmAvatarFallback">G</span>
                </div>
                <div class="space-y-1">
                    <div class="flex flex-wrap items-center gap-2">
                        <h3 id="pmName" class="text-xl font-bold tracking-tight text-gray-900">User Name</h3>
                        <span id="pmRoleBadge" class="rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">Guest</span>
                        <span id="pmRatingBadge" class="hidden rounded-full bg-amber-50 border border-amber-200 px-2.5 py-0.5 text-xs font-semibold text-amber-700">⭐ 5.00 Host</span>
                    </div>
                    <p id="pmJoined" class="text-xs text-gray-500 flex items-center gap-1.5">
                        <svg class="size-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        Member since September 2026
                    </p>
                </div>
            </div>

            <!-- Contact Card -->
            <div class="rounded-2xl border border-gray-200 bg-white p-4 space-y-2 text-xs">
                <div class="flex items-center justify-between text-gray-500">
                    <span class="flex items-center gap-2">
                        <svg class="size-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        Email:
                    </span>
                    <span id="pmEmail" class="font-medium text-gray-900">email@example.com</span>
                </div>
                <div id="pmPhoneRow" class="flex items-center justify-between text-gray-500 pt-1 border-t border-gray-100">
                    <span class="flex items-center gap-2">
                        <svg class="size-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        Phone:
                    </span>
                    <span id="pmPhone" class="font-medium text-gray-900">+201001234567</span>
                </div>
            </div>

            <!-- About Section -->
            <div id="pmBioContainer" class="space-y-1.5">
                <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500">About</h4>
                <div class="p-4 rounded-2xl border border-gray-200 bg-white text-sm text-gray-800 leading-relaxed">
                    <p id="pmBio"></p>
                </div>
            </div>

            <!-- Host Featured Listings (if host) -->
            <div id="pmHostPropertiesContainer" class="space-y-2.5 hidden">
                <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500">Featured Listings</h4>
                <div id="pmHostPropertiesList" class="space-y-2"></div>
            </div>

            <!-- Guest Stays Preview (if guest) -->
            <div id="pmGuestStaysContainer" class="space-y-2.5 hidden">
                <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500">Recent Stays</h4>
                <div id="pmGuestStaysList" class="space-y-2"></div>
            </div>

            <!-- Footer / Full Profile Link -->
            <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                <button type="button" onclick="closeProfileModal()" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition">
                    Close
                </button>
                <a id="pmFullProfileBtn" href="#" class="rounded-full bg-[#0d9488] px-6 py-2.5 text-sm font-semibold text-white shadow hover:bg-[#0f766e] transition flex items-center gap-1.5" style="background-color: #0d9488 !important; color: #ffffff !important;">
                    View Full Profile →
                </a>
            </div>
        </div>
    </div>
</div>

<script>
async function openProfileModal(userId) {
    if (!userId) return;
    
    const modal = document.getElementById('userProfileModal');
    const loading = document.getElementById('profileModalLoading');
    const content = document.getElementById('profileModalContent');
    
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    loading.classList.remove('hidden');
    content.classList.add('hidden');
    
    try {
        const response = await fetch(`/Account/GetProfileSummary?id=${encodeURIComponent(userId)}`);
        if (!response.ok) {
            alert('Could not load user profile.');
            closeProfileModal();
            return;
        }
        
        const data = await response.json();
        
        document.getElementById('pmName').textContent = data.name || 'User';
        document.getElementById('pmRoleBadge').textContent = data.role || 'Guest';
        document.getElementById('pmJoined').innerHTML = `<svg class="size-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg> Member since ${data.joinedDate || '2026'}`;
        document.getElementById('pmEmail').textContent = data.email || 'N/A';
        
        // Phone
        const phoneRow = document.getElementById('pmPhoneRow');
        if (data.phoneNumber) {
            document.getElementById('pmPhone').textContent = data.phoneNumber;
            phoneRow.classList.remove('hidden');
        } else {
            phoneRow.classList.add('hidden');
        }
        
        // Avatar
        const avatarImg = document.getElementById('pmAvatar');
        const fallback = document.getElementById('pmAvatarFallback');
        if (data.profilePictureUrl) {
            avatarImg.src = data.profilePictureUrl;
            avatarImg.classList.remove('hidden');
            fallback.classList.add('hidden');
        } else {
            avatarImg.classList.add('hidden');
            fallback.textContent = (data.name ? data.name[0] : 'U').toUpperCase();
            fallback.classList.remove('hidden');
        }
        
        // Bio
        const bioContainer = document.getElementById('pmBioContainer');
        const bioText = document.getElementById('pmBio');
        if (data.bio && data.bio.trim().length > 0) {
            bioText.textContent = data.bio;
            bioContainer.classList.remove('hidden');
        } else {
            bioText.textContent = data.role === 'Host' 
                ? 'Curated host offering distinctive stays across Egypt.' 
                : 'Havenly traveler exploring boutique stays and coastal escapes across Egypt.';
            bioContainer.classList.remove('hidden');
        }
        
        // Host vs Guest Stats & Previews
        const ratingBadge = document.getElementById('pmRatingBadge');
        const propContainer = document.getElementById('pmHostPropertiesContainer');
        const propList = document.getElementById('pmHostPropertiesList');
        const staysContainer = document.getElementById('pmGuestStaysContainer');
        const staysList = document.getElementById('pmGuestStaysList');
        
        if (data.role === 'Host') {
            ratingBadge.textContent = `⭐ ${(data.averageRating || 5.0).toFixed(2)} Host`;
            ratingBadge.classList.remove('hidden');
            
            staysContainer.classList.add('hidden');
            
            if (data.properties && data.properties.length > 0) {
                propList.innerHTML = data.properties.map(p => `
                    <div class="flex items-center justify-between p-3 rounded-2xl border border-gray-200 bg-white">
                        <div class="flex items-center gap-3">
                            <img src="${p.imageUrl}" class="size-12 rounded-xl object-cover flex-shrink-0" />
                            <div>
                                <h5 class="font-bold text-sm text-gray-900 line-clamp-1">${p.propertyName}</h5>
                                <p class="text-xs text-gray-500">${p.city}, ${p.country}</p>
                            </div>
                        </div>
                        <div class="font-bold text-sm text-[#0d9488]">${p.price} EGP<span class="font-normal text-xs text-gray-500">/nt</span></div>
                    </div>
                `).join('');
                propContainer.classList.remove('hidden');
            } else {
                propContainer.classList.add('hidden');
            }
        } else {
            ratingBadge.classList.add('hidden');
            propContainer.classList.add('hidden');
            
            if (data.guestStays && data.guestStays.length > 0) {
                staysList.innerHTML = data.guestStays.map(s => `
                    <div class="flex items-center justify-between p-3 rounded-2xl border border-gray-200 bg-white">
                        <div class="flex items-center gap-3">
                            <img src="${s.imageUrl}" class="size-12 rounded-xl object-cover flex-shrink-0" />
                            <div>
                                <h5 class="font-bold text-sm text-gray-900 line-clamp-1">${s.propertyName}</h5>
                                <p class="text-xs text-gray-500">${s.city}, ${s.country}</p>
                            </div>
                        </div>
                        <span class="rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 px-2.5 py-0.5 text-xs font-semibold">
                            ${s.status}
                        </span>
                    </div>
                `).join('');
                staysContainer.classList.remove('hidden');
            } else {
                staysContainer.classList.add('hidden');
            }
        }
        
        document.getElementById('pmFullProfileBtn').href = `/Account/ViewProfile/${encodeURIComponent(data.userId)}`;
        
        loading.classList.add('hidden');
        content.classList.remove('hidden');
    } catch (err) {
        console.error('Error loading profile:', err);
        alert('An error occurred while loading profile.');
        closeProfileModal();
    }
}

function closeProfileModal() {
    const modal = document.getElementById('userProfileModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}
</script>
