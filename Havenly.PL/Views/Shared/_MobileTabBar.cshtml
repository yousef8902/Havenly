@* Mobile Tab Bar - Shown only on mobile below main content *@
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<nav class="fixed bottom-0 left-0 right-0 border-t border-border bg-background md:hidden z-40">
    <div class="flex items-center justify-around">
        <!-- Explore Tab -->
        <a asp-controller="Property" asp-action="Index" class="flex flex-1 flex-col items-center justify-center gap-1 px-4 py-3 text-xs font-medium @(currentController == "Property" ? "text-primary font-semibold" : "text-muted-foreground") hover:text-foreground">
            <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <span>Explore</span>
        </a>

        <!-- My Bookings Tab -->
        <a asp-controller="Booking" asp-action="MyBookings" class="flex flex-1 flex-col items-center justify-center gap-1 px-4 py-3 text-xs font-medium @(currentController == "Booking" ? "text-primary font-semibold" : "text-muted-foreground") hover:text-foreground">
            <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span>Bookings</span>
        </a>

        <!-- Favorites Tab -->
        <a asp-controller="Favorites" asp-action="Index" class="flex flex-1 flex-col items-center justify-center gap-1 px-4 py-3 text-xs font-medium @(currentController == "Favorites" ? "text-primary font-semibold" : "text-muted-foreground") hover:text-foreground">
            <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
            <span>Favorites</span>
        </a>

        <!-- Account Tab -->
        <a asp-controller="Account" asp-action="Profile" class="flex flex-1 flex-col items-center justify-center gap-1 px-4 py-3 text-xs font-medium @(currentController == "Account" ? "text-primary font-semibold" : "text-muted-foreground") hover:text-foreground">
            <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            <span>Profile</span>
        </a>
    </div>
</nav>
