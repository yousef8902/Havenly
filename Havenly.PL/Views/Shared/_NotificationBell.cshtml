@* Reusable In-App Notification Bell & Dropdown *@
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf

<div class="relative" id="notificationBellContainer">
    <!-- Bell Trigger Button -->
    <button type="button"
            id="notificationBellBtn"
            onclick="toggleNotificationDropdown()"
            aria-label="Notifications"
            class="relative inline-flex size-10 items-center justify-center rounded-full border border-border bg-card text-muted-foreground hover:bg-secondary hover:text-foreground transition shadow-xs focus:outline-none focus:ring-2 focus:ring-primary/40">
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>

        <!-- Unread Badge -->
        <span id="notificationBadge"
              class="hidden absolute -top-1 -right-1 size-5 rounded-full bg-rose-500 text-white text-[10px] font-bold items-center justify-center shadow-xs animate-pulse">
            0
        </span>
    </button>

    <!-- Notification Dropdown Panel -->
    <div id="notificationDropdown"
         class="hidden absolute right-0 mt-2 w-80 sm:w-96 rounded-2xl border border-border bg-card text-card-foreground shadow-2xl z-50 overflow-hidden transform transition-all duration-150">
        
        <!-- Header -->
        <div class="flex items-center justify-between border-b border-border bg-muted/30 px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-bold text-sm text-foreground">Notifications</span>
                <span id="unreadHeaderCount" class="hidden rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary">0 new</span>
            </div>
            <button type="button"
                    onclick="markAllNotificationsAsRead()"
                    class="text-[11px] font-semibold text-primary hover:underline hover:text-primary/80 transition">
                Mark all as read
            </button>
        </div>

        <!-- Notification List -->
        <div id="notificationList" class="max-h-96 overflow-y-auto divide-y divide-border">
            <div class="p-8 text-center text-muted-foreground">
                <div class="inline-block animate-spin size-5 border-2 border-primary border-t-transparent rounded-full mb-2"></div>
                <p class="text-xs">Loading notifications...</p>
            </div>
        </div>

        <!-- Footer -->
        <div class="border-t border-border bg-muted/20 px-4 py-2 text-center">
            <button type="button" onclick="closeNotificationDropdown()" class="text-[11px] font-medium text-muted-foreground hover:text-foreground">
                Close
            </button>
        </div>
    </div>
</div>

<script>
    (function () {
        let isOpen = false;
        const container = document.getElementById('notificationBellContainer');
        const dropdown = document.getElementById('notificationDropdown');
        const badge = document.getElementById('notificationBadge');
        const headerCount = document.getElementById('unreadHeaderCount');
        const list = document.getElementById('notificationList');

        // Fetch anti-forgery token from form or cookie
        function getAntiForgeryToken() {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        window.toggleNotificationDropdown = function () {
            if (isOpen) {
                closeNotificationDropdown();
            } else {
                openNotificationDropdown();
            }
        };

        window.openNotificationDropdown = function () {
            dropdown.classList.remove('hidden');
            isOpen = true;
            fetchNotifications();
        };

        window.closeNotificationDropdown = function () {
            dropdown.classList.add('hidden');
            isOpen = false;
        };

        // Close on click outside
        document.addEventListener('click', function (e) {
            if (isOpen && container && !container.contains(e.target)) {
                closeNotificationDropdown();
            }
        });

        // Fetch unread count on page load
        async function fetchUnreadCount() {
            try {
                const res = await fetch('/Notification/UnreadCount');
                if (res.ok) {
                    const data = await res.json();
                    updateBadge(data.unreadCount || 0);
                }
            } catch (err) {
                console.warn('Failed to load notification count', err);
            }
        }

        function updateBadge(count) {
            if (count > 0) {
                badge.textContent = count > 99 ? '99+' : count;
                badge.classList.remove('hidden');
                badge.classList.add('flex');
                headerCount.textContent = `${count} new`;
                headerCount.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
                badge.classList.remove('flex');
                headerCount.classList.add('hidden');
            }
        }

        // Fetch list of notifications
        async function fetchNotifications() {
            try {
                const res = await fetch('/Notification/GetDropdown');
                if (!res.ok) throw new Error('Network error');
                const data = await res.json();

                updateBadge(data.unreadCount || 0);

                if (!data.notifications || data.notifications.length === 0) {
                    list.innerHTML = `
                        <div class="p-8 text-center text-muted-foreground">
                            <div class="text-3xl mb-2">✨</div>
                            <p class="font-semibold text-sm text-foreground">You're all caught up!</p>
                            <p class="text-xs mt-0.5">No notifications right now.</p>
                        </div>
                    `;
                    return;
                }

                let html = '';
                data.notifications.forEach(n => {
                    const unreadClass = n.isRead ? 'bg-card opacity-85' : 'bg-primary/5 font-semibold';
                    const dotClass = n.isRead ? 'hidden' : 'size-2 rounded-full bg-primary flex-shrink-0';
                    const target = n.targetUrl ? n.targetUrl : '#';

                    // Pick emoji based on icon type
                    let emoji = 'ℹ️';
                    if (n.iconType === 'booking') emoji = '📅';
                    else if (n.iconType === 'approval') emoji = '🎉';
                    else if (n.iconType === 'payout') emoji = '💰';
                    else if (n.iconType === 'alert') emoji = '⚠️';

                    html += `
                        <div onclick="handleNotificationClick(${n.notificationId}, '${target}')"
                             class="p-3.5 hover:bg-muted/50 transition cursor-pointer flex items-start gap-3 ${unreadClass}">
                            <div class="size-8 rounded-xl bg-muted flex items-center justify-center text-base flex-shrink-0 shadow-2xs">
                                ${emoji}
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-1">
                                    <h4 class="text-xs font-bold text-foreground truncate">${escapeHtml(n.title)}</h4>
                                    <span class="text-[10px] text-muted-foreground flex-shrink-0">${escapeHtml(n.timeAgo)}</span>
                                </div>
                                <p class="text-xs text-muted-foreground line-clamp-2 mt-0.5 leading-snug">${escapeHtml(n.message)}</p>
                            </div>
                            <span class="${dotClass}"></span>
                        </div>
                    `;
                });

                list.innerHTML = html;
            } catch (err) {
                list.innerHTML = `
                    <div class="p-6 text-center text-xs text-muted-foreground">
                        Failed to load notifications. Please try again.
                    </div>
                `;
            }
        }

        window.handleNotificationClick = async function (id, targetUrl) {
            try {
                await fetch(`/Notification/MarkRead/${id}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken()
                    }
                });
            } catch (e) { }

            if (targetUrl && targetUrl !== '#') {
                window.location.href = targetUrl;
            } else {
                fetchNotifications();
            }
        };

        window.markAllNotificationsAsRead = async function () {
            try {
                const res = await fetch('/Notification/MarkAllRead', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken()
                    }
                });
                if (res.ok) {
                    updateBadge(0);
                    fetchNotifications();
                }
            } catch (err) {
                console.error('Failed to mark all as read', err);
            }
        };

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        // Initialize on load & periodic background refresh
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function () {
                fetchUnreadCount();
                setInterval(fetchUnreadCount, 25000);
            });
        } else {
            fetchUnreadCount();
            setInterval(fetchUnreadCount, 25000);
        }
    })();
</script>
