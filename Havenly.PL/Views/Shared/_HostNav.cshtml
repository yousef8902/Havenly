@* Host Workspace Navigation *@

<nav class="flex flex-col gap-1" aria-label="Workspace">
    <a asp-controller="Host" asp-action="Index" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm text-muted-foreground transition-colors hover:bg-sidebar-accent hover:text-foreground @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Host" ? "bg-sidebar-accent text-sidebar-accent-foreground font-semibold" : "")">
        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-3m0 0l7-4 7 4M5 9v10a1 1 0 001 1h12a1 1 0 001-1V9m-9 16l4-4m0 0l4 4m-4-4V9"></path>
        </svg>
        Overview
    </a>

    <a asp-controller="Host" asp-action="ListProperties" class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm text-muted-foreground transition-colors hover:bg-sidebar-accent hover:text-foreground @(ViewContext.RouteData.Values["action"]?.ToString() == "ListProperties" && ViewContext.RouteData.Values["controller"]?.ToString() == "Host" ? "bg-sidebar-accent text-sidebar-accent-foreground font-semibold" : "")">
        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
