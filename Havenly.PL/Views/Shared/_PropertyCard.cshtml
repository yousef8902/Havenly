@model Havenly.BLL.ModelVMs.PropertyCardVM

<article class="group relative overflow-hidden rounded-xl border border-border bg-surface transition-shadow hover:shadow-lift">
    <!-- Image & Top Badge Floating Header -->
    <div class="relative aspect-4/3 overflow-hidden bg-secondary">
        <img src="@(Model.ImageUrl?? "/images/p1.jpg")"
             alt="@Model.Title"
             loading="lazy"
             width="1200"
             height="900"
             class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />

        <!-- Favorite Button -->
        <button type="button"
                aria-label="Save to favorites"
                class="absolute right-3 top-3 grid size-11 place-items-center rounded-full bg-card/90 text-foreground backdrop-blur transition-colors hover:bg-card">
            <i data-lucide="heart" class="size-5"></i>
        </button>

        <!-- Dynamic Badge (e.g., Guest Favourite) -->
        @if (ViewData["Badge"] != null)
        {
            <span class="absolute left-3 top-3 rounded-full bg-surface/95 px-3 py-1 text-xs font-semibold text-foreground backdrop-blur">
                @ViewData["Badge"]
            </span>
        }
    </div>

    <!-- Content Body -->
    <div class="space-y-2 p-4">
        <div class="flex items-start justify-between gap-3">
            <h3 class="text-base font-semibold leading-snug">
                <a asp-controller="Booking" asp-action="Create" asp-route-listingId="@Model.Id" 
                   asp-route-propertyName="@Model.Title" asp-route-pricePerNight="@Model.Price"
                   asp-route-maxGuests="@Model.MaxGuests"
                   class="after:absolute after:inset-0 after:content-['']">
                    @Model.Title
                </a>
            </h3>
            <div class="shrink-0 pt-0.5 flex items-center gap-1 text-xs font-semibold">
                <i data-lucide="star" class="size-3.5 fill-accent text-accent"></i>
                <span>4.96</span>
            </div>
        </div>

        <p class="flex items-center gap-1 text-sm text-muted-foreground">
            <i data-lucide="map-pin" class="size-4 shrink-0" aria-hidden="true"></i>
            @Model.City
        </p>

        <div class="flex items-center justify-between pt-1">
            <span class="inline-flex items-center gap-1.5 text-sm text-muted-foreground">
                <i data-lucide="users" class="size-4" aria-hidden="true"></i>
                @Model.MaxGuests guests
            </span>
            <span class="text-sm text-muted-foreground">
                <span class="text-base font-semibold text-foreground">$@Model.Price</span> / night
            </span>
        </div>
    </div>
</article>