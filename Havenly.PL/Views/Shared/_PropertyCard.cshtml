@model Havenly.BLL.ModelVMs.PropertyCardVM

<article class="group relative overflow-hidden rounded-xl border border-border bg-surface transition-shadow hover:shadow-lift">
    <!-- Image & Top Badge Floating Header -->
    <div class="relative aspect-4/3 overflow-hidden bg-secondary">
        <img src="@(Model.ImageUrl?? "/images/p1.jpg")"
             alt="@Model.Title"
             loading="lazy"
             width="1200"
             height="900"
             class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />

        <!-- Favorite Button Form -->
        <form asp-controller="Favorites" asp-action="Toggle" method="post" class="absolute right-3 top-3 z-10">
            @Html.AntiForgeryToken()
            <input type="hidden" name="listingId" value="@Model.Id" />
            <button type="submit"
                    aria-label="Save to favorites"
                    class="grid size-10 place-items-center rounded-full bg-card/90 text-foreground backdrop-blur transition-colors hover:bg-card shadow-sm">
                <svg class="size-5 @(Model.IsFavorite ? "fill-red-500 text-red-500" : "text-foreground")" fill="@(Model.IsFavorite ? "currentColor" : "none")" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
            </button>
        </form>

        <!-- Dynamic Badge / Category Pill -->
        <span class="absolute left-3 top-3 rounded-full bg-surface/95 px-3 py-1 text-xs font-semibold text-foreground backdrop-blur shadow-sm">
            @(ViewData["Badge"]?.ToString() ?? (string.IsNullOrEmpty(Model.Category) ? "Design homes" : Model.Category))
        </span>
    </div>

    <!-- Content Body -->
    <div class="space-y-2 p-4">
        <div class="flex items-start justify-between gap-3">
            <h3 class="text-base font-semibold leading-snug">
                <a asp-controller="Property" asp-action="Detail" asp-route-id="@Model.Id" 
                   class="after:absolute after:inset-0 after:content-[''] hover:underline">
                    @Model.Title
                </a>
            </h3>
            <div class="shrink-0 pt-0.5 flex items-center gap-1 text-xs font-semibold">
                <svg class="size-3.5 fill-amber-500 text-amber-500" viewBox="0 0 24 24">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
                </svg>
                <span>@(Model.Rating > 0 ? Model.Rating.ToString("F1") : "New")</span>
            </div>
        </div>

        <p class="flex items-center gap-1 text-sm text-muted-foreground">
            <svg class="size-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            @Model.City, @Model.Country
        </p>

        <div class="flex items-center justify-between pt-1">
            <span class="inline-flex items-center gap-1.5 text-sm text-muted-foreground">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                @Model.MaxGuests guests
            </span>
            <span class="text-sm text-muted-foreground">
                <span class="text-base font-semibold text-foreground">@Model.Price EGP</span> / night
            </span>
        </div>
    </div>
</article>