@model Havenly.BLL.ModelVMs.PropertyCardVM

<a asp-controller="Property" asp-action="Details" asp-route-id="@Model.Id" class="group block overflow-hidden rounded-2xl border border-border hover:border-primary hover:shadow-lg transition-all">
    <!-- Image Container -->
    <div class="relative h-48 overflow-hidden bg-muted">
        <img src="@Model.ImageUrl" alt="@Model.Title" class="h-full w-full object-cover transition-transform group-hover:scale-105" />

        @if (!string.IsNullOrEmpty(Model.Badge))
        {
            <div class="absolute left-3 top-3">
                <span class="inline-flex items-center rounded-full bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground">
                    @Model.Badge
                </span>
            </div>
        }

        <!-- Favorite Button -->
        <button type="button" class="absolute right-3 top-3 rounded-full bg-background/80 p-2 backdrop-blur hover:bg-background" data-property-id="@Model.Id" data-toggle-favorite="true">
            <svg class="size-5 @(Model.IsFavorite ? "fill-red-500 text-red-500" : "text-muted-foreground")" fill="@(Model.IsFavorite ? "currentColor" : "none")" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
        </button>
    </div>

    <!-- Content -->
    <div class="p-4 space-y-3">
        <!-- Title & Location -->
        <div>
            <h3 class="font-semibold line-clamp-2 group-hover:text-primary">@Model.Title</h3>
            <p class="text-sm text-muted-foreground">@Model.City, @Model.Country</p>
        </div>

        <!-- Rating -->
        <div class="flex items-center gap-1">
            <div class="flex gap-0.5">
                @for (int i = 0; i < 5; i++)
                {
                    <svg class="size-4 @(i < (int)Model.Rating ? "fill-yellow-400 text-yellow-400" : "text-muted")" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15l-3.255 1.716A1 1 0 005.882 15.23l.636-3.7a1 1 0 00-.288-1.112L2.696 9.5a1 1 0 00.553-1.697l3.738-.543 1.67-3.372a1 1 0 011.8 0l1.67 3.372 3.738.543a1 1 0 00.553 1.697l-2.704 2.364a1 1 0 00-.288 1.112l.636 3.7a1 1 0 01-1.537 1.055L12 15z"></path>
                    </svg>
                }
            </div>
            <span class="text-sm font-medium">@Model.Rating.ToString("F1")</span>
            <span class="text-sm text-muted-foreground">(@Model.Reviews)</span>
        </div>

        <!-- Details -->
        <div class="flex gap-4 py-2 text-sm text-muted-foreground">
            <div class="flex items-center gap-1">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-3.488M15 7a3 3 0 11-6 0 3 3 0 016 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                <span>@Model.Guests guests</span>
            </div>
            <div class="flex items-center gap-1">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>@Model.Bedrooms bed@(Model.Bedrooms != 1 ? "s" : "")</span>
            </div>
        </div>

        <!-- Price -->
        <div class="border-t border-border pt-3">
            <p class="text-sm text-muted-foreground">
                <span class="font-bold text-foreground">${@Model.Price}</span> per night
            </p>
        </div>
    </div>
</a>
