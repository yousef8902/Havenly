@model Havenly.BLL.ModelVMs.BookingsPageVM

@{
    ViewData["Title"] = "My bookings — Havenly";
    ViewData["Description"] = "Track upcoming, pending, completed and cancelled Havenly stays.";
}

<div class="container-page py-12 space-y-8">
    <div>
        <h1 class="text-3xl md:text-4xl font-bold">My bookings</h1>
        <p class="mt-1 text-muted-foreground">
            Every request you've made, grouped by where it is in the process.
        </p>
    </div>

    <!-- Tabs -->
    <div class="space-y-6">
        <div class="flex gap-2 border-b border-border overflow-x-auto">
            <a href="?status=approved" class="px-4 py-2 font-medium border-b-2 border-transparent hover:border-primary text-muted-foreground hover:text-foreground whitespace-nowrap">
                Upcoming <span class="ml-1.5 text-xs text-muted-foreground">@Model.Bookings.Count(b => b.Status == "approved")</span>
            </a>
            <a href="?status=pending" class="px-4 py-2 font-medium border-b-2 border-transparent hover:border-primary text-muted-foreground hover:text-foreground whitespace-nowrap">
                Pending <span class="ml-1.5 text-xs text-muted-foreground">@Model.Bookings.Count(b => b.Status == "pending")</span>
            </a>
            <a href="?status=completed" class="px-4 py-2 font-medium border-b-2 border-transparent hover:border-primary text-muted-foreground hover:text-foreground whitespace-nowrap">
                Completed <span class="ml-1.5 text-xs text-muted-foreground">@Model.Bookings.Count(b => b.Status == "completed")</span>
            </a>
            <a href="?status=cancelled" class="px-4 py-2 font-medium border-b-2 border-transparent hover:border-primary text-muted-foreground hover:text-foreground whitespace-nowrap">
                Cancelled <span class="ml-1.5 text-xs text-muted-foreground">@Model.Bookings.Count(b => b.Status == "cancelled")</span>
            </a>
        </div>

        @{
            var status = Context.Request.Query["status"].ToString() ?? "approved";
            var bookings = Model.Bookings.Where(b => b.Status == status).ToList();
        }

        @if (bookings.Any())
        {
            <div class="space-y-4">
                @foreach (var booking in bookings)
                {
                    <div class="rounded-2xl border border-border bg-card p-4 md:p-6">
                        <div class="grid gap-4 md:grid-cols-[auto_1fr_auto]">
                            <!-- Property Image -->
                            <div class="h-24 w-24 flex-shrink-0 overflow-hidden rounded-lg bg-muted">
                                <img src="@booking.ImageUrl" alt="@booking.Title" class="h-full w-full object-cover" />
                            </div>

                            <!-- Property Details -->
                            <div class="space-y-2">
                                <a asp-controller="Property" asp-action="Details" asp-route-id="@booking.PropertyId" class="font-semibold hover:text-primary">
                                    @booking.Title
                                </a>
                                <p class="text-sm text-muted-foreground">@booking.City, @booking.Country</p>

                                <div class="flex flex-wrap gap-4 pt-2 text-sm text-muted-foreground">
                                    <div class="flex items-center gap-1">
                                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                        <span>@booking.CheckIn.ToString("MMM dd") – @booking.CheckOut.ToString("MMM dd")</span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-3.488M15 7a3 3 0 11-6 0 3 3 0 016 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                        <span>@booking.Guests guest@(booking.Guests != 1 ? "s" : "")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Status & Price -->
                            <div class="flex flex-col items-end justify-between">
                                <div class="space-y-2">
                                    <div class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold"
                                         style="background-color: @GetStatusColor(booking.Status); color: @GetStatusTextColor(booking.Status);">
                                        @GetStatusLabel(booking.Status)
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm text-muted-foreground">Total</p>
                                        <p class="font-semibold">$@booking.Total</p>
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="flex gap-2">
                                    @if (booking.Status == "approved" || booking.Status == "pending")
                                    {
                                        <form asp-controller="Bookings" asp-action="CancelBooking" method="post" class="inline" 
                                              onsubmit="return confirm('Cancel this booking?');">
                                            <input type="hidden" name="id" value="@booking.Id" />
                                            <button type="submit" class="rounded-lg border border-border px-3 py-1 text-sm hover:bg-destructive/10 hover:text-destructive">
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                    @if (booking.Status == "completed")
                                    {
                                        <a asp-controller="Reviews" asp-action="Create" asp-route-propertyId="@booking.PropertyId" asp-route-bookingId="@booking.Id"
                                           class="rounded-lg bg-primary px-3 py-1 text-sm font-medium text-primary-foreground hover:bg-primary/90">
                                            Review
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-border py-16">
                <svg class="size-12 text-muted-foreground mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <h3 class="text-lg font-semibold mb-2">No @status.ToLower() bookings</h3>
                <p class="text-sm text-muted-foreground text-center max-w-md mb-4">
                    When a booking reaches this stage, you'll find it here with all its details.
                </p>
                <a asp-controller="Search" asp-action="Index" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90">
                    Find a stay
                </a>
            </div>
        }
    </div>
</div>

@functions {
    private string GetStatusLabel(string status)
    {
        return status switch
        {
            "approved" => "Upcoming",
            "pending" => "Pending",
            "completed" => "Completed",
            "cancelled" => "Cancelled",
            _ => status
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "approved" => "hsl(var(--primary) / 0.1)",
            "pending" => "hsl(200 100% 60% / 0.1)",
            "completed" => "hsl(120 100% 50% / 0.1)",
            "cancelled" => "hsl(0 100% 50% / 0.1)",
            _ => "hsl(var(--secondary))"
        };
    }

    private string GetStatusTextColor(string status)
    {
        return status switch
        {
            "approved" => "hsl(var(--primary))",
            "pending" => "hsl(200 100% 40%)",
            "completed" => "hsl(120 100% 35%)",
            "cancelled" => "hsl(0 100% 40%)",
            _ => "hsl(var(--foreground))"
        };
    }
}
