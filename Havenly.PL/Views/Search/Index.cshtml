@model Havenly.BLL.ModelVMs.SearchPageVM;

@{
    ViewData["Title"] = "Search stays — Havenly";
    ViewData["Description"] = "Filter Havenly stays by city, price, guests, rooms, rating and amenities.";
}

<div class="container-page pt-6 space-y-8">
    <!-- Search Bar -->
    <form asp-controller="Search" asp-action="Index" method="get" class="space-y-3">
        <div class="grid gap-4 rounded-2xl bg-card border border-border p-5 sm:grid-cols-2 md:grid-cols-4">
            <div class="flex flex-col gap-2">
                <label for="city" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Where</label>
                <input type="text" name="city" id="city" 
                       class="rounded-lg border border-border bg-background px-3 py-2 text-sm" 
                       placeholder="City or destination" 
                       value="@Model.Filters.City" />
            </div>

            <div class="flex flex-col gap-2">
                <label for="checkIn" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Check in</label>
                <input type="date" name="checkIn" id="checkIn" 
                       class="rounded-lg border border-border bg-background px-3 py-2 text-sm" 
                       value="@Model.Filters.CheckIn?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="flex flex-col gap-2">
                <label for="checkOut" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Check out</label>
                <input type="date" name="checkOut" id="checkOut" 
                       class="rounded-lg border border-border bg-background px-3 py-2 text-sm" 
                       value="@Model.Filters.CheckOut?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="flex flex-col gap-2">
                <label for="guests" class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Guests</label>
                <select name="guests" id="guests" class="rounded-lg border border-border bg-background px-3 py-2 text-sm">
                     <option value="1" selected="@(Model.Filters.Guests == 1 ? "selected" : null)">1 guest</option>
                    <option value="2" selected="@(Model.Filters.Guests == 2 ? "selected" : null)">2 guests</option>
                    <option value="3" selected="@(Model.Filters.Guests == 3 ? "selected" : null)">3 guests</option>
                    <option value="4" selected="@(Model.Filters.Guests >= 4 ? "selected" : null)">4+ guests</option>
                </select>
            </div>
        </div>
        <button type="submit" class="w-full rounded-lg bg-primary px-4 py-2 font-semibold text-primary-foreground hover:bg-primary/90">
            Search
        </button>
    </form>

    <!-- Main Content Grid -->
    <div class="mt-8 grid gap-8 lg:grid-cols-[17rem_1fr]">
        <!-- Filter Sidebar (Desktop) -->
        <aside class="hidden lg:block">
            <div class="sticky top-24 rounded-2xl border border-border bg-card p-5 space-y-6">
                <div>
                    <h3 class="font-semibold mb-3">Price</h3>
                    <div class="space-y-2">
                        <input type="range" name="maxPrice" min="50" max="500" value="450" 
                               class="w-full" onchange="this.form.submit();" />
                        <p class="text-sm text-muted-foreground">Up to $<span id="priceValue">450</span>/night</p>
                    </div>
                </div>

                <div>
                    <h3 class="font-semibold mb-3">Bedrooms</h3>
                    <select name="minRooms" class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" onchange="this.form.submit();">
                        <option value="">Any</option>
                        <option value="1">1+</option>
                        <option value="2">2+</option>
                        <option value="3">3+</option>
                        <option value="4">4+</option>
                    </select>
                </div>

                <div>
                    <h3 class="font-semibold mb-3">Min. rating</h3>
                    <select name="minRating" class="w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" onchange="this.form.submit();">
                        <option value="">Any</option>
                        <option value="4">4.0★+</option>
                        <option value="4.5">4.5★+</option>
                    </select>
                </div>

                <div>
                    <button type="reset" class="w-full text-sm text-primary hover:underline">Clear filters</button>
                </div>
            </div>
        </aside>

        <!-- Results -->
        <div>
            <!-- Results Header -->
            <div class="mb-5 space-y-2">
                <h1 class="text-2xl font-bold">
                    @if (!string.IsNullOrEmpty(Model.Filters.City))
                    {
                        <span>Stays in @Model.Filters.City</span>
                    }
                    else
                    {
                        <span>All stays</span>
                    }
                </h1>
                <p class="text-sm text-muted-foreground">
                    @if (Model.Results != null && Model.Results.Any())
                    {
                        <span>@Model.Results.Count() home@(Model.Results.Count() != 1 ? "s" : "") matching your search</span>
                    }
                    else
                    {
                        <span>No homes found matching your criteria</span>
                    }
                </p>
            </div>

            <!-- Results Grid -->
            @if (Model.Results != null && Model.Results.Any())
            {
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var property in Model.Results.Take(6))
                    {
                        <partial name="_PropertyCard" model="property" />
                    }
                </div>

                <!-- Pagination -->
                @if (Model.PageCount > 1)
                {
                    <div class="mt-8 flex justify-center gap-2">
                        @for (int i = 1; i <= Model.PageCount; i++)
                        {
                            var pageUrl = Url.Action("Index", "Search", new { city = Model.Filters.City, page = i, maxPrice = Model.Filters.MaxPrice, guests = Model.Filters.Guests });
                            <a href="@pageUrl" class="rounded-lg border border-border px-4 py-2 hover:bg-secondary" @(i == Model.Filters.Page ? "aria-current=\"page\"" : "")>@i</a>
                        }
                    </div>
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-border py-16">
                    <svg class="size-12 text-muted-foreground mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    <h3 class="text-lg font-semibold mb-2">No stays found</h3>
                    <p class="text-sm text-muted-foreground text-center max-w-md">
                        Try adjusting your filters or search in a different location to find more options.
                    </p>
                    <a asp-controller="Home" asp-action="Index" class="mt-4 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90">
                        Back to home
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Update price display
        document.querySelector('input[name="maxPrice"]')?.addEventListener('change', function() {
            document.getElementById('priceValue').textContent = this.value;
        });

        // Set initial price value
        document.getElementById('priceValue').textContent = '@(Model.Filters.MaxPrice)';
    </script>
}
