@model Havenly.BLL.ModelVMs.Account.EditProfileVM

@{
    ViewData["Title"] = "Edit profile — Havenly";
}

<div class="container-page py-10 max-w-2xl mx-auto">
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight">Edit profile</h1>
            <p class="text-sm text-muted-foreground mt-0.5">Manage your personal information, avatar, and public bio.</p>
        </div>
        <a asp-action="Profile" class="text-xs font-semibold text-muted-foreground hover:text-foreground">
            ← Back to profile
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-6 rounded-2xl border border-destructive/30 bg-destructive/10 p-4 text-sm font-medium text-destructive">
            <ul class="space-y-1 list-disc list-inside">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="EditProfile" method="post" enctype="multipart/form-data" class="rounded-3xl border border-border bg-card p-6 sm:p-8 shadow-sm space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="CurrentProfilePictureUrl" />

        <!-- Profile Picture Section -->
        <div>
            <label class="block text-sm font-semibold mb-3">Profile photo</label>
            <div class="flex items-center gap-5">
                <div class="relative size-20 rounded-full bg-secondary border-2 border-border overflow-hidden flex-shrink-0 flex items-center justify-center text-2xl font-bold text-primary">
                    <img id="avatarPreview" src="@(string.IsNullOrEmpty(Model.CurrentProfilePictureUrl) ? "" : Model.CurrentProfilePictureUrl)" alt="@Model.Name" class="@(string.IsNullOrEmpty(Model.CurrentProfilePictureUrl) ? "hidden" : "") size-full object-cover" />
                    <span id="avatarPlaceholder" class="@(!string.IsNullOrEmpty(Model.CurrentProfilePictureUrl) ? "hidden" : "")">
                        @(string.IsNullOrWhiteSpace(Model.Name) ? "H" : Model.Name[0].ToString().ToUpper())
                    </span>
                </div>

                <div class="space-y-2">
                    <label for="ProfilePictureFile" class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-border bg-secondary/80 px-4 py-2 text-xs font-semibold hover:bg-secondary transition">
                        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        Choose new photo
                    </label>
                    <input type="file" id="ProfilePictureFile" name="ProfilePictureFile" accept="image/png, image/jpeg, image/webp" class="hidden" onchange="previewAvatar(this)" />
                    <p class="text-xs text-muted-foreground">JPG, PNG, or WebP. Max 5MB.</p>
                </div>
            </div>
        </div>

        <div class="border-t border-border pt-5 space-y-4">
            <!-- Full Name -->
            <div>
                <label asp-for="Name" class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1.5">
                    Full name
                </label>
                <input asp-for="Name" class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-medium focus:border-primary focus:outline-none" required />
                <span asp-validation-for="Name" class="text-xs text-destructive mt-1 block"></span>
            </div>

            <!-- Email (Read-Only) -->
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1.5">
                    Email address (Account ID)
                </label>
                <input type="text" value="@Model.Email" disabled class="w-full rounded-xl border border-border bg-secondary/40 px-4 py-2.5 text-sm font-medium text-muted-foreground cursor-not-allowed" />
            </div>

            <!-- Phone Number -->
            <div>
                <label asp-for="PhoneNumber" class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1.5">
                    Phone number
                </label>
                <input asp-for="PhoneNumber" placeholder="+20 100 123 4567" class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-medium focus:border-primary focus:outline-none" />
                <span asp-validation-for="PhoneNumber" class="text-xs text-destructive mt-1 block"></span>
            </div>

            <!-- Bio -->
            <div>
                <label asp-for="Bio" class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1.5">
                    About you (Bio)
                </label>
                <textarea asp-for="Bio" rows="4" placeholder="Tell hosts and guests a little about yourself, your travels, or your properties..." class="w-full rounded-xl border border-border bg-background p-4 text-sm font-medium focus:border-primary focus:outline-none resize-none"></textarea>
                <span asp-validation-for="Bio" class="text-xs text-destructive mt-1 block"></span>
                <p class="text-xs text-muted-foreground mt-1">This bio will be visible when other hosts or guests view your profile.</p>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-border">
            <a asp-action="Profile" class="rounded-xl border border-border px-5 py-2.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition">
                Cancel
            </a>
            <button type="submit" class="rounded-xl bg-primary px-6 py-2.5 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition">
                Save changes
            </button>
        </div>
    </form>
</div>

<script>
function previewAvatar(input) {
    if (input.files && input.files[0]) {
        const file = input.files[0];
        if (file.size > 5 * 1024 * 1024) {
            alert('Please select an image smaller than 5MB.');
            input.value = '';
            return;
        }

        const reader = new FileReader();
        reader.onload = function (e) {
            const img = document.getElementById('avatarPreview');
            const placeholder = document.getElementById('avatarPlaceholder');
            img.src = e.target.result;
            img.classList.remove('hidden');
            if (placeholder) placeholder.classList.add('hidden');
        };
        reader.readAsDataURL(file);
    }
}
</script>
