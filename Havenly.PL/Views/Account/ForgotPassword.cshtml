@model Havenly.BLL.ModelVMs.Account.ForgotPasswordVM

@{
    ViewData["Title"] = "Forgot Password — Havenly";
}

<div class="container-page py-12">
    <div class="max-w-md mx-auto">
        <div class="rounded-3xl border border-border bg-card p-8 shadow-lift space-y-6">
            <div class="text-center space-y-2">
                <div class="inline-flex size-14 items-center justify-center rounded-2xl bg-amber-500/10 text-amber-600 mb-2">
                    <svg class="size-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                </div>
                <h1 class="text-2xl font-bold tracking-tight">Forgot password?</h1>
                <p class="text-sm text-muted-foreground">
                    Enter the email associated with your account and we'll send you a 6-digit verification code to reset your password.
                </p>
            </div>

            <!-- Dynamic Alert Box -->
            <div id="forgotAlert" class="@(ViewData.ModelState.IsValid && TempData["ErrorMessage"] == null ? "hidden" : "") rounded-2xl border border-destructive/30 bg-destructive/10 p-4 text-sm font-medium text-destructive">
                <ul id="forgotErrorList" class="space-y-1 list-disc list-inside">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <li>@TempData["ErrorMessage"]</li>
                    }
                    @if (!ViewData.ModelState.IsValid)
                    {
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
            </div>

            <form id="forgotForm" asp-action="ForgotPassword" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <div>
                    <label asp-for="Email" class="block text-sm font-semibold mb-1.5">Email Address</label>
                    <input asp-for="Email" id="forgotEmail" type="email" placeholder="name@example.com" class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm focus:border-primary focus:outline-none" autofocus />
                    <span asp-validation-for="Email" class="text-xs text-destructive mt-1 block"></span>
                </div>

                <button type="submit" id="forgotSubmitBtn" class="w-full rounded-xl bg-primary py-3 text-sm font-semibold text-primary-foreground shadow hover:bg-primary/90 transition flex items-center justify-center gap-2">
                    <span id="forgotBtnText">Send Reset Code</span>
                    <svg id="forgotSpinner" class="hidden animate-spin size-4 text-primary-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                </button>
            </form>

            <div class="border-t border-border pt-4 text-center">
                <a asp-action="Login" class="text-sm font-semibold text-primary hover:underline inline-flex items-center gap-1.5">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Back to Log in
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('forgotForm')?.addEventListener('submit', async function (e) {
            e.preventDefault();

            const form = this;
            const alertBox = document.getElementById('forgotAlert');
            const errorList = document.getElementById('forgotErrorList');
            const submitBtn = document.getElementById('forgotSubmitBtn');
            const btnText = document.getElementById('forgotBtnText');
            const spinner = document.getElementById('forgotSpinner');

            alertBox.classList.add('hidden');
            errorList.innerHTML = '';
            submitBtn.disabled = true;
            btnText.textContent = 'Sending code...';
            spinner.classList.remove('hidden');

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                });

                const data = await response.json();

                if (data.success) {
                    btnText.textContent = 'Code Sent!';
                    window.location.href = data.redirectUrl || '/Account/Login';
                } else {
                    submitBtn.disabled = false;
                    btnText.textContent = 'Send Reset Code';
                    spinner.classList.add('hidden');

                    const errors = data.errors || [data.message || 'Could not send reset code.'];
                    errorList.innerHTML = errors.map(err => `<li>${err}</li>`).join('');
                    alertBox.classList.remove('hidden');
                }
            } catch (err) {
                form.submit();
            }
        });
    </script>
}
