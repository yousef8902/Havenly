@{
    ViewData["Title"] = "Host Application Pending Review — Havenly";
    var hostName = (string)(ViewBag.HostName ?? "Host");
    var hostEmail = (string)(ViewBag.HostEmail ?? "");
    var hasDoc = (bool)(ViewBag.HasDoc ?? false);
}

<div class="container-page py-16">
    <div class="max-w-xl mx-auto">
        <div class="rounded-3xl border border-border bg-card p-8 sm:p-10 shadow-lift text-center space-y-6">
            <!-- Icon -->
            <div class="mx-auto inline-flex size-20 items-center justify-center rounded-3xl bg-amber-500/10 text-amber-600 border border-amber-500/20 shadow-sm">
                <svg class="size-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
            </div>

            <!-- Header -->
            <div class="space-y-2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-3.5 py-1 text-xs font-bold text-amber-700 uppercase tracking-wider">
                    <span class="size-2 rounded-full bg-amber-500 animate-pulse"></span>
                    Under Administrative Review
                </span>
                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Your host application is in review</h1>
                <p class="text-sm text-muted-foreground max-w-md mx-auto">
                    Thank you, <strong class="text-foreground">@hostName</strong>! Your email is verified and your identity documents have been submitted to the Havenly moderation team.
                </p>
            </div>

            <!-- Verification Checklist -->
            <div class="rounded-2xl border border-border bg-muted/40 p-5 text-left space-y-3.5 text-sm">
                <div class="flex items-center gap-3 text-emerald-700">
                    <svg class="size-5 flex-shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="font-medium text-foreground">Email address verified (@(string.IsNullOrEmpty(hostEmail) ? "Confirmed" : hostEmail))</span>
                </div>

                <div class="flex items-center gap-3 text-emerald-700">
                    <svg class="size-5 flex-shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="font-medium text-foreground">Government ID / Passport uploaded and encrypted</span>
                </div>

                <div class="flex items-center gap-3 text-amber-700">
                    <svg class="size-5 flex-shrink-0 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="font-medium text-foreground">Admin compliance check (Usually under 24 hours)</span>
                </div>

                <div class="flex items-center gap-3 text-muted-foreground opacity-60">
                    <svg class="size-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    <span>Host Workspace unlocked & listing creation enabled</span>
                </div>
            </div>

            <!-- Informational Notice -->
            <div class="text-xs text-muted-foreground text-left bg-primary/5 border border-primary/10 rounded-2xl p-4 flex gap-3">
                <svg class="size-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="space-y-1">
                    <p class="font-semibold text-foreground">Why do we review host credentials?</p>
                    <p class="leading-relaxed">
                        To maintain trust, authenticity, and compliance across destinations in Egypt, our administrators manually verify host legal documents before listings go live.
                    </p>
                </div>
            </div>

            <!-- Actions -->
            <div class="pt-2 flex flex-col sm:flex-row gap-3 justify-center">
                <a asp-controller="Home" asp-action="Index" class="rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow hover:bg-primary/90 transition">
                    Explore Havenly as Guest
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full sm:w-auto rounded-xl border border-border bg-background px-6 py-3 text-sm font-semibold hover:bg-secondary transition text-muted-foreground hover:text-foreground">
                        Sign Out
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
