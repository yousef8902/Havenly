@model Havenly.BLL.ModelVMs.Account.ResetPasswordVM

@{
    ViewData["Title"] = "Set New Password — Havenly";
}

<div class="container-page py-12">
    <div class="max-w-md mx-auto">
        <div class="rounded-3xl border border-border bg-card p-8 shadow-lift space-y-6">
            <div class="text-center space-y-2">
                <div class="inline-flex size-14 items-center justify-center rounded-2xl bg-emerald-500/10 text-emerald-600 mb-2">
                    <svg class="size-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                </div>
                <h1 class="text-2xl font-bold tracking-tight">Set new password</h1>
                <p class="text-sm text-muted-foreground">
                    Create a strong new password for your Havenly account
                </p>
            </div>

            <!-- Dynamic Alert Box -->
            <div id="resetAlert" class="@(ViewData.ModelState.IsValid && TempData["ErrorMessage"] == null ? "hidden" : "") rounded-2xl border border-destructive/30 bg-destructive/10 p-4 text-sm font-medium text-destructive">
                <ul id="resetErrorList" class="space-y-1 list-disc list-inside">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <li>@TempData["ErrorMessage"]</li>
                    }
                    @if (!ViewData.ModelState.IsValid)
                    {
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
            </div>

            <form id="resetPasswordForm" asp-action="ResetPassword" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <div>
                    <label asp-for="Password" class="block text-sm font-semibold mb-1.5">New Password</label>
                    <div class="relative">
                        <input asp-for="Password" id="newPassword" type="password" placeholder="••••••••" class="w-full rounded-xl border border-border bg-background px-4 py-2.5 pr-11 text-sm focus:border-primary focus:outline-none" autofocus />
                        <button type="button" onclick="togglePasswordVisibility('newPassword', this)" aria-label="Toggle password visibility" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground p-1 focus:outline-none transition">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-xs text-destructive mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-semibold mb-1.5">Confirm New Password</label>
                    <div class="relative">
                        <input asp-for="ConfirmPassword" id="confirmPassword" type="password" placeholder="••••••••" class="w-full rounded-xl border border-border bg-background px-4 py-2.5 pr-11 text-sm focus:border-primary focus:outline-none" />
                        <button type="button" onclick="togglePasswordVisibility('confirmPassword', this)" aria-label="Toggle password visibility" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground p-1 focus:outline-none transition">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-destructive mt-1 block"></span>
                </div>

                <button type="submit" id="resetSubmitBtn" class="w-full rounded-xl bg-primary py-3 text-sm font-semibold text-primary-foreground shadow hover:bg-primary/90 transition flex items-center justify-center gap-2 mt-2">
                    <span id="resetBtnText">Reset Password & Sign in</span>
                    <svg id="resetSpinner" class="hidden animate-spin size-4 text-primary-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';

            btn.innerHTML = isPassword
                ? `<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
                   </svg>`
                : `<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                   </svg>`;
        }

        document.getElementById('resetPasswordForm')?.addEventListener('submit', async function (e) {
            e.preventDefault();

            const form = this;
            const alertBox = document.getElementById('resetAlert');
            const errorList = document.getElementById('resetErrorList');
            const submitBtn = document.getElementById('resetSubmitBtn');
            const btnText = document.getElementById('resetBtnText');
            const spinner = document.getElementById('resetSpinner');

            alertBox.classList.add('hidden');
            errorList.innerHTML = '';
            submitBtn.disabled = true;
            btnText.textContent = 'Resetting password...';
            spinner.classList.remove('hidden');

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                });

                const data = await response.json();

                if (data.success) {
                    btnText.textContent = 'Success!';
                    window.location.href = data.redirectUrl || '/Account/Login';
                } else {
                    submitBtn.disabled = false;
                    btnText.textContent = 'Reset Password & Sign in';
                    spinner.classList.add('hidden');

                    const errors = data.errors || [data.message || 'Failed to reset password.'];
                    errorList.innerHTML = errors.map(err => `<li>${err}</li>`).join('');
                    alertBox.classList.remove('hidden');
                }
            } catch (err) {
                form.submit();
            }
        });
    </script>
}
