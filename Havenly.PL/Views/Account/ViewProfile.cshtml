@model Havenly.BLL.ModelVMs.Account.PublicUserProfileVM

@{
    ViewData["Title"] = $"{Model.Name} — Havenly Profile";
}

<div class="container-page py-12 max-w-5xl mx-auto space-y-10">
    <!-- Top Profile Card -->
    <div class="rounded-3xl border border-border bg-card p-6 sm:p-10 shadow-sm">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="flex items-start sm:items-center gap-6">
                <!-- Avatar -->
                <div class="size-24 rounded-full bg-secondary border-2 border-primary/20 overflow-hidden flex-shrink-0 flex items-center justify-center text-3xl font-bold text-primary shadow-sm">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="@Model.Name" class="size-full object-cover" />
                    }
                    else
                    {
                        <span>@(string.IsNullOrWhiteSpace(Model.Name) ? "H" : Model.Name[0].ToString().ToUpper())</span>
                    }
                </div>

                <div class="space-y-1.5">
                    <div class="flex flex-wrap items-center gap-2.5">
                        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">@Model.Name</h1>
                        <span class="rounded-full bg-primary/10 px-3 py-0.5 text-xs font-semibold text-primary">
                            @Model.Role
                        </span>
                        @if (Model.Role == "Host")
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-amber-500/10 px-3 py-0.5 text-xs font-semibold text-amber-700">
                                ⭐ @Model.AverageHostRating.ToString("0.00") Host
                            </span>
                        }
                    </div>

                    <div class="flex flex-wrap items-center gap-4 text-xs text-muted-foreground">
                        <span class="flex items-center gap-1.5">
                            <svg class="size-3.5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            Joined @Model.JoinedDate.ToString("MMMM yyyy")
                        </span>
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <span class="flex items-center gap-1.5">
                                <svg class="size-3.5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                                @Model.PhoneNumber
                            </span>
                        }
                    </div>
                </div>
            </div>

            @if (User.Identity?.IsAuthenticated == true && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.UserId)
            {
                <a asp-action="EditProfile" class="rounded-xl border border-border bg-secondary/80 px-4 py-2 text-xs font-semibold hover:bg-secondary transition flex items-center gap-1.5 self-start sm:self-auto">
                    <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                    Edit Profile
                </a>
            }
        </div>

        <!-- Bio Section -->
        @if (!string.IsNullOrWhiteSpace(Model.Bio))
        {
            <div class="mt-6 border-t border-border pt-6">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2">About</h3>
                <p class="text-sm text-foreground/90 leading-relaxed">
                    @Model.Bio
                </p>
            </div>
        }
    </div>

    @if (Model.Role == "Host")
    {
        <!-- Host's Properties & Listings -->
        <div class="space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-bold">Listings by @Model.Name</h2>
                    <p class="text-xs text-muted-foreground mt-0.5">Explore homes and retreats managed by this host.</p>
                </div>
                <span class="text-xs font-semibold text-muted-foreground">@Model.Properties.Count property(ies)</span>
            </div>

            @if (Model.Properties.Any())
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var p in Model.Properties)
                    {
                        <div class="group rounded-2xl border border-border bg-card overflow-hidden hover:shadow-lg transition">
                            <div class="aspect-[4/3] w-full overflow-hidden bg-muted relative">
                                <img src="@p.ImageUrl" alt="@p.PropertyName" class="size-full object-cover group-hover:scale-105 transition duration-300" />
                                <span class="absolute top-3 left-3 rounded-full bg-black/60 backdrop-blur-md px-2.5 py-1 text-xs font-semibold text-white">
                                    @p.Category
                                </span>
                            </div>
                            <div class="p-5 space-y-3">
                                <div>
                                    <h3 class="font-bold text-sm text-foreground line-clamp-1">@p.PropertyName</h3>
                                    <p class="text-xs text-muted-foreground mt-0.5">@p.City, @p.Country</p>
                                </div>
                                <div class="flex items-center justify-between pt-2 border-t border-border">
                                    <div class="text-xs font-semibold">
                                        ⭐ @p.Rating.ToString("0.00") <span class="text-muted-foreground">(@p.NumberOfReviews)</span>
                                    </div>
                                    <div class="text-sm font-bold text-primary">
                                        @p.Price.ToString("N0") EGP <span class="text-xs font-normal text-muted-foreground">/ night</span>
                                    </div>
                                </div>
                                <a asp-controller="Property" asp-action="Detail" asp-route-id="@p.PropertyId" class="block w-full text-center rounded-xl bg-secondary py-2 text-xs font-semibold text-foreground hover:bg-secondary/80 transition">
                                    View Stay
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="rounded-2xl border border-dashed border-border p-8 text-center text-muted-foreground text-sm">
                    This host currently has no public properties.
                </div>
            }
        </div>

        <!-- Host Reviews Received -->
        @if (Model.Reviews.Any())
        {
            <div class="space-y-6 pt-4 border-t border-border">
                <div>
                    <h2 class="text-xl font-bold">What Guests Say About @Model.Name</h2>
                    <p class="text-xs text-muted-foreground mt-0.5">Recent feedback from guests who completed stays.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var r in Model.Reviews)
                    {
                        <div class="rounded-2xl border border-border bg-card p-5 space-y-3 shadow-sm">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="size-9 rounded-full bg-primary/10 flex items-center justify-center font-bold text-primary text-xs">
                                        @(string.IsNullOrWhiteSpace(r.ReviewerName) ? "G" : r.ReviewerName[0].ToString().ToUpper())
                                    </div>
                                    <div>
                                        <p class="font-bold text-sm">@r.ReviewerName</p>
                                        <p class="text-[11px] text-muted-foreground">Stayed at @r.PropertyName</p>
                                    </div>
                                </div>
                                <div class="flex items-center text-amber-500 text-xs font-bold">
                                    ★ @r.Rating
                                </div>
                            </div>
                            <p class="text-xs text-foreground/80 leading-relaxed italic">
                                "@r.Comment"
                            </p>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <!-- Rich Guest / Traveler Profile Section for Hosts & Admins -->
        <div class="space-y-8">
            <!-- Traveler Trust & Verification Badges -->
            <div>
                <h2 class="text-lg font-bold mb-3 flex items-center gap-2">
                    <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    Traveler Verification & Standing
                </h2>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    <div class="rounded-2xl border border-border bg-card p-4 space-y-1 shadow-sm">
                        <div class="flex items-center gap-1.5 text-xs font-semibold @(Model.IsEmailConfirmed ? "text-emerald-700" : "text-amber-700")">
                            @if (Model.IsEmailConfirmed)
                            {
                                <svg class="size-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                                <span>Verified Email</span>
                            }
                            else
                            {
                                <span class="size-2 rounded-full bg-amber-500"></span>
                                <span>Email Pending</span>
                            }
                        </div>
                        <p class="text-xs text-muted-foreground">Registered contact</p>
                    </div>

                    <div class="rounded-2xl border border-border bg-card p-4 space-y-1 shadow-sm">
                        <div class="flex items-center gap-1.5 text-xs font-semibold @(Model.IsPhoneConfirmed ? "text-emerald-700" : "text-muted-foreground")">
                            @if (Model.IsPhoneConfirmed)
                            {
                                <svg class="size-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                                <span>Verified Phone</span>
                            }
                            else
                            {
                                <span>Phone Not Added</span>
                            }
                        </div>
                        <p class="text-xs text-muted-foreground">Direct host messaging</p>
                    </div>

                    <div class="rounded-2xl border border-border bg-card p-4 space-y-1 shadow-sm">
                        <p class="text-xs font-semibold text-primary">@Model.TotalCompletedStays Completed</p>
                        <p class="text-xs text-muted-foreground">Stays on Havenly</p>
                    </div>

                    <div class="rounded-2xl border border-border bg-card p-4 space-y-1 shadow-sm">
                        <p class="text-xs font-semibold text-emerald-700">Good Standing</p>
                        <p class="text-xs text-muted-foreground">Community trusted</p>
                    </div>
                </div>
            </div>

            <!-- Past Trips & Stays -->
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-xl font-bold">Past Trips & Travel History</h2>
                        <p class="text-xs text-muted-foreground mt-0.5">Properties and destinations @Model.Name has experienced across Egypt.</p>
                    </div>
                    @if (Model.GuestStays.Any())
                    {
                        <span class="text-xs font-semibold text-muted-foreground">@Model.GuestStays.Count stay(s) recorded</span>
                    }
                </div>

                @if (Model.GuestStays.Any())
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                        @foreach (var s in Model.GuestStays)
                        {
                            <div class="rounded-2xl border border-border bg-card overflow-hidden shadow-sm hover:shadow-md transition">
                                <div class="aspect-[16/9] w-full overflow-hidden bg-muted relative">
                                    <img src="@s.ImageUrl" alt="@s.PropertyName" class="size-full object-cover" />
                                    <span class="absolute top-2.5 right-2.5 rounded-full bg-black/60 backdrop-blur-md px-2.5 py-0.5 text-[11px] font-semibold text-white">
                                        @s.Status
                                    </span>
                                </div>
                                <div class="p-4 space-y-2">
                                    <h3 class="font-bold text-sm text-foreground line-clamp-1">@s.PropertyName</h3>
                                    <p class="text-xs text-muted-foreground">@s.City, @s.Country</p>
                                    <p class="text-[11px] text-muted-foreground pt-1 border-t border-border">
                                        📅 @s.CheckIn.ToString("MMM d") – @s.CheckOut.ToString("MMM d, yyyy")
                                    </p>
                                    @if (s.PropertyId > 0)
                                    {
                                        <a asp-controller="Property" asp-action="Detail" asp-route-id="@s.PropertyId" class="mt-2 block w-full text-center rounded-xl bg-secondary py-1.5 text-xs font-semibold text-foreground hover:bg-secondary/80 transition">
                                            View Stay
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="rounded-2xl border border-dashed border-border bg-muted/20 p-8 text-center space-y-2">
                        <div class="inline-flex size-12 items-center justify-center rounded-2xl bg-primary/10 text-primary mb-1">
                            <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="text-sm font-bold text-foreground">New Traveler to Havenly</h3>
                        <p class="text-xs text-muted-foreground max-w-sm mx-auto">
                            @Model.Name joined in @Model.JoinedDate.ToString("MMMM yyyy") and is excited to start booking handcrafted stays in Egypt.
                        </p>
                    </div>
                }
            </div>

            <!-- Reviews Left by Guest -->
            @if (Model.Reviews.Any())
            {
                <div class="space-y-4 pt-4 border-t border-border">
                    <div>
                        <h2 class="text-xl font-bold">Reviews Written by @Model.Name</h2>
                        <p class="text-xs text-muted-foreground mt-0.5">Feedback and ratings this guest shared after previous stays.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var r in Model.Reviews)
                        {
                            <div class="rounded-2xl border border-border bg-card p-5 space-y-3 shadow-sm">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="font-bold text-sm text-foreground">@r.PropertyName</p>
                                        <p class="text-[11px] text-muted-foreground">Stay Experience</p>
                                    </div>
                                    <div class="flex items-center text-amber-500 text-xs font-bold">
                                        ★ @r.Rating
                                    </div>
                                </div>
                                <p class="text-xs text-foreground/80 leading-relaxed italic">
                                    "@r.Comment"
                                </p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Host Hospitality Guidance Callout -->
            <div class="rounded-2xl border border-primary/20 bg-primary/5 p-5 flex items-start gap-4">
                <div class="rounded-xl bg-primary/10 p-2 text-primary flex-shrink-0">
                    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="space-y-1 text-xs">
                    <h4 class="font-bold text-foreground">Hosting @Model.Name</h4>
                    <p class="text-muted-foreground leading-relaxed">
                        Hosts can contact guests through Havenly messaging once a reservation is requested. Havenly provides 24/7 support and property protection for all confirmed reservations in Egypt.
                    </p>
                </div>
            </div>
        </div>
    }
</div>
