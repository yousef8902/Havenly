@model Havenly.BLL.ModelVMs.Account.PublicUserProfileVM

@{
    ViewData["Title"] = $"{Model.Name} — Havenly Profile";
}

<div class="container-page py-12 max-w-5xl mx-auto space-y-10">
    <!-- Top Profile Card -->
    <div class="rounded-3xl border border-border bg-card p-6 sm:p-10 shadow-sm">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="flex items-start sm:items-center gap-6">
                <!-- Avatar -->
                <div class="size-24 rounded-full bg-secondary border-2 border-primary/20 overflow-hidden flex-shrink-0 flex items-center justify-center text-3xl font-bold text-primary shadow-sm">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl" alt="@Model.Name" class="size-full object-cover" />
                    }
                    else
                    {
                        <span>@(string.IsNullOrWhiteSpace(Model.Name) ? "H" : Model.Name[0].ToString().ToUpper())</span>
                    }
                </div>

                <div class="space-y-1.5">
                    <div class="flex flex-wrap items-center gap-2.5">
                        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">@Model.Name</h1>
                        <span class="rounded-full bg-primary/10 px-3 py-0.5 text-xs font-semibold text-primary">
                            @Model.Role
                        </span>
                        @if (Model.Role == "Host")
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-amber-500/10 px-3 py-0.5 text-xs font-semibold text-amber-700">
                                ⭐ @Model.AverageHostRating.ToString("0.00") Host
                            </span>
                        }
                    </div>

                    <div class="flex flex-wrap items-center gap-4 text-xs text-muted-foreground">
                        <span class="flex items-center gap-1.5">
                            <svg class="size-3.5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            Joined @Model.JoinedDate.ToString("MMMM yyyy")
                        </span>
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <span class="flex items-center gap-1.5">
                                <svg class="size-3.5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                                @Model.PhoneNumber
                            </span>
                        }
                    </div>
                </div>
            </div>

            @if (User.Identity?.IsAuthenticated == true && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.UserId)
            {
                <a asp-action="EditProfile" class="rounded-xl border border-border bg-secondary/80 px-4 py-2 text-xs font-semibold hover:bg-secondary transition flex items-center gap-1.5 self-start sm:self-auto">
                    <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                    Edit Profile
                </a>
            }
        </div>

        <!-- Bio Section -->
        @if (!string.IsNullOrWhiteSpace(Model.Bio))
        {
            <div class="mt-6 border-t border-border pt-6">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2">About</h3>
                <p class="text-sm text-foreground/90 leading-relaxed">
                    @Model.Bio
                </p>
            </div>
        }
    </div>

    @if (Model.Role == "Host")
    {
        <!-- Host's Properties & Listings -->
        <div class="space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-bold">Listings by @Model.Name</h2>
                    <p class="text-xs text-muted-foreground mt-0.5">Explore homes and retreats managed by this host.</p>
                </div>
                <span class="text-xs font-semibold text-muted-foreground">@Model.Properties.Count property(ies)</span>
            </div>

            @if (Model.Properties.Any())
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var p in Model.Properties)
                    {
                        <div class="group rounded-2xl border border-border bg-card overflow-hidden hover:shadow-lg transition">
                            <div class="aspect-[4/3] w-full overflow-hidden bg-muted relative">
                                <img src="@p.ImageUrl" alt="@p.PropertyName" class="size-full object-cover group-hover:scale-105 transition duration-300" />
                                <span class="absolute top-3 left-3 rounded-full bg-black/60 backdrop-blur-md px-2.5 py-1 text-xs font-semibold text-white">
                                    @p.Category
                                </span>
                            </div>
                            <div class="p-5 space-y-3">
                                <div>
                                    <h3 class="font-bold text-sm text-foreground line-clamp-1">@p.PropertyName</h3>
                                    <p class="text-xs text-muted-foreground mt-0.5">@p.City, @p.Country</p>
                                </div>
                                <div class="flex items-center justify-between pt-2 border-t border-border">
                                    <div class="text-xs font-semibold">
                                        ⭐ @p.Rating.ToString("0.00") <span class="text-muted-foreground">(@p.NumberOfReviews)</span>
                                    </div>
                                    <div class="text-sm font-bold text-primary">
                                        @p.Price.ToString("N0") EGP <span class="text-xs font-normal text-muted-foreground">/ night</span>
                                    </div>
                                </div>
                                <a asp-controller="Property" asp-action="Detail" asp-route-id="@p.PropertyId" class="block w-full text-center rounded-xl bg-secondary py-2 text-xs font-semibold text-foreground hover:bg-secondary/80 transition">
                                    View Stay
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="rounded-2xl border border-dashed border-border p-8 text-center text-muted-foreground text-sm">
                    This host currently has no public properties.
                </div>
            }
        </div>
    }
</div>
